  "mediaActions": [
    {
      "id": "media.play_pause",
      "label": "Play / Pause",
      "icon": "Play Pause",
      "command": "togglePlayPause"
    },
    {
      "id": "media.previous",
      "label": "Previous",
      "icon": "Skip Previous",
      "command": "previousTrack"
    },
    {
      "id": "media.next",
      "label": "Next",
      "icon": "Skip Next",
      "command": "nextTrack"
    }
  ],
  "systemMetrics": [
    {
      "mode": "processor",
      "id": "stat.cpu",
      "label": "Processor",
      "labelKey": "processor",
      "unit": "%"
    },
    {
      "mode": "memory_usage",
      "id": "stat.memory",
      "freeId": "stat.memory_free",
      "label": "Memory",
      "labelKey": "memory",
      "unit": "%"
    },
    {
      "mode": "storage",
      "id": "stat.storage",
      "freeId": "stat.storage_free",
      "label": "Storage",
      "labelKey": "storage",
      "unit": "%"
    },
    {
      "mode": "battery",
      "id": "stat.battery",
      "label": "Battery",
