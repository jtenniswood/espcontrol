{
  "label": "Flights",
  "allowInSubpage": true,
  "domains": ["sensor"],
  "options": [
    {"name": "area", "label": "Area view", "kind": "choice", "values": ["current", "entered", "exited"], "defaultValue": "current", "omitDefault": true},
    {"name": "units", "label": "Units", "kind": "choice", "values": ["metric", "imperial"], "defaultValue": "metric", "omitDefault": true}
  ],
  "normalization": {
    "fields": {
      "entity": {"policy": "keep"},
      "label": {"policy": "keep"},
      "icon": {"policy": "default_if_empty", "value": "Travel"},
      "icon_on": {"policy": "default", "value": "Auto"},
      "sensor": {"policy": "clear"},
      "unit": {"policy": "clear"},
      "type": {"policy": "default", "value": "flights"},
      "precision": {"policy": "clear"},
      "options": {"policy": "keep"}
    },
    "unknownOptions": "drop",
    "canonicalOptionOrder": ["area", "units"]
  },
  "default": {
    "entity": "", "label": "Current in area", "icon": "Travel", "icon_on": "Auto",
    "sensor": "", "unit": "", "type": "flights", "precision": "", "options": ""
  }
}
