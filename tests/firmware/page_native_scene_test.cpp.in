};
struct PageNativeModalSources {
  PageArenaAllocator& allocator; PageEntityStateRuntime& graph; PageForecastRuntime& forecasts;
  PageAlarmStateRuntime& alarms; PageAlarmAckRuntime& acknowledgements; PageQrEncoder& qr;
  PageExpandedImageView& images; PageNetworkStatusSource& network; uint32_t(*now)(); size_t slots;
};
struct PageNativeModalOrigins {
  void* owner; bool(*grid)(void*,PageBindingToken); bool(*local)(void*,PageLocalModalOrigin);
  bool(*interactive)(void*);
};
class PageNativeModalBank : public PageRuntimeResources {
 public:
  inline static PageNativeModalBank* instance=nullptr;
  bool held_retirement{false};
  struct Port : PageModalPort {
    PageNativeModalBank& owner;
    struct Context { ParsedCfg config; PageModalToken token; bool retired{false}; };
    Context* context{nullptr};
    PageLocalModalOrigin local;
    explicit Port(PageNativeModalBank& owner):owner(owner) {}
    bool valid_origin(PageBindingToken t) const override { return owner.origins.grid(owner.origins.owner,t); }
    ControlModalKind kind(const PageStore& store,ConfigurationHandle card) const override {
      const auto* row=store.card(card); if (!row) return ControlModalKind::NONE;
      const auto type=store.field(*row,CardField::TYPE);
      if (type=="climate" || type=="climate_control") return ControlModalKind::CLIMATE;
      if (type=="image") return ControlModalKind::IMAGE_CARD;
      if (type=="wifi_qr_card") return ControlModalKind::WIFI_QR;
      if (type=="media") return ControlModalKind::MEDIA_CONTROL;
      if (page_confirmation_policy(store,card).enabled()) return ControlModalKind::SWITCH_CONFIRMATION;
      return ControlModalKind::NONE;
    }
    ControlModalKind local_kind(ControlModalKind t) const override { return t==ControlModalKind::NETWORK_STATUS?t:ControlModalKind::NONE; }
    bool valid_local_origin(PageLocalModalOrigin t,ControlModalKind) const override { return owner.origins.local(owner.origins.owner,t); }
    bool ready() const override { return page_native_command_ready() && !(context && context->retired && owner.held_retirement); }
    bool connected() const override { return online; }
    uint32_t connection_generation() const override { return connection; }
    bool connected_for(ControlModalKind t) const override { return t==ControlModalKind::NETWORK_STATUS || online; }
    uint32_t connection_generation_for(ControlModalKind t) const override { return t==ControlModalKind::NETWORK_STATUS?0:connection; }
    void* create(const PageStore& store,ConfigurationHandle card,PageModalToken token) override {
      assert(!context); context=new Context; context->token=token;
      const auto& row=*store.card(card);
      auto& c=context->config;
      c.entity=store.field(row,CardField::ENTITY); c.type=store.field(row,CardField::TYPE);
      c.sensor=store.field(row,CardField::SENSOR); c.options=store.field(row,CardField::OPTIONS);
      c.unit=store.field(row,CardField::UNIT);
      return context;
    }
    void* create_local(const PageStore&,PageLocalModalOrigin origin,PageModalToken token) override {
      assert(!context); local=origin; context=new Context; context->token=token; return context;
    }
    bool initialize(void*,PageModalToken t) override {
      const auto& c=context->config; const auto& s=owner.styles;
      if (t.kind==ControlModalKind::CLIMATE) { espcontrol::cards::ClimateControlDriverEnvironment e; return s.climate.resolve(s.climate.owner,t,c,e); }
      if (t.kind==ControlModalKind::MEDIA_CONTROL) { PageMediaControlModalEnvironment e; return s.media.resolve(s.media.owner,t,c,e) && e.media; }
      if (t.kind==ControlModalKind::IMAGE_CARD) { PageExpandedImageModalEnvironment e; if (s.image.covered) s.image.covered(s.image.owner,true); return s.image.resolve(s.image.owner,t,c,e); }
      if (t.kind==ControlModalKind::WIFI_QR) { PageWifiQrModalEnvironment e; return s.wifi.resolve(s.wifi.owner,t,c,e); }
      if (t.kind==ControlModalKind::SWITCH_CONFIRMATION) { PageConfirmationModalEnvironment e; return s.confirmation.resolve(s.confirmation.owner,t,c,e) && owner.confirm.bind(t,c); }
      if (t.kind==ControlModalKind::NETWORK_STATUS) { PageNetworkStatusEnvironment e; s.network.settings(s.network.owner,true); return s.network.resolve(s.network.owner,local,t,e); }
      return false;
    }
    bool visible(void*) const override { return context && !context->retired; }
    void update(void*,PageModalToken) override {}
    ControlModalDismissPolicy dismiss_policy(void*) const override { return ControlModalDismissPolicy::DISMISS; }
    void retire(void*,PageModalClose) override {
      context->retired=true; owner.confirm.cancel(context->token);
      if(context->token.kind==ControlModalKind::NETWORK_STATUS) owner.styles.network.settings(owner.styles.network.owner,false);
      if(context->token.kind==ControlModalKind::IMAGE_CARD) owner.styles.image.covered(owner.styles.image.owner,false);
    }
    void destroy(void*) override { assert(context->retired); delete context; context=nullptr; }
  } port;
  struct ConfirmPort : PageConfirmationPort {
    PageNativeModalBank& owner;
    explicit ConfirmPort(PageNativeModalBank& owner):owner(owner) {}
    bool valid(PageBindingToken t) const override { return owner.origins.grid(owner.origins.owner,t); }
    bool valid(PageModalToken t) const override { return owner.runtime_.valid(t); }
    bool connected() const override { return online; }
    bool service_available() const override { return api; }
    bool ready() const override { return page_native_command_ready(); }
    uint64_t request(PageBindingToken t) override { return owner.runtime_.request(t)?owner.runtime_.pending_request():0; }
    bool pending_request(uint64_t t) const override { return t && t==owner.runtime_.pending_request(); }
    void cancel_request(uint64_t t) override { owner.runtime_.cancel_request(t); }
    void close(PageModalToken t) override { owner.runtime_.notify_closed(t); }
    bool send(PageConfirmationAction,const ParsedCfg& c) override { return ha_send_entity_action(c.entity,"confirmed"); }
  } confirm_port;
  struct AlarmCommandPort : PageAlarmCommandPort {
    bool ready() const override { return true; } bool connected() const override { return online; }
    bool service_available() const override { return api; } bool valid(PageBindingToken) const override { return true; }
    bool valid(PageModalToken) const override { return true; } bool selected_pin(PageModalToken,alarm::Action) const override { return false; }
    bool send(std::string_view e,const char* service,std::string_view) override { return ha_send_entity_action(std::string(e),service); }
  } alarm_port;
  PageConfirmationRuntime confirm;
  PageAlarmCommands alarm;
  PageNativeModalOrigins origins;
  PageNativeModalStyles styles;
  PageModalRuntime runtime_;
  PageRuntimeResourcesGroup<3> resources;
  bool initialized=false;
  PageNativeModalBank(PageNativeModalSources source,PageNativeModalStyles style,PageNativeModalOrigins origin)
      :port(*this),confirm_port(*this),confirm(source.graph,confirm_port),
       alarm(source.graph,source.alarms,source.acknowledgements,alarm_port),origins(origin),styles(style),
       runtime_(port,1,origin.owner,origin.interactive),resources({{&runtime_,&confirm,&alarm}}) { instance=this; }
  ~PageNativeModalBank() override { instance=nullptr; }
  bool initialize(bool retired) { initialized=retired; return initialized; }
  bool maintenance_ready() const { return initialized && port.ready(); }
  bool prepare(const PageStore& store) override { return resources.prepare(store); }
  void discard_prepared() override { resources.discard_prepared(); }
  void activate_prepared(const PageStore& store) override { resources.activate_prepared(store); }
  void retire_active() override { resources.retire_active(); }
  void loop() { if (!runtime_.input_allowed()) { confirm.cancel_queued(); alarm.cancel(); } confirm.loop(); alarm.loop(); runtime_.loop(); }
  void stop() { runtime_.stop(); confirm.cancel(); alarm.cancel(); }
  PageModalRuntime& runtime() { return runtime_; }
  const PageModalRuntime& runtime() const { return runtime_; }
  PageConfirmationRuntime& confirmations() { return confirm; }
  PageAlarmCommands& alarm_commands() { return alarm; }
};
}
