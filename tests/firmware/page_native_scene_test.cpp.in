  bool(*resolve)(void*,PageModalToken,const ParsedCfg&,Environment&){nullptr};
  void(*numeric_action_sent)(void*,PageModalToken,float){nullptr};
  void(*state_confirmed)(void*,PageModalToken,bool){nullptr};
