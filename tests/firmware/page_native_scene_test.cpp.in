struct Arena : PageArenaAllocator {
  size_t live{0}, calls{0}; bool fail{false};
  void* allocate(size_t n) override { if(fail) return nullptr; ++live; ++calls; return std::malloc(n); }
  void release(void* p,size_t) override { assert(live); --live; std::free(p); }
  ~Arena() { assert(!live); }
};
struct Styles : PageNativeSceneStyles {
  mutable PageId page{NO_PAGE}; mutable CardId card{NO_CARD};
  const char* icon(std::string_view,std::string_view) const override { return "X"; }
#define TEST_STYLE(E) bool resolve(const PageStore&,PageId p,PageModalToken t,const ParsedCfg&,E&) const override { page=p; card=t.card; return true; }
  TEST_STYLE(espcontrol::cards::ClimateControlDriverEnvironment)
  TEST_STYLE(PageControlModalEnvironment)
  TEST_STYLE(PageFanControlModalEnvironment)
  TEST_STYLE(PageOptionSelectModalEnvironment)
  TEST_STYLE(PageMediaVolumeModalEnvironment)
  TEST_STYLE(PageMediaControlModalEnvironment)
  TEST_STYLE(PageWeatherModalStyle)
  TEST_STYLE(PageConfirmationModalEnvironment)
  TEST_STYLE(PageAlarmModalEnvironment)
  TEST_STYLE(PageExpandedImageModalEnvironment)
  TEST_STYLE(PageWifiQrModalEnvironment)
#undef TEST_STYLE
  bool resolve(const PageStore&,PageLocalModalOrigin p,PageModalToken,const PageNetworkStatusEnvironment&) const { page=p.page; return true; }
  bool resolve(const PageStore&,PageLocalModalOrigin p,PageModalToken,PageNetworkStatusEnvironment&) const override { page=p.page; return true; }
};
struct Platform : PageNativeScenePlatform {
  bool shown{true},input{true},critical_active{false},settings{false}; size_t chrome_updates{0}; PageId page{NO_PAGE};
  bool grid_active() const override { return shown; }
  bool input_allowed() const override { return input; }
  std::string_view base_url() const override { return "https://ha.example"; }
  uint32_t endpoint_generation() const override { return 1; }
  bool request_allowed(uint16_t,uint16_t,bool) const override { return true; }
  uint16_t maximum_source_side(bool) const override { return 256; }
  bool retain_cache(uint16_t,uint16_t) const override { return false; }
  uint32_t cache_ttl_ms() const override { return 0; }
  bool cache_skips_open_refresh() const override { return false; }
  void critical(bool on) override { critical_active=on; }
  void alarm_failure(PageAlarmFailure) override {}
  void chrome(const PageStore&,PageId p,bool active) override { ++chrome_updates; page=p; settings=active; }
};
struct Document {
  std::array<uint8_t,16384> bytes{}; size_t size{0};
  explicit Document(const DeviceUiLimits& profile, const char* last="number.room;Level;Auto;Auto;;;slider;;",
                    const char* root_order="1,2,3,4,5,6,7,8,9") {
    PanelConfigWriter writer(bytes.data(),bytes.size()); assert(writer.begin()==PanelConfigStatus::OK);
    assert(writer.append_device_profile(reinterpret_cast<const uint8_t*>(profile.device_profile),std::strlen(profile.device_profile))==PanelConfigStatus::OK);
    const std::string rows[]={
      "switch.one;Toggle;Auto;Auto;;;;;",
      ";Rooms;Auto;Auto;;;subpage;;",
      "climate.root;Climate;Auto;Auto;;;climate;;",
      "media_player.room;Speaker;Auto;Auto;control_modal;;media;;number_display=volume",
      "image.front;Image;Auto;Auto;;;image;;image_label,image_icon",
      ";QR 1;Auto;Auto;;;wifi_qr_card;;ssid64=R3Vlc3Q,security=open",
      ";QR 2;Auto;Auto;;;wifi_qr_card;;ssid64=R3Vlc3Q,security=open",
      ";QR 3;Auto;Auto;;;wifi_qr_card;;ssid64=R3Vlc3Q,security=open",
      last};
    for(size_t i=0;i<9;++i) assert(writer.append_button(i+1,reinterpret_cast<const uint8_t*>(rows[i].data()),rows[i].size())==PanelConfigStatus::OK);
    const std::string child="~B,1,2,3|,switch.child,Child toggle,Auto,Auto,,,,|HC,climate.child,Child climate,Auto,Auto,,,,|S,local_value,Local,Auto,Auto,local,,1,";
    assert(writer.append_subpage(2,reinterpret_cast<const uint8_t*>(child.data()),child.size())==PanelConfigStatus::OK);
    const std::string order=root_order;
    assert(writer.append_setting(reinterpret_cast<const uint8_t*>("button_order"),12,reinterpret_cast<const uint8_t*>(order.data()),order.size())==PanelConfigStatus::OK);
    assert(writer.finish(&size)==PanelConfigStatus::OK);
  }
};
void click(lv_obj_t* obj) {
  lv_obj_send_event(obj,LV_EVENT_PRESSED,nullptr);
  lv_obj_send_event(obj,LV_EVENT_RELEASED,nullptr);
  lv_obj_send_event(obj,LV_EVENT_CLICKED,nullptr);
}
size_t objects(lv_obj_t* obj) { size_t n=1; for(uint32_t i=0;i<lv_obj_get_child_count(obj);++i)n+=objects(lv_obj_get_child(obj,i)); return n; }
struct Harness {
  Arena arena; Styles styles; Platform platform; PageNetworkStatusSource network;
  PageCountedArena counted{arena};
  lv_obj_t* root;
  std::array<PageBasicWidgets,9> widgets{};
  std::optional<PageNativeWidgetBank<9>> bank;
  std::array<lv_coord_t,4> columns{LV_GRID_FR(1),LV_GRID_FR(1),LV_GRID_FR(1),LV_GRID_TEMPLATE_LAST};
  std::array<lv_coord_t,4> rows=columns;
  PageBasicTheme theme;
  esphome::artwork_image::ArtworkImage a,b,modal;
  esphome::artwork_image::ArtworkImage* images[2]{&a,&b};
  using Scene=PageNativeScene<9,2>;
  alignas(Scene) std::array<uint8_t,sizeof(Scene)> memory{};
  Scene* scene{nullptr};
  explicit Harness(bool elastic_state=false, bool production_budget=false) {
    root=lv_obj_create(lv_screen_active()); lv_obj_set_size(root,480,480);
    lv_obj_set_grid_dsc_array(root,columns.data(),rows.data());
    std::array<BtnSlot,9> source{};
    for(size_t i=0;i<widgets.size();++i) {
      auto& w=widgets[i];
      w.button=lv_button_create(root);w.icon=lv_label_create(w.button);w.label=lv_label_create(w.button);
      w.sensor_container=lv_obj_create(w.button);w.value=lv_label_create(w.sensor_container);w.unit=lv_label_create(w.sensor_container);
      source[i]={w.button,w.icon,w.label,w.sensor_container,w.value,w.unit};
    }
    bank.emplace(source);widgets=bank->widgets;
    theme.sensor_font=theme.large_sensor_font=theme.media_title_font=theme.icon_font=theme.label_font=
      theme.media_control_title_font=theme.media_control_artist_font=theme.cover_title_font=theme.cover_artist_font=
      theme.option_select_font=&lv_font_montserrat_14;
    const auto cards=DEVICE_UI_PROFILES[8].max_cards();
    const PageNativeSceneBudget budget = production_budget
      ? PageNativeSceneBudget{{cards,cards*512,
          {cards*40,cards*40,128*1024,32*1024,4096},
          {cards,cards,16*1024,HA_TEXT_SENSOR_STATE_MAX_LEN}},128*1024}
      : PageNativeSceneBudget{{128,16384,{1024,512,65536,SIZE_MAX,elastic_state?size_t{1024}:SIZE_MAX},{128,128,8192}},65536};
    scene=new(memory.data()) Scene(DEVICE_UI_PROFILES[8],counted,budget,
      widgets,{9,3},theme,page_timezone_resolver(),{},nullptr,styles,platform,network);
    assert(!scene->ready() && !scene->initialize(images,2,&modal,false));
    assert(scene->initialize(images,2,&modal,true) && scene->initialize(images,2,&modal,true));
  }
  ~Harness() {
    scene->~Scene(); bank.reset(); lv_obj_delete(root); assert(coordinator.entries.empty());
    const auto counters=counted.memory();
    assert(counters.reserved_bytes==0&&counters.live_allocations==0&&counters.accounting_errors==0);
  }
  void apply(const Document& doc,uint32_t gen=17) {
    assert(scene->prepare(PANEL_CONFIG_DOCUMENT_VERSION,doc.bytes.data(),doc.size));
    // Native generation activation must use its prepared arenas, even when
    // no further model/view reservation can succeed after durable commit.
    const bool previous_failure=arena.fail;arena.fail=true;
    assert(scene->activate_prepared(gen,PANEL_CONFIG_DOCUMENT_VERSION,doc.bytes.data(),doc.size));
    arena.fail=previous_failure;
    scene->loop(); scene->loop(); scene->loop();
  }
  void media() {
    coordinator.report("media_player.room","","playing");
    coordinator.report("media_player.room","volume_level","0.2");
    coordinator.report("media_player.room","supported_features","4");
  }
};
void navigation_and_state() {
  Document doc(DEVICE_UI_PROFILES[8]); Harness h; h.apply(doc);
  assert(h.scene->active_page()==0 && h.platform.page==0);
  const auto count=objects(h.root);
  assert(h.scene->valid(h.scene->binding(0)));
  coordinator.report("switch.one","","off"); coordinator.report("switch.child","","on");
  h.scene->loop(); const auto sent=sends;
  click(h.widgets[0].button); assert(sends==sent && h.scene->memory().commands.pending==1);
  h.scene->loop();
  assert(sends==sent+1 && sent_entity=="switch.one");
  for(int i=0;i<1000;++i) {
    click(h.widgets[1].button); h.scene->loop();
    assert(h.scene->active_page()==1 && objects(h.root)==count);
    click(h.widgets[0].button); h.scene->loop();
    assert(h.scene->active_page()==0 && objects(h.root)==count);
  }
  busy=true; const auto epoch=h.scene->chrome_origin(); click(h.widgets[1].button);
  busy=false; h.scene->loop();
  // Native producer dispatch does not process UI/configuration maintenance.
  assert(h.scene->active_page()==0);
  assert(h.scene->request_settings(epoch));
  PageNativeModalBank::instance->runtime().dismiss(); h.scene->loop();
}
void live_temperature_policy() {
  Document doc(DEVICE_UI_PROFILES[8]); Harness h; h.apply(doc);
  for (const auto* entity : {"climate.root", "climate.child"}) {
    coordinator.report(entity, "", "heat");
    coordinator.report(entity, "supported_features", "1");
    coordinator.report(entity, "temperature", "23");
    coordinator.report(entity, "current_temperature", "20");
  }
  h.scene->loop();
  assert(std::string_view(lv_label_get_text(h.widgets[2].unit)) == "°C");
  const auto token = h.scene->binding(2);
  const auto allocations = h.arena.calls, registrations = coordinator.entries.size();
  const auto count = objects(h.root);
  h.arena.fail = true;
  {
    ModalCallbackDispatchScope callback;
    h.scene->refresh_temperature_unit(true);
    h.scene->loop();
    // Policy notifications do not paint inside native callback dispatch.
    assert(std::string_view(lv_label_get_text(h.widgets[2].unit)) == "°C");
  }
  h.scene->loop();
  assert(std::string_view(lv_label_get_text(h.widgets[2].unit)) == "°F");
  assert(h.scene->valid(token));
  click(h.widgets[1].button); h.scene->loop();
  assert(h.scene->active_page() == 1);
  assert(std::string_view(lv_label_get_text(h.widgets[2].unit)) == "°F");
  h.platform.shown = false; h.scene->loop();
  h.scene->refresh_temperature_unit(false); h.scene->loop();
  h.platform.shown = true; h.scene->loop();
  assert(h.scene->active_page() == 1);
  assert(std::string_view(lv_label_get_text(h.widgets[2].unit)) == "°C");
  assert(h.scene->active().generation() == 17 && coordinator.entries.size() == registrations);
  assert(h.arena.calls == allocations && objects(h.root) == count);
  h.arena.fail = false;
}
void elastic_state_scene_transactions() {
  Document doc(DEVICE_UI_PROFILES[8]); Harness h(true); h.apply(doc);
  assert(h.scene->memory().state.active_state_capacity_bytes == 1024);
  h.media();
  const std::string title(5000, 'T');
  coordinator.report("media_player.room", "media_title", title);
  coordinator.report("climate.child", "", "heat");
  coordinator.report("climate.child", "supported_features", "1");
  coordinator.report("climate.child", "temperature", "25");
  h.scene->loop();
  assert(h.scene->memory().state.active_state_bytes >= title.size());
  assert(h.scene->memory().state.active_state_capacity_bytes == 8192);
  click(h.widgets[1].button);h.scene->loop();
  const auto &climate = h.widgets[2];
  const std::array<std::string,4> before = {
    lv_label_get_text(climate.icon),lv_label_get_text(climate.label),
    lv_label_get_text(climate.value),lv_label_get_text(climate.unit)};
  assert(before[3] == "°C");
  assert(before[0].find("25") != std::string::npos || before[2].find("25") != std::string::npos);
  click(h.widgets[0].button);h.scene->loop();
  const auto registrations = coordinator.entries.size();
  h.apply(doc, 18);
  assert(h.scene->memory().state.active_state_bytes >= title.size());
  assert(h.scene->memory().state.active_state_capacity_bytes == 8192);
  const auto count = objects(h.root), calls = h.arena.calls;
  h.arena.fail = true;
  for (size_t cycle=0;cycle<1000;++cycle) {
    click(h.widgets[1].button);h.scene->loop();
    assert(h.scene->active_page() == 1);
    assert(std::string_view(lv_label_get_text(climate.icon)) == before[0]);
    assert(std::string_view(lv_label_get_text(climate.label)) == before[1]);
    assert(std::string_view(lv_label_get_text(climate.value)) == before[2]);
    assert(std::string_view(lv_label_get_text(climate.unit)) == before[3]);
    click(h.widgets[0].button);h.scene->loop();
    assert(h.scene->active_page() == 0);
  }
  assert(h.arena.calls == calls && coordinator.entries.size() == registrations && objects(h.root) == count);
  h.arena.fail = false;
}
Document maximum_sensor_document(char variant) {
  Document doc(DEVICE_UI_PROFILES[8]);
  PanelConfigWriter writer(doc.bytes.data(),doc.bytes.size());
  assert(writer.begin()==PanelConfigStatus::OK);
  const std::string profile=DEVICE_UI_PROFILES[8].device_profile;
  const auto data=[](const std::string& value) { return reinterpret_cast<const uint8_t*>(value.data()); };
  assert(writer.append_device_profile(data(profile),profile.size())==PanelConfigStatus::OK);
  for(unsigned parent=1;parent<=9;++parent) {
    const std::string root=";Room "+std::to_string(parent)+";Home;Auto;;;subpage;;";
    assert(writer.append_button(parent,data(root),root.size())==PanelConfigStatus::OK);
    std::string child="~B,1,2,3,4,5,6,7,8";
    for(unsigned slot=1;slot<=8;++slot)
      child+="|S,,Temperature,Auto,Auto,sensor.maximum_"+std::string(1,variant)+"_"+
        std::to_string(parent)+"_"+std::to_string(slot)+",%C2%B0C,1,";
    assert(child.size()<=DEVICE_UI_PROFILES[8].legacy_subpage_byte_ceiling());
    assert(writer.append_subpage(parent,data(child),child.size())==PanelConfigStatus::OK);
  }
  const std::string key="button_order",order="1,2,3,4,5,6,7,8,9";
  assert(writer.append_setting(data(key),key.size(),data(order),order.size())==PanelConfigStatus::OK);
  assert(writer.finish(&doc.size)==PanelConfigStatus::OK);
  return doc;
}
void maximum_profile_disjoint_replacements() {
  // Exercise all 81 supported S3 cards with the actual device arena budgets,
  // not the larger generic harness limits. Sensor sources live in SENSOR.
  const auto a=maximum_sensor_document('a'),b=maximum_sensor_document('b');
  Harness h(false,true);
  size_t stable_bytes=0,stable_objects=0;
  std::function<void(Coordinator::State)> retired_report;
  for(unsigned iteration=0;iteration<20;++iteration) {
    const bool second=iteration%2;
    h.apply(second?b:a,100+iteration);
    assert(h.scene->active().card_count()==81&&h.scene->active().page_count()==10);
    assert(h.scene->memory().state.active_channels==72&&coordinator.entries.size()==72);
    const auto empty=h.scene->memory().state.active_state_bytes;
    if(retired_report) retired_report("stale generation");
    assert(h.scene->memory().state.active_state_bytes==empty);
    const std::string prefix=second?"sensor.maximum_b_":"sensor.maximum_a_";
    for(const auto& entry:coordinator.entries) {
      assert(entry.entity.find(prefix)==0&&entry.attribute.empty());
      entry.receive("23.5");
    }
    retired_report=coordinator.entries.front().receive;
    h.scene->loop();
    assert(h.scene->memory().state.active_state_bytes==72*4);
    const auto before=h.counted.memory();
    const auto widget_count=objects(h.root);
    if(iteration==0) { stable_bytes=before.reserved_bytes;stable_objects=widget_count; }
    else assert(before.reserved_bytes==stable_bytes&&widget_count==stable_objects);
    h.arena.fail=true;
    for(unsigned cycle=0;cycle<100;++cycle) {
      const unsigned page=cycle%9+1;
      assert(h.scene->navigate("slot:"+std::to_string(page)));h.scene->loop();
      assert(h.scene->active_page()==page);
      assert(h.scene->home());h.scene->loop();assert(h.scene->active_page()==0);
    }
    h.arena.fail=false;
    assert(h.counted.memory().allocation_calls==before.allocation_calls&&
      coordinator.entries.size()==72&&objects(h.root)==widget_count);
    assert(h.counted.memory().accounting_errors==0);
  }
}
void panels_and_retirement() {
  Document doc(DEVICE_UI_PROFILES[8]); Harness h; h.apply(doc);
  const auto count=objects(h.root);
  click(h.widgets[2].button); h.scene->loop();
  auto& bank=*PageNativeModalBank::instance;
  const auto token=bank.runtime().token();
  assert(token.kind==ControlModalKind::CLIMATE && h.styles.page==0 && h.styles.card==2);
  const auto sent=sends; click(h.widgets[0].button); h.scene->loop(); assert(sends==sent && h.scene->active_page()==0);
  bank.held_retirement=true; bank.runtime().notify_closed(token);
  assert(!bank.maintenance_ready() && h.scene->maintenance_ready());
  coordinator.report("switch.child","","on"); h.scene->loop();
  click(h.widgets[1].button); h.scene->loop(); assert(h.scene->active_page()==0);
  bank.held_retirement=false; h.scene->loop();
  click(h.widgets[1].button); h.scene->loop(); assert(h.scene->active_page()==1);
  click(h.widgets[0].button); h.scene->loop(); assert(h.scene->active_page()==0);
  const auto child=static_cast<CardId>(h.scene->active().page(1)->first_card+1);
  assert(h.scene->request_card({17,child},ControlModalKind::CLIMATE));h.scene->loop();
  assert(h.styles.page==1 && h.styles.card==child && h.scene->active_page()==0);
  bank.runtime().dismiss(); h.scene->loop();
  assert(objects(h.root)==count);
}
void mode_and_feedback() {
  Document doc(DEVICE_UI_PROFILES[8]); Harness h; h.apply(doc); h.media();h.scene->loop();
  const auto sent=sends;
  click(h.widgets[0].button); h.platform.shown=false;h.scene->loop();
  assert(sends==sent && !h.scene->valid({17,1,0,0,0,false}));
  h.platform.shown=true;h.scene->loop();
  click(h.widgets[3].button);h.scene->loop();
  auto& bank=*PageNativeModalBank::instance;const auto token=bank.runtime().token();
  assert(token.kind==ControlModalKind::MEDIA_CONTROL);
  {
    ModalCallbackDispatchScope response;
    // A reply to an already-sent grouping action may update its current panel.
    // The same callback still cannot run configuration/scene maintenance or
    // admit a fresh grid command through the covered bank.
    assert(bank.runtime().valid(token) && !bank.runtime().interactive(token) && !h.scene->maintenance_ready());
    bank.styles.media.state_confirmed(bank.styles.media.owner,token,true);
    click(h.widgets[0].button);
    assert(h.scene->memory().commands.pending==0);
  }
  bank.styles.media.numeric_action_sent(bank.styles.media.owner,token,45);
  h.scene->loop();
  assert(std::string(lv_label_get_text(h.widgets[3].value))=="45");
  h.platform.input=false;
  assert(bank.runtime().valid(token) && !bank.runtime().interactive(token));
  h.scene->loop();
  h.platform.input=true;
  assert(bank.runtime().interactive(token));
  locked=true;h.scene->loop();assert(!bank.runtime().valid(token));
  locked=false;h.scene->loop();
  bank.styles.media.numeric_action_sent(bank.styles.media.owner,token,70);h.scene->loop();
  assert(std::string(lv_label_get_text(h.widgets[3].value))!="70");
}
void source_styles() {
  Document doc(DEVICE_UI_PROFILES[8]); Harness h; h.apply(doc);
  const auto& store=h.scene->active();
  lv_font_t root_font=lv_font_montserrat_14,child_font=lv_font_montserrat_14;
  PageNativeDeviceStyleProfile profile;
  profile.root={&root_font,&root_font,&root_font};
  profile.child={&child_font,&child_font,&child_font};
  profile.display.fonts.icon=profile.display.fonts.sensor=&lv_font_montserrat_14;
  profile.display.color.red_percent=50;
  profile.display.width.main_percent=110;profile.display.width.volume_percent=120;
  profile.grid=h.root;profile.slots=9;profile.columns=3;profile.radius=18;profile.primary_color="884422";
  PageNativeDeviceStyles styles(profile);
  const auto child=static_cast<CardId>(store.page(1)->first_card+1);
  PageModalToken token{17,1,child,ControlModalKind::CLIMATE};
  ParsedCfg config;
  espcontrol::cards::ClimateControlDriverEnvironment climate;
  assert(styles.resolve(store,1,token,config,climate));
  assert(climate.label_font==&child_font && climate.unit_font==&child_font &&
    climate.option_title_font==&child_font && climate.width_compensation_percent==120 &&
    climate.accent_color==0x444422);
  // Rebinding the visible bank cannot change a hidden source's font fallbacks.
  lv_obj_set_style_text_font(h.widgets[0].label,LV_FONT_DEFAULT,LV_PART_MAIN);
  assert(styles.resolve(store,1,token,config,climate) && climate.label_font==&child_font);
  assert(!styles.resolve(store,0,token,config,climate));
  auto stale=token;--stale.configuration;
  assert(!styles.resolve(store,1,stale,config,climate));
  config.options="card_off_color=224466,card_active_color=custom,card_on_color=884422";
  PageOptionSelectModalEnvironment options;
  assert(styles.resolve(store,1,token,config,options));
  assert(options.secondary_color==0x114466 && options.accent_color==0x444422 &&
    options.label_font==&child_font && options.width_compensation_percent==110);
  PageConfirmationModalEnvironment confirmation;
  assert(styles.resolve(store,1,token,config,confirmation) && confirmation.caption=="Child climate");
  config.label="temporary";
  assert(confirmation.caption=="Child climate");
  PageNetworkStatusEnvironment network;
  assert(styles.resolve(store,{17,1,1},{17,2,NO_CARD,ControlModalKind::NETWORK_STATUS},network));
  assert(network.label_font==&child_font && network.columns==3 && network.rows==3 && network.radius==18);
  // All other family resolvers use the same immutable source identity.
  PageControlModalEnvironment control; PageFanControlModalEnvironment fan;
  PageMediaVolumeModalEnvironment volume; PageMediaControlModalEnvironment media;
  PageWeatherModalStyle weather; PageAlarmModalEnvironment alarm;
  PageExpandedImageModalEnvironment image; PageWifiQrModalEnvironment wifi;
  assert(styles.resolve(store,1,token,config,control) && styles.resolve(store,1,token,config,fan) &&
    styles.resolve(store,1,token,config,volume) && styles.resolve(store,1,token,config,media) &&
    styles.resolve(store,1,token,config,weather) && styles.resolve(store,1,token,config,alarm) &&
    styles.resolve(store,1,token,config,image) && styles.resolve(store,1,token,config,wifi));
  assert(control.label_font==&child_font && fan.label_font==&child_font && volume.label_font==&child_font &&
    media.label_font==&child_font && weather.font==&child_font && alarm.label_font==&child_font &&
    image.label_font==&child_font && wifi.label_font==&child_font);
}
void slider_input() {
  Document doc(DEVICE_UI_PROFILES[8],"fan.room;Fan;Auto;Auto;;;fan_speed;;");
  Harness h;h.apply(doc);
  coordinator.report("fan.room","","on");
  coordinator.report("fan.room","percentage","35");h.scene->loop();
  const auto sent=sends;
  click(h.widgets[8].button);
  assert(sends==sent && h.scene->memory().commands.pending==1);
  h.scene->loop();assert(sends==sent+1 && sent_service=="homeassistant.toggle");
  auto* slider=h.widgets[8].slider;
  lv_obj_send_event(slider,LV_EVENT_PRESSED,nullptr);
  lv_slider_set_value(slider,60,LV_ANIM_OFF);
  lv_obj_send_event(slider,LV_EVENT_VALUE_CHANGED,nullptr);
  lv_obj_send_event(slider,LV_EVENT_RELEASED,nullptr);
  lv_obj_send_event(slider,LV_EVENT_CLICKED,nullptr);
  h.scene->loop();assert(sends==sent+2 && sent_service=="percent");
  lv_obj_send_event(h.widgets[8].button,LV_EVENT_PRESSED,nullptr);
  h.platform.input=false;h.scene->loop();h.platform.input=true;h.scene->loop();
  lv_obj_send_event(h.widgets[8].button,LV_EVENT_RELEASED,nullptr);
  lv_obj_send_event(h.widgets[8].button,LV_EVENT_CLICKED,nullptr);
  h.scene->loop();assert(sends==sent+2);
  h.platform.input=false;
  lv_obj_send_event(h.widgets[8].button,LV_EVENT_PRESSED,nullptr);
  h.platform.input=true;
  lv_obj_send_event(h.widgets[8].button,LV_EVENT_RELEASED,nullptr);
  lv_obj_send_event(h.widgets[8].button,LV_EVENT_CLICKED,nullptr);
  h.scene->loop();assert(sends==sent+2);
}
void slider_background_hit_testing() {
  const char* configurations[]={
    "light.room;Dimmer;Auto;Auto;;;slider;;",
    "fan.room;Fan;Auto;Auto;;;fan_speed;;",
    "cover.room;Shade;Auto;Auto;;;cover;;",
    "cover.room;Tilt;Auto;Auto;tilt;;cover;;",
    "light.room;Temperature;Auto;Auto;;;light_temperature;;",
    "input_number.room;Number;Auto;Auto;;;slider;;"};
  for(size_t kind=0;kind<6;++kind) {
    Document doc(DEVICE_UI_PROFILES[8],configurations[kind],"9w,2,3,4,5,6,7,8,1");
    Harness h;h.apply(doc);
    const char* entity=kind==1?"fan.room":kind==2||kind==3?"cover.room":kind==5?"input_number.room":"light.room";
    const bool background_toggle=kind<4;
    coordinator.report(entity,"",kind==5?"5":kind==2||kind==3?"open":"on");
    coordinator.report(entity,"current_position","50");
    coordinator.report(entity,"current_tilt_position","45");
    coordinator.report(entity,"min","0");
    coordinator.report(entity,"max","100");
    coordinator.report(entity,"step","1");
    coordinator.report(entity,"brightness","128");
    coordinator.report(entity,"percentage","35");
    coordinator.report(entity,"color_temp_kelvin","4000");
    coordinator.report(entity,"min_color_temp_kelvin","2700");
    coordinator.report(entity,"max_color_temp_kelvin","6500");
    coordinator.report(entity,"supported_color_modes","['color_temp']");
    coordinator.report(entity,"color_mode","color_temp");
    h.scene->loop();
    const auto &w=h.widgets[0];lv_obj_update_layout(h.root);
    lv_area_t button,slider;lv_obj_get_coords(w.button,&button);lv_obj_get_coords(w.slider,&slider);
    struct Touch {lv_point_t point{};lv_indev_state_t state{LV_INDEV_STATE_RELEASED};} touch;
    auto* pointer=lv_indev_create();assert(pointer);lv_indev_set_type(pointer,LV_INDEV_TYPE_POINTER);
    lv_indev_set_display(pointer,lv_display_get_default());lv_indev_set_user_data(pointer,&touch);
    lv_indev_set_mode(pointer,LV_INDEV_MODE_EVENT);
    lv_indev_set_read_cb(pointer,[](lv_indev_t* device,lv_indev_data_t* data){
      const auto &current=*static_cast<Touch*>(lv_indev_get_user_data(device));
      data->point=current.point;data->state=current.state;
    });
    auto read=[&](int x,int y,lv_indev_state_t state){
      touch.point={x,y};touch.state=state;lv_tick_inc(30);lv_indev_read(pointer);
    };
    const auto x=button.x1+std::max<int32_t>(6,(slider.x1-button.x1)/2);
    const auto y=(button.y1+button.y2)/2;
    assert(x<slider.x1&&x>button.x1&&y>button.y1&&y<button.y2);
    const auto sent=sends;
    read(x,y,LV_INDEV_STATE_PRESSED);read(x,y,LV_INDEV_STATE_RELEASED);
    // Real pointer hit testing must reach the background; direct send_event
    // would dispatch even when the parent had incorrectly lost CLICKABLE.
    assert(h.scene->memory().commands.pending==(background_toggle?1u:0u)&&sends==sent);
    h.scene->loop();assert(sends==sent+(background_toggle?1u:0u));
    if(background_toggle)assert(sent_service=="homeassistant.toggle");
    const auto center=(slider.x1+slider.x2)/2;
    read(center,(slider.y1+slider.y2)/2,LV_INDEV_STATE_PRESSED);
    read(center,slider.y1+(slider.y2-slider.y1)/3,LV_INDEV_STATE_PRESSED);
    read(center,slider.y1+(slider.y2-slider.y1)/3,LV_INDEV_STATE_RELEASED);
    h.scene->loop();
    const auto expected_sends=sent+(background_toggle?2u:1u);
    assert(sends==expected_sends&&sent_service==(kind==4?"light.turn_on":kind==5?"number":"percent"));
    coordinator.report(entity,"","unavailable");h.scene->loop();
    read(x,y,LV_INDEV_STATE_PRESSED);read(x,y,LV_INDEV_STATE_RELEASED);h.scene->loop();
    assert(sends==expected_sends&&h.scene->memory().commands.pending==0);
    lv_indev_delete(pointer);
  }
}
void appearance_transactions() {
  lv_font_t child_font=lv_font_montserrat_14;
  Document doc(DEVICE_UI_PROFILES[8]);Harness h;h.apply(doc);
  coordinator.report("switch.child","","on");h.scene->loop();
  click(h.widgets[1].button);h.scene->loop();
  assert(h.scene->active_page()==1);
  const auto old=h.scene->binding(1);
  const auto registrations=coordinator.entries.size(),count=objects(h.root);
  PageBasicTheme theme=h.theme;theme.surface=0xEEEEEE;++theme.revision;
  theme.device_width_profile=true;theme.icon_scale_x=256;theme.icon_scale_y=280;
  theme.label_scale_x=256;theme.label_scale_y=290;
  theme.label_lines=2;theme.label_lines_tall=3;
  theme.child_label_font=theme.child_unit_font=&child_font;
  h.arena.fail=true;
  assert(!h.scene->reconfigure({6,2},theme));h.arena.fail=false;
  assert(h.scene->valid(old) && h.scene->active_page()==1);
  assert(h.scene->reconfigure({6,2},theme));h.scene->loop();
  assert(!h.scene->valid(old) && h.scene->active_page()==1 && objects(h.root)==count &&
    coordinator.entries.size()==registrations);
  // No new HA report is needed after rebuilding just the view.
  assert(lv_obj_has_state(h.widgets[1].button,LV_STATE_CHECKED));
  assert(lv_obj_get_style_transform_scale_y(h.widgets[1].icon,LV_PART_MAIN)==280 &&
      lv_obj_get_style_transform_scale_y(h.widgets[1].sensor_container,LV_PART_MAIN)==290 &&
      lv_obj_get_style_text_font(h.widgets[1].label,LV_PART_MAIN)==&child_font);
  assert(h.scene->prepare(PANEL_CONFIG_DOCUMENT_VERSION,doc.bytes.data(),doc.size));
  assert(!h.scene->reconfigure({9,3},h.theme)); // A queued save owns the prepared bank.
  h.scene->discard_prepared();
  h.platform.shown=false;h.scene->loop();
  assert(h.scene->reconfigure({9,3},h.theme));h.scene->loop();
  assert(!h.scene->valid(h.scene->binding(1)));
  h.platform.shown=true;h.scene->loop();assert(h.scene->active_page()==1);
}
void appearance_wake_without_intermediate_maintenance() {
  Document doc(DEVICE_UI_PROFILES[8]);Harness h;h.apply(doc);
  const auto registrations=coordinator.entries.size(),count=objects(h.root);
  auto theme=h.theme;
  for(bool wake_before_refresh : {false,true}) {
    h.platform.shown=false;h.scene->loop();
    if(wake_before_refresh) h.platform.shown=true;
    ++theme.revision;
    assert(h.scene->reconfigure({9,3},theme));
    if(!wake_before_refresh) {
      for(size_t i=0;i<9;++i) {
        assert(!h.scene->valid(h.scene->binding(i)));
        assert(lv_obj_has_flag(h.widgets[i].button,LV_OBJ_FLAG_HIDDEN));
      }
      h.platform.shown=true;
    }
    h.scene->loop();
    for(size_t i=0;i<9;++i) assert(h.scene->valid(h.scene->binding(i)));
    assert(objects(h.root)==count && coordinator.entries.size()==registrations);
  }
  // The same race can occur between a suspended bank and a native save.
  h.platform.shown=false;h.scene->loop();
  h.platform.shown=true;
  h.apply(doc,18);
  for(size_t i=0;i<9;++i) assert(h.scene->valid(h.scene->binding(i)));
  h.scene->loop();
  assert(objects(h.root)==count && coordinator.entries.size()==registrations);
}
void initial_appearance() {
  Document doc(DEVICE_UI_PROFILES[8]);Harness h;
  assert(!h.scene->reconfigure({0,0},h.theme));
  assert(h.scene->reconfigure({6,2},h.theme));
  h.platform.shown=false;h.scene->loop();h.apply(doc);
  for(size_t i=0;i<9;++i) assert(!h.scene->valid(h.scene->binding(i)));
  assert(h.scene->navigation_ready() && h.scene->grid_configured());
  h.platform.shown=true;h.scene->loop();
  for(size_t i=0;i<9;++i) assert(h.scene->valid(h.scene->binding(i))==(i<6));
}
void remote_navigation() {
  Document doc(DEVICE_UI_PROFILES[8]);Harness h;
  auto& navigation=static_cast<ApplicationSceneNavigation&>(*h.scene);
  application_scene_navigation()=&navigation;
  assert(!navigation.navigation_ready() && !navigation.home());
  h.apply(doc);
  const auto count=objects(h.root);
  assert(navigation.navigation_ready() && navigation.subpage_slot()==0);
  assert(navigation.can_open_subpage(" rOoMs ") && !navigation.can_open_subpage("missing"));
  assert(navigation.can_open_modal("climate.child") && !navigation.can_open_modal("switch.one"));
  auto& modal=PageNativeModalBank::instance->runtime();
  assert(!modal.memory().active_contexts && objects(h.root)==count);
  assert(navigation.open_modal(" climate.child "));h.scene->loop();
  assert(h.styles.page==1 && h.scene->active_page()==0);
  const auto opening=modal.token();
  navigation.close_modal();assert(modal.valid(opening) && !modal.interactive(opening));
  h.scene->loop();assert(!modal.memory().active_contexts);
  assert(navigation.open_subpage("Rooms"));h.scene->loop();
  assert(h.scene->active_page()==1 && navigation.subpage_slot()==2 && navigation.subpage_label()=="Rooms");
  assert(navigation.open_settings());h.scene->loop();assert(h.platform.settings);
  navigation.close_settings();h.scene->loop();assert(!h.platform.settings && h.scene->active_page()==1);
  h.platform.shown=false;h.scene->loop();
  assert(navigation.home());h.scene->loop();assert(h.scene->active_page()==1);
  h.platform.shown=true;h.scene->loop();assert(h.scene->active_page()==0);
  coordinator.report("switch.one","","off");h.scene->loop();
  const auto sent=sends;
  assert(navigation.navigate("Toggle"));assert(sends==sent);
  h.scene->loop();assert(sends==sent);
  h.scene->loop();assert(sends==sent+1 && sent_entity=="switch.one");
  assert(navigation.navigate("slot:2"));h.scene->loop();assert(h.scene->active_page()==1);
  assert(navigation.close_subpage());h.scene->loop();assert(h.scene->active_page()==0);
  assert(navigation.open_subpage("Rooms") && navigation.close_subpage());
  h.scene->loop();assert(h.scene->active_page()==0);
  assert(!navigation.navigate("slot:0") && !navigation.navigate("slot:999999999999") &&
      !navigation.navigate("missing"));
  locked=true;
  assert(!navigation.can_open_modal("climate.child") && !navigation.can_open_subpage("Rooms") &&
      !navigation.navigate("Toggle"));
  locked=false;
  assert(navigation.open_settings());navigation.close_settings();h.scene->loop();
  assert(!h.platform.settings && !modal.memory().active_contexts);
  assert(navigation.open_modal("climate.child"));h.scene->loop();
  navigation.close_settings();h.scene->loop();assert(modal.token().kind==ControlModalKind::CLIMATE);
  navigation.close_modal();h.scene->loop();
  assert(navigation.navigate("Toggle"));h.apply(doc,18);h.scene->loop();
  assert(sends==sent+1 && objects(h.root)==count);
}
void remote_selection_order() {
  {
    Document doc(DEVICE_UI_PROFILES[8],"climate.child;Root duplicate;Auto;Auto;;;climate;;");
    Harness h;h.apply(doc);
    assert(h.scene->open_modal("climate.child"));h.scene->loop();
    assert(h.styles.page==0 && h.styles.card==8);
  }
  {
    Document doc(DEVICE_UI_PROFILES[8],"number.room;Level;Auto;Auto;;;slider;;","1,3,4,5,6,7,8,9");
    Harness h;h.apply(doc);
    assert(!h.scene->can_open_subpage("Rooms") && !h.scene->can_open_modal("climate.child"));
  }
  {
    Document doc(DEVICE_UI_PROFILES[8],"switch.nine;Toggle;Auto;Auto;;;;;","9,2,3,4,5,6,7,8,1");
    Harness h;h.apply(doc);
    coordinator.report("switch.one","","off");coordinator.report("switch.nine","","off");h.scene->loop();
    const auto sent=sends;
    assert(h.scene->navigate("toggle"));h.scene->loop();h.scene->loop();
    assert(sends==sent+1 && sent_entity=="switch.nine");
  }
}
void qr_images_and_transactions() {
  Document doc(DEVICE_UI_PROFILES[8]);Harness h;h.apply(doc);
  // Three QR tiles coexist with a two-slot image pool. QR owns visible-slot leases.
  const auto count=objects(h.root);
  coordinator.report("image.front","","now");
  coordinator.report("image.front","entity_picture","/api/image/picture");
  tick+=5000;h.scene->loop();h.scene->loop();
  assert(h.scene->memory().image_leases==1);
  for(size_t i=5;i<8;++i) {
    const auto qr=h.scene->qr_snapshot(h.scene->binding(i));
    assert(qr.ready && !qr.failed && qr.asset);
  }
  assert(h.a.request || h.b.request);
  auto& image=h.a.request?h.a:h.b;
  image.ready=true;image.reply();h.scene->loop();
  lv_refr_now(lv_display_get_default());
  h.platform.shown=false;h.scene->loop();
  assert(h.scene->memory().image_leases==0);
  h.platform.shown=true;h.scene->loop();h.scene->loop();
  const auto registrations=coordinator.entries.size();
  h.arena.fail=true;
  assert(!h.scene->prepare(PANEL_CONFIG_DOCUMENT_VERSION,doc.bytes.data(),doc.size));
  h.arena.fail=false;
  assert(h.scene->active().generation()==17 && h.scene->active_page()==0 && coordinator.entries.size()==registrations);
  h.apply(doc,18);
  assert(h.scene->active().generation()==18 && coordinator.entries.size()==registrations && objects(h.root)==count);
  const auto origin=h.scene->chrome_origin();
  assert(h.scene->request_settings(origin));h.scene->loop();assert(h.platform.settings);
  PageNativeModalBank::instance->runtime().dismiss();h.scene->loop();assert(!h.platform.settings);
  click(h.widgets[2].button);h.scene->loop();
  const auto token=PageNativeModalBank::instance->runtime().token();
  { ModalCallbackDispatchScope callback; h.scene->stop(); assert(!h.scene->ready() && !PageNativeModalBank::instance->runtime().valid(token)); }
  assert(!h.scene->prepare(PANEL_CONFIG_DOCUMENT_VERSION,doc.bytes.data(),doc.size));
}
int main() {
  lv_init();auto* display=lv_display_create(480,480);assert(display);
  lv_timer_pause(lv_display_get_refr_timer(display));
  static std::array<uint16_t,480*32> pixels{};
  lv_display_set_buffers(display,pixels.data(),nullptr,sizeof(pixels),LV_DISPLAY_RENDER_MODE_PARTIAL);
  lv_display_set_flush_cb(display,[](lv_display_t* d,const lv_area_t*,uint8_t*) { lv_display_flush_ready(d); });
  native_dispatch_safe=[] { return lv_is_initialized() && !page_lvgl_dispatching() && !modal_callback_dispatching(); };
  navigation_and_state();live_temperature_policy();elastic_state_scene_transactions();maximum_profile_disjoint_replacements();panels_and_retirement();mode_and_feedback();source_styles();slider_input();slider_background_hit_testing();appearance_transactions();initial_appearance();appearance_wake_without_intermediate_maintenance();remote_navigation();
  assert(!application_scene_navigation());
  remote_selection_order();qr_images_and_transactions();
  native_dispatch_safe=nullptr;
  lv_display_delete(display);lv_deinit();
}
