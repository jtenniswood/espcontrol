struct HomeassistantActionRequest { std::string service; };
}
bool ha_send_entity_action(const std::string& entity,const char* service) {
  ++sends; sent_entity=entity; sent_service=service; return online && api;
}
bool ha_send_entity_action(const std::string& entity,const char* service,const char*,const char*) {
  return ha_send_entity_action(entity,service);
}
void send_toggle_action(const std::string& e) { ha_send_entity_action(e,"homeassistant.toggle"); }
void send_turn_on_action(const std::string& e) { ha_send_entity_action(e,"homeassistant.turn_on"); }
void send_turn_off_action(const std::string& e) { ha_send_entity_action(e,"homeassistant.turn_off"); }
void send_action_card_action(const ParsedCfg& p) { ha_send_entity_action(p.entity,p.sensor.c_str()); }
void send_local_action(const std::string&) { ++sends; }
void send_internal_relay_action(const ParsedCfg&) { ++sends; }
void send_webhook_action(const ParsedCfg&) { ++sends; }
bool send_slider_action(const std::string& e,int,bool) { return ha_send_entity_action(e,"percent"); }
bool send_numeric_slider_action(const std::string& e,double,const espcontrol::number_slider::Metadata&) { return ha_send_entity_action(e,"number"); }
bool send_media_playback_action(const std::string& e,const std::string&) { return ha_send_entity_action(e,"media"); }
bool send_media_playlist_action(const ParsedCfg& p) { return ha_send_entity_action(p.entity,"playlist"); }
bool send_media_seek_action(const std::string& e,int,float) { return ha_send_entity_action(e,"seek"); }
bool send_cover_command_action(const ParsedCfg& p,bool = false) { return ha_send_entity_action(p.entity,"cover"); }
std::function<void()>& force_screensaver_action() { static std::function<void()> action; return action; }
void screen_lock_activate(bool) { locked=true; }
bool ha_action_begin(esphome::api::HomeassistantActionRequest& r,const char* name,bool,size_t) { r.service=name; return api; }
void ha_action_add_data(esphome::api::HomeassistantActionRequest&,const char*,const char*) {}
bool ha_action_send(esphome::api::HomeassistantActionRequest& r) { ++sends; sent_service=r.service; return api; }
