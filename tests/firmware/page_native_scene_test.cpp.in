  TestStyle<espcontrol::cards::ClimateControlDriverEnvironment> climate;
  TestStyle<PageControlModalEnvironment> light,cover;
  TestStyle<PageFanControlModalEnvironment> fan,fan_preset;
  TestStyle<PageOptionSelectModalEnvironment> options;
