constexpr uint32_t DEFAULT_ACCENT_COLOR = 0xFF8C00;
static size_t lv_live_bytes = 0, lv_allocation_calls = 0, cpp_allocation_calls = 0;
void* operator new(size_t size) {
  ++cpp_allocation_calls;
  if (void* p = std::malloc(size ? size : 1)) return p;
  std::abort();
}
void* operator new[](size_t size) {
  return ::operator new(size);
}
void operator delete(void* p) noexcept {
  std::free(p);
}
void operator delete[](void* p) noexcept {
  std::free(p);
}
void operator delete(void* p, std::size_t) noexcept {
  std::free(p);
}
void operator delete[](void* p, std::size_t) noexcept {
  std::free(p);
}
struct alignas(std::max_align_t) Allocation {
  size_t bytes;
};
extern "C" {
void lv_mem_init() {}
void lv_mem_deinit() {}
lv_mem_pool_t lv_mem_add_pool(void*, size_t) {
  return nullptr;
}
void lv_mem_remove_pool(lv_mem_pool_t) {}
void* lv_malloc_core(size_t size) {
  ++lv_allocation_calls;
  auto* p = static_cast<Allocation*>(std::malloc(size + sizeof(Allocation)));
  assert(p);
  p->bytes = size;
  lv_live_bytes += size;
  return p + 1;
}
void lv_free_core(void* ptr) {
  if (!ptr) return;
  auto* p = static_cast<Allocation*>(ptr) - 1;
  lv_live_bytes -= p->bytes;
  std::free(p);
}
void* lv_realloc_core(void* ptr, size_t size) {
  void* p = lv_malloc_core(size);
  if (ptr) {
    std::memcpy(p, ptr, std::min(size, (static_cast<Allocation*>(ptr) - 1)->bytes));
    lv_free_core(ptr);
  }
  return p;
}
void lv_mem_monitor_core(lv_mem_monitor_t* out) {
  *out = {};
}
lv_result_t lv_mem_test_core() {
  return LV_RESULT_OK;
}
}

