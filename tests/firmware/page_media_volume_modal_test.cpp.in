}
struct ControlModalShell {
  lv_obj_t *overlay, *panel, *close_btn;
};
ControlModalShell control_modal_open_shell(ControlModalKind kind, lv_obj_t*, int, const lv_font_t*,
                                           void (*hide)()) {
  auto* overlay = lv_obj_create(lv_layer_top());
  auto* panel = lv_obj_create(overlay);
  auto* close = lv_button_create(panel);
  lv_label_create(close);
  lv_obj_add_event_cb(
      close,
      [](lv_event_t* e) {
        auto fn = reinterpret_cast<void (*)()>(lv_event_get_user_data(e));
        fn();
      },
      LV_EVENT_CLICKED, reinterpret_cast<void*>(hide));
  modal_service.set_active(kind, overlay, hide, ControlModalDismissPolicy::DISMISS);
  return {overlay, panel, close};
}
lv_obj_t* control_modal_create_round_button(lv_obj_t* parent, int, const char*, const lv_font_t*, uint32_t,
                                            uint32_t, int) {
  return lv_button_create(parent);
}
void media_volume_layout_modal(MediaVolumeCtx*) {}
size_t sends = 0, previews = 0;
espcontrol::media::VolumeCommand last_command;
PageModalToken preview_token{};
std::function<void()> during_send, during_preview;
void send_media_volume_command(const std::string&, espcontrol::media::VolumeCommand command) {
  if (command.kind == espcontrol::media::VolumeCommandKind::NONE) return;
  ++sends;
  last_command = command;
  if (during_send) during_send();
}
