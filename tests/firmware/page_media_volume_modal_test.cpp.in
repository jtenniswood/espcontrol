// Request admission runs inside the input callback; panel allocation belongs to loop().
static bool request_without_allocation(PageModalRuntime& runtime, ConfigurationHandle token) {
  const auto cpp = cpp_allocation_calls, lv = lv_allocation_calls;
  const bool accepted = runtime.request_card(token);
  assert(cpp_allocation_calls == cpp && lv_allocation_calls == lv);
  return accepted;
}

struct Arena : PageArenaAllocator {
  std::unordered_map<void*, size_t> live;
  int remaining{-1};
  void* allocate(size_t size) override {
    if (remaining == 0) return nullptr;
    if (remaining > 0) --remaining;
    void* p = std::malloc(size);
    assert(p);
    live[p] = size;
    return p;
  }
  void release(void* p, size_t size) override {
    assert(live.at(p) == size);
    live.erase(p);
    std::free(p);
  }
};
struct Fixture {
  explicit Fixture(uint32_t generation = 17) {
    const auto& limits = DEVICE_UI_PROFILES[8];
    PanelConfigWriter writer(document.data(), document.size());
    assert(writer.begin() == PanelConfigStatus::OK);
    assert(writer.append_device_profile(reinterpret_cast<const uint8_t*>(limits.device_profile),
                                        std::strlen(limits.device_profile)) == PanelConfigStatus::OK);
    const char* cards[] = {"media_player.room;Volume;Auto;Auto;volume;;media;;volume_max=80",
                           "media_player.other;Other;Auto;Auto;volume;;media;;"};
    for (size_t i = 0; i < 2; ++i)
      assert(writer.append_button(i + 1, reinterpret_cast<const uint8_t*>(cards[i]), std::strlen(cards[i])) ==
             PanelConfigStatus::OK);
    assert(writer.finish(&size) == PanelConfigStatus::OK);
    assert(PageStore::stage_v1(document.data(), size, limits, generation, storage.data(), storage.size(),
                               &store) == PageStoreStatus::OK);
  }
  std::array<uint8_t, 8192> document{};
  size_t size = 0;
  alignas(std::max_align_t) std::array<uint8_t, 32768> storage{};
  PageStore store;
};
void values(const char* features = "4", const char* volume = "0.42") {
  auto& t = coordinator.transport();
  t.send("media_player.room", "", "playing");
  t.send("media_player.room", "supported_features", features);
  t.send("media_player.room", "volume_level", volume);
  t.send("media_player.other", "", "idle");
  t.send("media_player.other", "supported_features", "4");
  t.send("media_player.other", "volume_level", "0.2");
}
void press(lv_obj_t* object) {
  lv_obj_send_event(object, LV_EVENT_PRESSED, nullptr);
  lv_obj_send_event(object, LV_EVENT_RELEASED, nullptr);
  lv_obj_send_event(object, LV_EVENT_CLICKED, nullptr);
}
void test_volume() {
  Fixture fixture, next(18);
  Arena arena;
  PageCardDependencies source;
  CoordinatorPageEntitySubscriptions subscriptions(coordinator, 16);
  {
    PageEntityStateRuntime state(source, arena, subscriptions, {64, 64, 8192});
    assert(state.prepare(fixture.store));
    state.activate_prepared(fixture.store);
    values();
    bool styles = true;
    PageMediaVolumeModalStyle style;
    style.owner = &styles;
    style.resolve = [](void* p, PageModalToken, const ParsedCfg&, PageMediaVolumeModalEnvironment&) {
      return *static_cast<bool*>(p);
    };
    style.numeric_action_sent = [](void*, PageModalToken token, float value) {
      assert(value >= 0 && value <= 80);
      ++previews;
      preview_token = token;
      if (during_preview) during_preview();
    };
    PageMediaVolumeModalPort port(arena, state, style, nullptr, [](void*, PageBindingToken) { return true; });
    auto router = modal_test_router<ControlModalKind::MEDIA_VOLUME>(port);
    PageModalRuntime runtime(router);
    assert(!port.install(runtime, false));
    assert(port.install(runtime, true));
    assert(runtime.prepare(fixture.store));
    runtime.activate_prepared(fixture.store);
    const auto baseline = arena.live.size(), refs = coordinator.subscription_count(),
               native = coordinator.transport().bindings.size(), lv_bytes = lv_live_bytes;
    auto open = [&]() {
      assert(request_without_allocation(runtime, {17, 0}));
      runtime.loop();
      assert(media_volume_modal_ui().active);
    };
    auto close = [&]() {
      media_volume_hide_modal();
      runtime.loop();
      assert(!media_volume_modal_ui().active);
      assert(arena.live.size() == baseline && coordinator.subscription_count() == refs &&
             coordinator.transport().bindings.size() == native && lv_live_bytes == lv_bytes);
    };
    open();
    auto& ui = media_volume_modal_ui();
    assert(ui.active->current_pct == 42 && ui.active->max_pct == 80);
    auto token = runtime.token();
    const auto before = sends;
    lv_obj_send_event(ui.plus_btn, LV_EVENT_CLICKED, nullptr);
    assert(sends == before);
    press(ui.plus_btn);
    assert(sends == before + 1 && last_command.kind == media::VolumeCommandKind::SET_ABSOLUTE &&
           last_command.value == 43 && previews == 1 && preview_token.opening == token.opening);
    // Replayed stale HA values retain the local preview until acknowledgement or grace expiry.
    values("4", "0.1");
    runtime.loop();
    assert(ui.active->current_pct == 43 && lv_arc_get_value(ui.arc) == 43);
    values("4", "0.43");
    runtime.loop();
    assert(ui.active->pending_pct == -1 && ui.active->current_pct == 43);
    press(ui.plus_btn);
    test_now += 1501;
    runtime.loop();
    assert(ui.active->current_pct == 43 && ui.active->pending_pct == -1);
    // No HA callback registration, arena or C++/LVGL allocation on unchanged frames.
    const auto cpp = cpp_allocation_calls, lv_calls = lv_allocation_calls;
    for (int n = 0; n < 1000; ++n) {
      runtime.loop();
    }
    assert(cpp_allocation_calls == cpp && lv_allocation_calls == lv_calls);
    // Capabilities/level change after the last loop but before the actual input.
    values("1024", "0.85");
    auto sent = sends, preview = previews;
    press(ui.minus_btn);
    assert(sends == sent + 1 && last_command.kind == media::VolumeCommandKind::STEP_DOWN &&
           ui.active->current_pct == 85 && previews == preview);
    values("0", "0.5");
    sent = sends;
    press(ui.plus_btn);
    assert(sends == sent && ui.active->volume_control_mode == media::VolumeControlMode::READ_ONLY);
    values("4", "0.6");
    runtime.loop();
    lv_obj_send_event(ui.arc, LV_EVENT_PRESSED, nullptr);
    lv_arc_set_value(ui.arc, 70);
    values("1024", "0.61");
    sent = sends;
    lv_obj_send_event(ui.arc, LV_EVENT_VALUE_CHANGED, nullptr);
    assert(sends == sent && ui.active->current_pct == 61);
    values("4", "0.6");
    runtime.loop();
    lv_obj_send_event(ui.arc, LV_EVENT_PRESSED, nullptr);
    lv_arc_set_value(ui.arc, 73);
    values("4", "0.4");
    lv_obj_send_event(ui.arc, LV_EVENT_VALUE_CHANGED, nullptr);
    assert(last_command.value == 73 && ui.active->current_pct == 73);
    close();
    values();
    for (int n = 0; n < 1000; ++n) {
      open();
      assert(ui.active->current_pct == 42);
      close();
    }
    // No-value sources, quiet unknown volume and capability-limited display.
    for (const char* unavailable : {"", "unknown", "  UNAVAILABLE  "}) {
      coordinator.transport().send("media_player.room", "", unavailable);
      assert(request_without_allocation(runtime, {17, 0}));
      runtime.loop();
      assert(!ui.active);
    }
    values("4", "unknown");
    open();
    assert(!ui.active->volume_known);
    const auto unknown_calls = lv_allocation_calls;
    for (int n = 0; n < 1000; ++n) {
      runtime.loop();
    }
    assert(lv_allocation_calls == unknown_calls);
    close();
    values();
    // Retired events are filtered while the context remains alive through dispatch.
    open();
    preview = previews;
    auto* ctx = ui.active;
    auto* button = ui.plus_btn;
    lv_obj_send_event(button, LV_EVENT_PRESSED, nullptr);
    during_send = [&]() {
      runtime.dismiss(PageModalClose::TAKEOVER);
      runtime.loop();
      assert(runtime.memory().retired_contexts == 1 && !media_volume_action_allowed(ctx));
    };
    lv_obj_send_event(button, LV_EVENT_RELEASED, nullptr);
    lv_obj_send_event(button, LV_EVENT_CLICKED, nullptr);
    during_send = {};
    runtime.loop();
    assert(!ui.active && previews == preview);
    open();
    ctx = ui.active;
    during_preview = [&]() {
      assert(runtime.prepare(next.store));
      runtime.activate_prepared(next.store);
      assert(!media_volume_action_allowed(ctx));
      const auto stale = sends;
      press(ui.plus_btn);
      assert(sends == stale);
      std::memset(fixture.storage.data(), 0xA5, fixture.storage.size());
      runtime.loop();
      assert(runtime.memory().retired_contexts == 1 && ctx->entity_id == "media_player.room");
    };
    press(ui.plus_btn);
    during_preview = {};
    runtime.loop();
    assert(!ui.active);
    assert(state.prepare(next.store));
    state.activate_prepared(next.store);
    values();
    assert(request_without_allocation(runtime, {18, 0}));
    runtime.loop();
    assert(ui.active);
    runtime.dismiss();
    runtime.loop();
    // Admissions failures and reconnect invalidation leave no partially built panel.
    for (int budget : {0, 1}) {
      arena.remaining = budget;
      assert(request_without_allocation(runtime, {18, 0}));
      runtime.loop();
      arena.remaining = -1;
      assert(!ui.active && arena.live.size() == baseline);
    }
    styles = false;
    assert(request_without_allocation(runtime, {18, 0}));
    runtime.loop();
    styles = true;
    assert(!ui.active);
    enough_heap = false;
    assert(request_without_allocation(runtime, {18, 0}));
    runtime.loop();
    enough_heap = true;
    assert(!ui.active);
    assert(request_without_allocation(runtime, {18, 0}));
    runtime.loop();
    assert(ui.active);
    sent = sends;
    coordinator.transport().connected = false;
    coordinator.invalidate_retained_state();
    press(ui.plus_btn);
    runtime.loop();
    assert(!ui.active && sends == sent);
    coordinator.transport().connected = true;
    values();
    assert(request_without_allocation(runtime, {18, 0}));
    runtime.loop();
    assert(ui.active);
    assert_panel_draw_retirement(runtime, ui.overlay);
    runtime.retire_active();
    runtime.loop();
    state.retire_active();
  }
  coordinator.reclaim_unused_channels();
  assert(arena.live.empty() && coordinator.transport().bindings.empty());
}
void test_gesture_budget() {
  Fixture fixture;
  Arena arena;
  PageCardDependencies source;
  CoordinatorPageEntitySubscriptions subscriptions(coordinator, 16);
  {
    PageEntityStateRuntime state(source, arena, subscriptions, {64, 64, 8192});
    assert(state.prepare(fixture.store));
    state.activate_prepared(fixture.store);
    values();
    const auto baseline = arena.live.size(), refs = coordinator.subscription_count(), bytes = lv_live_bytes;
    PageMediaVolumeModalStyle style;
    style.gesture_capacity = 1;
    style.resolve = [](void*, PageModalToken, const ParsedCfg&, PageMediaVolumeModalEnvironment&) {
      return true;
    };
    PageMediaVolumeModalPort port(arena, state, style, nullptr, [](void*, PageBindingToken) { return true; });
    auto router = modal_test_router<ControlModalKind::MEDIA_VOLUME>(port);
    PageModalRuntime runtime(router);
    assert(port.install(runtime, true));
    assert(runtime.prepare(fixture.store));
    runtime.activate_prepared(fixture.store);
    assert(request_without_allocation(runtime, {17, 0}));
    runtime.loop();
    assert(!media_volume_modal_ui().active && runtime.memory().failures == 1 &&
           arena.live.size() == baseline && lv_live_bytes == bytes &&
           coordinator.subscription_count() == refs);
    state.retire_active();
  }
  coordinator.reclaim_unused_channels();
  assert(arena.live.empty() && coordinator.transport().bindings.empty());
}
int main() {
  lv_init();
  auto* display = lv_display_create(480, 480);
  assert(display);
  lv_timer_pause(lv_display_get_refr_timer(display));
  test_volume();
  test_gesture_budget();
  lv_display_delete(display);
  lv_deinit();
  assert(lv_live_bytes == 0);
}
