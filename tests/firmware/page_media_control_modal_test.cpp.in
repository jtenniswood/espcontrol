#include "page_media_control_modal.h"
struct Arena : PageArenaAllocator {
  std::unordered_map<void*, size_t> live;
  int remaining{-1};
  bool capture_record{false};
  size_t recycled_size{0};
  void* recycled{nullptr};
  ~Arena() {
    std::free(recycled);
  }
  void* allocate(size_t size) override {
    if (remaining == 0) return nullptr;
    if (remaining > 0) --remaining;
    if (capture_record) {
      recycled_size = size;
      capture_record = false;
    }
    void* p = nullptr;
    if (recycled && size == recycled_size) {
      p = recycled;
      recycled = nullptr;
    } else
      p = std::malloc(size);
    assert(p);
    live[p] = size;
    return p;
  }
  void release(void* p, size_t size) override {
    assert(live.at(p) == size);
    live.erase(p);
    if (size == recycled_size && !recycled)
      recycled = p;
    else
      std::free(p);
  }
};
struct Fixture {
  explicit Fixture(uint32_t generation = 17, bool cover = false, bool speaker = false) {
    const auto& limits = DEVICE_UI_PROFILES[8];
    PanelConfigWriter writer(document.data(), document.size());
    assert(writer.begin() == PanelConfigStatus::OK);
    assert(writer.append_device_profile(reinterpret_cast<const uint8_t*>(limits.device_profile),
                                        std::strlen(limits.device_profile)) == PanelConfigStatus::OK);
    const char* cards[] = {speaker ? "media_player.room;Group;Auto;Auto;speaker_group;;media;;"
                           : cover ? "media_player.room;Art;Auto;Auto;cover_art;;media;;power_entity=switch."
                                     "power,cover_art_secondary_entity=media_player.other"
                                   : "media_player.room;Controls;Auto;Auto;control_modal;;media;;volume_max="
                                     "80,power_entity=switch.power",
                           "media_player.other;Other;Auto;Auto;control_modal;;media;;"};
    for (size_t i = 0; i < 2; ++i)
      assert(writer.append_button(i + 1, reinterpret_cast<const uint8_t*>(cards[i]), std::strlen(cards[i])) ==
             PanelConfigStatus::OK);
    assert(writer.finish(&size) == PanelConfigStatus::OK);
    assert(PageStore::stage_v1(document.data(), size, limits, generation, storage.data(), storage.size(),
                               &store) == PageStoreStatus::OK);
  }
  std::array<uint8_t, 8192> document{};
  size_t size = 0;
  alignas(std::max_align_t) std::array<uint8_t, 32768> storage{};
  PageStore store;
};

void values() {
  auto& t = coordinator.transport();
  for (const char* entity : {"media_player.room", "media_player.other"}) {
    t.send(entity, "", "paused");
    t.send(entity, "supported_features", "819204");
    t.send(entity, "volume_level", "0.42");
    t.send(entity, "media_content_type", "music");
    t.send(entity, "media_content_id", "content");
    t.send(entity, "media_title", "Title");
    t.send(entity, "media_artist", "Artist");
    t.send(entity, "media_duration", "120");
    t.send(entity, "media_position", "10");
    t.send(entity, "group_members", "[]");
    t.send(entity, "shuffle", "off");
    t.send(entity, "repeat", "off");
  }
  t.send("switch.power", "", "on");
  t.send("sensor.speaker_group", "data",
         "v2|[[\"media_player.room\",\"Room\",0.42,true],[\"media_player.other\",\"Other\",0.3,true]]");
}
void press(lv_obj_t* object) {
  assert(object);
  lv_obj_send_event(object, LV_EVENT_PRESSED, nullptr);
  lv_obj_send_event(object, LV_EVENT_RELEASED, nullptr);
  lv_obj_send_event(object, LV_EVENT_CLICKED, nullptr);
}
void test_panels() {
  Fixture fixture, next(18), cover(19, true), speaker(20, false, true);
  Arena arena;
  PageCardDependencies dependencies;
  CoordinatorPageEntitySubscriptions subscriptions(coordinator, 64);
  MediaTransport transport;
  PageMediaStateRuntime media(arena, transport);
  ActionResponseCallback after_destroy;
  {
    PageEntityStateRuntime state(dependencies, arena, subscriptions, {128, 128, 16384}, &media);
    assert(media.prepare(fixture.store) && state.prepare(fixture.store));
    media.activate_prepared(fixture.store);
    state.activate_prepared(fixture.store);
    values();
    bool styles = true;
    PageMediaControlModalStyle style;
    style.owner = &styles;
    style.environment.media = &media;
    style.resolve = [](void* p, const ParsedCfg&, PageMediaControlModalEnvironment&) {
      return *static_cast<bool*>(p);
    };
    style.numeric_action_sent = [](void*, PageModalToken token, float) {
      ++previews;
      preview_token = token;
      if (during_preview) during_preview();
    };
    PageMediaControlModalPort port(arena, state, style, nullptr,
                                   [](void*, PageBindingToken) { return true; });
    PageModalRuntime runtime(port);
    assert(!port.install(runtime, false));
    assert(port.install(runtime, true));
    assert(runtime.prepare(fixture.store));
    runtime.activate_prepared(fixture.store);
    auto& ui = media_control_modal_ui();
    auto& t = coordinator.transport();
    auto open = [&](uint32_t generation = 17) {
      assert(runtime.request_card({generation, 0}));
      runtime.loop();
      assert(ui.active);
    };
    auto close = [&]() {
      media_control_hide_modal();
      runtime.loop();
      assert(!ui.active);
    };
    open();
    assert(ui.active->current_pct == 42 && ui.active->title == "Title" &&
           ui.active->power_entity == "switch.power");
    press(ui.play_btn);
    assert(last_action == "play_pause");
    close();
    const auto baseline = arena.live.size(), cpp_bytes = cpp_live_bytes, lv_bytes = lv_live_bytes,
               refs = coordinator.subscription_count(), registrations = t.bindings.size();
    for (int n = 0; n < 1000; ++n) {
      open();
      close();
      assert(arena.live.size() == baseline && cpp_live_bytes == cpp_bytes && lv_live_bytes == lv_bytes &&
             coordinator.subscription_count() == refs && t.bindings.size() == registrations);
    }
    open();
    const auto cpp_calls = cpp_allocation_calls, lv_calls = lv_allocation_calls;
    for (int n = 0; n < 1000; ++n) {
      runtime.loop();
    }
    assert(cpp_allocation_calls == cpp_calls && lv_allocation_calls == lv_calls);
    // A hidden player's shared clock ticks without allocating in this paused panel.
    t.send("media_player.other", "", "playing");
    runtime.loop();
    const auto quiet_cpp = cpp_allocation_calls, quiet_lv = lv_allocation_calls;
    for (int n = 0; n < 1000; ++n) {
      test_now += 1000;
      media.loop();
      runtime.loop();
    }
    assert(cpp_allocation_calls == quiet_cpp && lv_allocation_calls == quiet_lv);
    // Fresh capabilities do not delete the button while its input is dispatching.
    assert(ui.shuffle_btn && ui.repeat_btn);
    auto* shuffle = ui.shuffle_btn;
    bool deleted = false;
    lv_obj_add_event_cb(
        shuffle, [](lv_event_t* e) { *static_cast<bool*>(lv_event_get_user_data(e)) = true; },
        LV_EVENT_DELETE, &deleted);
    t.send("media_player.room", "supported_features", "4");
    auto sent = sends;
    press(shuffle);
    assert(sends == sent && !deleted);
    runtime.loop();
    assert(deleted && !ui.shuffle_btn && !ui.repeat_btn);
    t.send("media_player.room", "supported_features", "819204");
    press(ui.play_btn);
    runtime.loop();
    assert(ui.shuffle_btn && ui.repeat_btn);
    press(ui.shuffle_btn);
    assert(last_action == "shuffle" && last_value == 1);
    press(ui.repeat_btn);
    assert(last_action == "repeat");
    // A separate Power tab remains usable after the main player goes offline.
    t.send("media_player.room", "", "unavailable");
    runtime.loop();
    assert(ui.active && ui.tab == MediaControlTab::POWER && ui.visible_tabs.count == 1);
    press(ui.power_btn);
    assert(last_action == "homeassistant.turn_off" && last_entity == "switch.power");
    t.send("switch.power", "", "unavailable");
    runtime.loop();
    assert(!ui.active);
    values();
    open();
    // Volume target calculation consumes current state even before the next loop.
    press(ui.volume_tab);
    t.send("media_player.room", "volume_level", ".35");
    press(ui.volume_plus_btn);
    assert(last_value == 36 && ui.active->current_pct == 36 && previews == 1 &&
           preview_token.opening == runtime.token().opening);
    t.send("media_player.room", "volume_level", ".1");
    runtime.loop();
    assert(ui.active->current_pct == 36);
    test_now += 1501;
    runtime.loop();
    assert(ui.active->current_pct == 10);
    t.send("media_player.room", "supported_features", "1024");
    t.send("media_player.room", "volume_level", ".85");
    auto preview = previews;
    press(ui.volume_minus_btn);
    assert(ui.active->current_pct == 85 && previews == preview && last_value == 85);
    t.send("media_player.room", "supported_features", "0");
    sent = sends;
    press(ui.volume_plus_btn);
    assert(sends == sent);
    values();
    runtime.loop();
    // Delayed seek reports retain the target until the actual player acknowledges.
    if (ui.progress_tab) {
      press(ui.progress_tab);
      auto* slider = ui.progress_slider;
      lv_obj_send_event(slider, LV_EVENT_PRESSED, nullptr);
      lv_slider_set_value(slider, 70, LV_ANIM_OFF);
      lv_obj_send_event(slider, LV_EVENT_VALUE_CHANGED, nullptr);
      lv_obj_send_event(slider, LV_EVENT_RELEASED, nullptr);
      assert(last_action == "seek" && last_value == 70 && ui.active->seek_pending);
      runtime.loop();
      assert(ui.active->position_seconds == 84);
      t.send("media_player.room", "media_position", "84");
      runtime.loop();
      assert(!ui.active->seek_pending);
    }
    // Fresh discovery values are copied without repainting the pressed row.
    t.send("media_player.room", "group_members", "['media_player.room','media_player.other']");
    runtime.loop();
    press(ui.speakers_tab);
    auto* fresh_row = media_control_find_speaker_row("media_player.other");
    t.send("sensor.speaker_group", "data",
           "v2|[[\"media_player.room\",\"Room\",0.42,true],[\"media_player.other\",\"Other\",0.6,true]]");
    press(fresh_row->volume_plus_btn);
    assert(last_entity == "media_player.other" && last_value == 61);
    t.send("media_player.room", "group_members", "['media_player.room']");
    sent = sends;
    press(fresh_row->volume_plus_btn);
    assert(sends == sent);
    runtime.loop();
    // Membership changes between sends stop the rest of a captured group action.
    t.send("media_player.room", "group_members", "['media_player.room','media_player.other']");
    values();
    t.send("media_player.room", "group_members", "['media_player.room','media_player.other']");
    runtime.loop();
    press(ui.volume_tab);
    sent = sends;
    during_send = [&]() { t.send("media_player.room", "group_members", "['media_player.room']"); };
    press(ui.volume_plus_btn);
    during_send = {};
    assert(sends == sent + 1 && last_entity == "media_player.room");
    runtime.loop();
    values();
    runtime.loop();
    // Confirmed joins/unjoins survive clock and other attribute updates while
    // HA still reports the previous membership. A new membership wins later.
    press(ui.speakers_tab);
    auto* confirmed = media_control_find_speaker_row("media_player.other");
    assert(confirmed);
    t.send("media_player.room", "", "playing");
    {
      espcontrol::ModalCallbackDispatchScope callback;
      media_control_toggle_speaker(ui.active, confirmed, true);
    }
    group_calls.back().callback({true});
    assert(media_control_group_contains(ui.active, "media_player.other"));
    for (int n = 0; n < 5; ++n) {
      test_now += 1000;
      media.loop();
      runtime.loop();
      assert(media_control_group_contains(ui.active, "media_player.other"));
      t.send("media_player.room", "shuffle", n % 2 ? "off" : "on");
      runtime.loop();
      assert(media_control_group_contains(ui.active, "media_player.other") && confirmed->selected);
    }
    t.send("media_player.room", "group_members", "['media_player.room','media_player.other']");
    runtime.loop();
    {
      espcontrol::ModalCallbackDispatchScope callback;
      media_control_toggle_speaker(ui.active, confirmed, false);
    }
    group_calls.back().callback({true});
    for (int n = 0; n < 3; ++n) {
      test_now += 1000;
      media.loop();
      runtime.loop();
      assert(!media_control_group_contains(ui.active, "media_player.other"));
    }
    t.send("media_player.room", "group_members", "['media_player.room']");
    runtime.loop();
    assert(!media_control_group_contains(ui.active, "media_player.other"));
    values();
    runtime.loop();
    // Group responses carry their opening identity, including after context reuse.
    close();
    arena.capture_record = true;
    open();
    auto* old_context = ui.active;
    press(ui.speakers_tab);
    assert(ui.speaker_rows.size() == 2);
    auto* row = media_control_find_speaker_row("media_player.other");
    assert(row);
    {
      espcontrol::ModalCallbackDispatchScope callback;
      media_control_toggle_speaker(ui.active, row, true);
    }
    assert(!group_calls.empty() && last_action == "join");
    auto old_response = group_calls.back().callback;
    close();
    open();
    auto* new_context = ui.active;
    assert(new_context == old_context);
    after_destroy = old_response;
    sent = sends;
    old_response({true});
    assert(ui.active == new_context && sends == sent);
    press(ui.speakers_tab);
    row = media_control_find_speaker_row("media_player.other");
    {
      espcontrol::ModalCallbackDispatchScope callback;
      media_control_toggle_speaker(ui.active, row, true);
    }
    auto current_response = group_calls.back().callback;
    auto* responding = ui.active;
    during_response = [&]() {
      runtime.dismiss(PageModalClose::TAKEOVER);
      runtime.loop();
      assert(runtime.memory().retired_contexts == 1 && ui.active == responding &&
             row->entity_id == "media_player.other");
    };
    current_response({true});
    during_response = {};
    runtime.loop();
    assert(!ui.active);
    open();
    // Configuration publication retires the old panel inside a numeric preview.
    press(ui.volume_tab);
    auto* retired = ui.active;
    during_preview = [&]() {
      assert(media.prepare(next.store) && state.prepare(next.store) && runtime.prepare(next.store));
      runtime.activate_prepared(next.store);
      media.activate_prepared(next.store);
      state.activate_prepared(next.store);
      std::memset(fixture.storage.data(), 0xA5, fixture.storage.size());
      runtime.loop();
      assert(runtime.memory().retired_contexts == 1 && retired->entity_id == "media_player.room" &&
             !media_control_context_current(retired));
    };
    press(ui.volume_plus_btn);
    during_preview = {};
    runtime.loop();
    assert(!ui.active);
    values();
    for (int budget : {0, 1}) {
      arena.remaining = budget;
      assert(runtime.request_card({18, 0}));
      runtime.loop();
      arena.remaining = -1;
      assert(!ui.active);
    }
    styles = false;
    assert(runtime.request_card({18, 0}));
    runtime.loop();
    styles = true;
    assert(!ui.active);
    enough_heap = false;
    assert(runtime.request_card({18, 0}));
    runtime.loop();
    enough_heap = true;
    assert(!ui.active);
    open(18);
    auto* button = ui.play_btn;
    lv_obj_send_event(button, LV_EVENT_PRESSED, nullptr);
    sent = sends;
    t.connected = false;
    coordinator.invalidate_retained_state();
    lv_obj_send_event(button, LV_EVENT_RELEASED, nullptr);
    lv_obj_send_event(button, LV_EVENT_CLICKED, nullptr);
    runtime.loop();
    assert(!ui.active && sends == sent);
    t.connected = true;
    values();
    // A row budget is checked before any LVGL construction, without truncation.
    std::string oversized = "v2|[";
    for (int n = 0; n < 25; ++n) {
      if (n) oversized += ",";
      oversized += "[\"media_player.member_" + std::to_string(n) + "\",\"Name, with [brackets]\",0.3,true]";
    }
    oversized += "]";
    t.send("sensor.speaker_group", "data", oversized);
    const auto admission_calls = lv_allocation_calls;
    assert(runtime.request_card({18, 0}));
    runtime.loop();
    assert(!ui.active && lv_allocation_calls == admission_calls);
    values();
    t.send("sensor.speaker_group", "data", std::string(20000, 'x'));
    const auto exhausted_calls = lv_allocation_calls;
    assert(runtime.request_card({18, 0}));
    runtime.loop();
    assert(!ui.active && lv_allocation_calls == exhausted_calls);
    values();
    // A cover panel follows the same shared source route as its original card.
    assert(media.prepare(cover.store) && state.prepare(cover.store) && runtime.prepare(cover.store));
    runtime.activate_prepared(cover.store);
    media.activate_prepared(cover.store);
    state.activate_prepared(cover.store);
    values();
    t.send("media_player.room", "", "playing");
    t.send("media_player.room", "source", "TV");
    t.send("media_player.other", "", "playing");
    t.send("media_player.other", "media_title", "Other title");
    open(19);
    assert(ui.active->entity_id == "media_player.other");
    press(ui.play_btn);
    assert(last_entity == "media_player.other");
    t.send("sensor.speaker_group", "data",
           "v2|[[\"media_player.room\",\"Room\",0.42,true],[\"media_player.other\",\"Other\",0.3,true],["
           "\"media_player.third\",\"Third\",0.2,true]]");
    runtime.loop();
    press(ui.speakers_tab);
    auto* third = media_control_find_speaker_row("media_player.third");
    assert(third);
    {
      espcontrol::ModalCallbackDispatchScope callback;
      media_control_toggle_speaker(ui.active, third, true);
    }
    auto prior_source_response = group_calls.back().callback;
    auto* prior_source_tab = ui.controls_tab;
    t.send("media_player.room", "", "playing");
    t.send("media_player.room", "source", "Spotify");
    t.send("media_player.room", "media_content_id", "new");
    t.send("media_player.room", "media_title", "Main &amp; title");
    sent = sends;
    press(prior_source_tab);
    assert(sends == sent && ui.tab == MediaControlTab::SPEAKERS && third->pending);
    prior_source_response({true});
    assert(!media_control_group_contains(ui.active, "media_player.third"));
    runtime.loop();
    prior_source_response({true});
    assert(!media_control_group_contains(ui.active, "media_player.third"));
    assert(ui.active->entity_id == "media_player.room" && ui.active->title == "Main & title");
    close();
    assert(media.prepare(speaker.store) && state.prepare(speaker.store) && runtime.prepare(speaker.store));
    runtime.activate_prepared(speaker.store);
    media.activate_prepared(speaker.store);
    state.activate_prepared(speaker.store);
    values();
    open(20);
    assert(ui.active->group_only && ui.tab == MediaControlTab::SPEAKERS && !ui.tab_row &&
           ui.speaker_rows.size() == 2);
    close();
    group_calls.clear();
    runtime.retire_active();
    runtime.loop();
    state.retire_active();
    media.retire_active();
  }
  after_destroy({true});
  coordinator.reclaim_unused_channels();
  assert(arena.live.empty() && coordinator.transport().bindings.empty());
}
void test_numeric_inputs() {
  auto legacy = media_group_parse_discovery_items("room|Room|1e38");
  assert(legacy.size() == 1 && legacy[0].volume_pct == 100);
  auto unknown = media_group_parse_discovery_items("room|Room|nan");
  assert(unknown.size() == 1 && !unknown[0].volume_known);
  auto v2 = media_group_parse_discovery_items("v2|[[\"media_player.room\",\"Room\",1e38,true]]");
  assert(v2.size() == 1 && v2[0].volume_pct == 100);
  char time[32];
  media_format_time(1e38f, time, sizeof(time));
  assert(std::strcmp(time, "--:--") == 0);
}
int main() {
  test_numeric_inputs();
  lv_init();
  auto* display = lv_display_create(480, 480);
  lv_timer_pause(lv_display_get_refr_timer(display));
  test_panels();
  lv_display_delete(display);
  lv_deinit();
  assert(lv_live_bytes == 0);
}
