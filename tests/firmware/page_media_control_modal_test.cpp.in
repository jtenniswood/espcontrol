void media_control_create_speakers_tab_content(MediaControlCtx* ctx) {
  auto& ui = media_control_modal_ui();
  if (ui.speakers_box) return;
  ui.speakers_box = ui.content_box;
  ui.speaker_list = lv_obj_create(ui.content_box);
  for (const auto& entity :
       media_group_merge_candidates(ctx->entity_id, ctx->speaker_helper_members, ctx->group_members)) {
    auto* row = new MediaSpeakerRowState();
    row->entity_id = entity;
    row->row = lv_button_create(ui.speaker_list);
    row->available = true;
    row->volume_known = true;
    row->volume_pct = 30;
    row->volume_plus_btn = media_control_create_speaker_volume_button(ctx, row, row->row, 46, "+", true);
    row->volume_minus_btn = media_control_create_speaker_volume_button(ctx, row, row->row, 46, "-", false);
    ui.speaker_rows.push_back(row);
  }
  ui.speaker_action_timer = lv_timer_create(media_control_speaker_action_timer_cb, 500, nullptr);
}
void media_control_refresh_speakers(MediaControlCtx* ctx) {
  for (auto* row : media_control_modal_ui().speaker_rows) media_control_copy_group_volume_to_row(ctx, row);
}
// @production-function media_control_ensure_tab_content
void media_control_layout_modal(MediaControlCtx* ctx) {
  auto& ui = media_control_modal_ui();
  if (!ctx || ui.active != ctx) return;
  if (!media_control_ensure_progress_tab_button(ctx) || !media_control_ensure_speakers_tab_button(ctx) ||
      !media_control_ensure_power_tab_button(ctx))
    return;
  media_control_ensure_tab_content(ctx);
  ui.visible_tabs = media_control_visible_tabs(ctx);
  ui.progress_layout_ready = true;
  media_control_refresh_modal(ctx);
  if (!media_control_widgets_ready(ui.overlay)) media_control_hide_modal();
}
