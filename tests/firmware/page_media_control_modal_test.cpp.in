using ActionResponseCallback = std::function<void(const esphome::api::ActionResponse&)>;
struct GroupCall {
  uint32_t id;
  ActionResponseCallback callback;
};
std::vector<GroupCall> group_calls;
uint32_t next_call = 100;
size_t sends = 0, previews = 0;
std::string last_action, last_entity;
int last_value = 0;
PageModalToken preview_token{};
std::function<void()> during_send, during_preview, during_response;
void send(const std::string& entity, const std::string& action, int value = 0) {
  ++sends;
  last_entity = entity;
  last_action = action;
  last_value = value;
  if (during_send) during_send();
}
void send_media_player_action(const std::string& entity, const std::string& action) {
  send(entity, action);
}
void send_media_playback_action(const std::string& entity, const std::string& action) {
  send(entity, action);
}
void send_media_shuffle_action(const std::string& entity, bool enabled) {
  send(entity, "shuffle", enabled);
}
void send_media_repeat_action(const std::string& entity, media::RepeatMode mode) {
  send(entity, "repeat", static_cast<int>(mode));
}
void send_media_seek_action(const std::string& entity, int percent, float) {
  send(entity, "seek", percent);
}
void send_media_volume_action(const std::string& entity, int value) {
  send(entity, "volume", value);
}
void send_media_volume_command(const std::string& entity, media::VolumeCommand command) {
  if (command.kind != media::VolumeCommandKind::NONE) send(entity, "volume-command", command.value);
}
bool send_media_group_join_action(const std::string& entity, const std::vector<std::string>&,
                                  ActionResponseCallback callback, uint32_t* id) {
  *id = next_call++;
  group_calls.push_back({*id, std::move(callback)});
  send(entity, "join");
  return true;
}
bool send_media_group_unjoin_action(const std::string& entity, ActionResponseCallback callback,
                                    uint32_t* id) {
  *id = next_call++;
  group_calls.push_back({*id, std::move(callback)});
  send(entity, "unjoin");
  return true;
}
void ha_cancel_action_response_callback(uint32_t id, const char*) {
  for (auto& call : group_calls)
    if (call.id == id) {
      call.id = 0;
      return;
    }
}
