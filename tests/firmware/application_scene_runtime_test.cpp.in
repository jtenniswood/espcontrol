#include "application_scene_runtime.h"
#include "configuration_main_loop.h"
using namespace espcontrol::configuration;
static std::string trace;
static std::function<void()> ha_hook;
template <class... Args>
void log_sink(Args&&...) {}
#define ESP_LOGE(...) log_sink(__VA_ARGS__)
namespace esphome::artwork_image {
struct TransferObserver {
  static TransferObserver& instance() {
    static TransferObserver value;
    return value;
  }
  void set(std::function<uint32_t(const std::string&)>, std::function<void(int)>) { trace += 'F'; }
};
}  // namespace esphome::artwork_image
namespace espcontrol {
static constexpr const char* TAG = "test";
namespace ha {
void maintain_subscriptions() {
  trace += 'H';
  if (ha_hook) ha_hook();
}
}  // namespace ha
namespace cards {
void set_card_runtime_registry_service(std::nullptr_t) { trace += 'K'; }
}  // namespace cards
struct Core {
  ConfigurationService* service{nullptr};
  ConfigurationService* configuration_service() { return service; }
  void run_once() { trace += 'C'; }
  void stop() { trace += 'S'; }
};
struct Endpoint {
  void loop() { trace += 'E'; }
};
struct LegacyRuntime : ConfigurationRuntimeAdapter {
  size_t applies{0};
  bool apply(uint16_t, const uint8_t*, size_t) override {
    ++applies;
    return true;
  }
};
struct Transactions {
  ConfigurationMainLoop queue;
  void process(ConfigurationService& service) {
    trace += 'T';
    queue.process(service);
  }
  void stop() {
    trace += 'Q';
    queue.stop();
  }
};
struct NativeRuntime {
  LegacyRuntime runtime_config;
  Transactions transactions;
  std::array<uint8_t, 512> bytes{};
  uint8_t* boot_buffer{bytes.data()};
  size_t slot_capacity{bytes.size()};
  bool boot_configuration_pending{true}, boot_configuration_due{false};
};
// Only ESPHome/device storage is doubled. Bodies below are copied unchanged
// from the production app and call the real durable service/main-loop queue.
class EspControlApp {
 public:
  using NativeConfigurationRuntime = NativeRuntime;
  Core core_;
  Endpoint home_assistant_endpoint_;
  std::unique_ptr<NativeRuntime> native_configuration_runtime_;
  ApplicationSceneRuntime* application_scene_{nullptr};
  bool shutting_down_{false}, native_configuration_initialized_{false};
  bool install_application_scene(ApplicationSceneRuntime&);
  ConfigurationRuntimeAdapter* selected_configuration_runtime();
  void apply_boot_configuration();
  void loop();
  void on_shutdown();
  void register_panel_config_endpoints() { trace += 'R'; }
};
// @production-app-method install_application_scene
// @production-app-method selected_configuration_runtime
// @production-app-method apply_boot_configuration
// @production-app-method loop
// @production-app-method on_shutdown
}  // namespace espcontrol
using namespace espcontrol;
class MemoryBackend final : public StorageBackend {
 public:
  explicit MemoryBackend(size_t capacity)
      : slots_{std::vector<uint8_t>(capacity, 0xFF), std::vector<uint8_t>(capacity, 0xFF)} {}

  size_t slot_capacity() const override { return slots_[0].size(); }
  bool read(uint8_t slot, size_t offset, uint8_t* output, size_t size) override {
    if (slot >= slots_.size() || offset > slots_[slot].size() || size > slots_[slot].size() - offset) {
      return false;
    }
    if (size > 0) std::memcpy(output, slots_[slot].data() + offset, size);
    return true;
  }
  bool write(uint8_t slot, size_t offset, const uint8_t* data, size_t size) override {
    if (fail_writes_ || slot >= slots_.size() || offset > slots_[slot].size() ||
        size > slots_[slot].size() - offset) {
      return false;
    }
    if (size > 0) std::memcpy(slots_[slot].data() + offset, data, size);
    return true;
  }
  bool sync() override { return true; }
  void fail_writes(bool value) { fail_writes_ = value; }

 private:
  std::array<std::vector<uint8_t>, CONFIGURATION_SLOT_COUNT> slots_;
  bool fail_writes_{false};
};

class FakeLegacy final : public LegacyConfigurationAdapter {
 public:
  LegacyLoadResult load(uint8_t* output, size_t output_capacity) override {
    ++load_calls;
    if (read_failed) return {LegacyStatus::READ_FAILED, version, value.size()};
    if (value.empty()) return {LegacyStatus::EMPTY, version, 0};
    if (value.size() > output_capacity) {
      return {LegacyStatus::BUFFER_TOO_SMALL, version, value.size()};
    }
    std::copy(value.begin(), value.end(), output);
    return {LegacyStatus::OK, version, value.size()};
  }

  bool mirror(uint16_t document_version, const uint8_t* document, size_t document_size) override {
    ++mirror_calls;
    mirrored_version = document_version;
    mirrored.assign(document, document + document_size);
    return !mirror_failed;
  }

  std::vector<uint8_t> value;
  std::vector<uint8_t> mirrored;
  uint16_t version{CURRENT_CONFIGURATION_DOCUMENT_VERSION};
  uint16_t mirrored_version{0};
  size_t load_calls{0};
  size_t mirror_calls{0};
  bool read_failed{false};
  bool mirror_failed{false};
};

struct Scene : ApplicationSceneRuntime {
  bool initialized{true}, busy{false}, prepare_ok{true};
  size_t loops{0}, stops{0}, prepares{0}, activates{0};
  uint32_t generation{0};
  std::vector<uint8_t> current;
  bool ready() const override { return initialized; }
  bool maintenance_ready() const override { return initialized && !busy; }
  bool prepare(uint16_t, const uint8_t*, size_t) override {
    ++prepares;
    trace += 'P';
    return prepare_ok;
  }
  void discard_prepared() override {}
  bool activate_prepared(uint32_t g, uint16_t, const uint8_t* data, size_t size) override {
    ++activates;
    generation = g;
    current.assign(data, data + size);
    trace += 'A';
    return true;
  }
  bool apply(uint16_t, const uint8_t*, size_t) override {
    assert(false);
    return false;
  }
  void loop() override {
    assert(maintenance_ready());
    ++loops;
    trace += 'M';
  }
  void stop() override {
    ++stops;
    initialized = false;
    trace += 'X';
  }
};
struct Harness {
  MemoryBackend backend{1024};
  ConfigurationStore store{backend};
  FakeLegacy legacy;
  std::array<uint8_t, 1024> scratch{};
  ConfigurationService service{store, legacy, nullptr, scratch.data(), scratch.size()};
  Scene scene, other;
  EspControlApp app;
  uint32_t initial_generation{0};
  Harness() {
    legacy.value = {1, 2, 3};
    std::array<uint8_t, 512> output{};
    auto loaded = service.load(output.data(), output.size());
    assert(loaded.ok());
    initial_generation = loaded.generation;
    app.native_configuration_runtime_ = std::make_unique<NativeRuntime>();
  }
  void configure() {
    assert(app.install_application_scene(scene));
    app.core_.service = &service;
    service.set_runtime_adapter(app.selected_configuration_runtime());
    app.native_configuration_initialized_ = true;
  }
};
void registration() {
  Harness h;
  h.other.initialized = false;
  assert(!h.app.install_application_scene(h.other) && !h.app.application_scene_);
  h.other.initialized = true;
  assert(h.app.selected_configuration_runtime() == &h.app.native_configuration_runtime_->runtime_config);
  h.configure();
  assert(h.app.selected_configuration_runtime() == &h.scene && h.app.install_application_scene(h.scene));
  assert(!h.app.install_application_scene(h.other));
  EspControlApp late;
  late.native_configuration_initialized_ = true;
  assert(!late.install_application_scene(h.other));
  late.native_configuration_initialized_ = false;
  late.core_.service = &h.service;
  assert(!late.install_application_scene(h.other));
}
void boot_and_transactions() {
  Harness h;
  h.configure();
  auto& native = *h.app.native_configuration_runtime_;
  trace.clear();
  h.app.loop();
  assert(trace == "TECHRM" && h.scene.prepares == 0 && native.boot_configuration_pending);
  // A queued browser save stays on the HTTP thread until safe main-loop dispatch.
  h.scene.busy = true;
  const std::array<uint8_t, 3> latest = {7, 8, 9};
  auto writer = std::async(std::launch::async, [&] {
    return native.transactions.queue.save_if_generation(
        h.initial_generation, CURRENT_CONFIGURATION_DOCUMENT_VERSION, latest.data(), latest.size());
  });
  const auto deadline = std::chrono::steady_clock::now() + std::chrono::seconds(2);
  while (!native.transactions.queue.pending() && std::chrono::steady_clock::now() < deadline)
    std::this_thread::yield();
  assert(native.transactions.queue.pending());
  trace.clear();
  h.app.loop();
  assert(trace == "ECHR" && h.scene.prepares == 0 && native.transactions.queue.pending());
  // A due boot callback cannot publish inside producer/native/LVGL dispatch.
  h.app.apply_boot_configuration();
  assert(native.boot_configuration_due && native.boot_configuration_pending && h.scene.activates == 0);
  h.scene.busy = false;
  trace.clear();
  h.app.loop();
  const auto saved = writer.get();
  assert(saved.dispatch == ConfigurationDispatchStatus::COMPLETED && saved.result.ok());
  assert(h.scene.current == std::vector<uint8_t>(latest.begin(), latest.end()));
  assert(h.scene.activates == 2 && h.scene.generation == saved.result.generation);
  assert(!native.boot_configuration_pending && !native.boot_configuration_due);
  assert(trace == "TPAPAECHRM");  // Reload newest durable document, never the original boot value.
  const auto applies = h.scene.activates;
  h.app.loop();
  assert(h.scene.activates == applies);
  // Busy state may change while HA maintenance runs; the UI readiness is queried again.
  const auto loops = h.scene.loops;
  ha_hook = [&] { h.scene.busy = true; };
  h.app.loop();
  assert(h.scene.activates == applies && h.scene.loops == loops);
  ha_hook = {};
  h.scene.busy = false;
  h.scene.prepare_ok = false;
  native.boot_configuration_pending = true;
  h.app.apply_boot_configuration();
  assert(h.scene.activates == applies && !native.boot_configuration_pending);
}
void legacy_path() {
  Harness h;
  h.app.core_.service = &h.service;
  h.service.set_runtime_adapter(h.app.selected_configuration_runtime());
  auto& native = *h.app.native_configuration_runtime_;
  trace.clear();
  h.app.loop();
  assert(trace == "TECHR" && native.runtime_config.applies == 0 && native.boot_configuration_pending);
  h.app.apply_boot_configuration();
  assert(native.runtime_config.applies == 1 && !native.boot_configuration_pending);
  h.app.loop();
  assert(native.runtime_config.applies == 1 && h.scene.activates == 0);
}
void shutdown() {
  Harness h;
  h.configure();
  h.scene.busy = true;
  auto& queue = h.app.native_configuration_runtime_->transactions.queue;
  std::array<uint8_t, 32> output{};
  auto reader = std::async(std::launch::async, [&] { return queue.load(output.data(), output.size()); });
  const auto deadline = std::chrono::steady_clock::now() + std::chrono::seconds(2);
  while (!queue.pending() && std::chrono::steady_clock::now() < deadline) std::this_thread::yield();
  assert(queue.pending());
  trace.clear();
  h.app.on_shutdown();
  assert(reader.get().dispatch == ConfigurationDispatchStatus::STOPPED);
  assert(trace == "QXFKS" && h.scene.stops == 1);
  trace.clear();
  h.app.on_shutdown();
  h.app.loop();
  h.app.apply_boot_configuration();
  assert(trace.empty() && h.scene.stops == 1 && !h.app.install_application_scene(h.other));
}
int main() {
  registration();
  legacy_path();
  boot_and_transactions();
  shutdown();
  for (int i = 0; i < 1000; ++i) {
    Harness h;
    h.configure();
    h.scene.busy = true;
    h.app.apply_boot_configuration();
    assert(h.scene.activates == 0);
    h.scene.busy = false;
    h.app.loop();
    assert(h.scene.activates == 1);
    h.app.on_shutdown();
  }
}
