using namespace espcontrol;
class MemoryBackend final : public StorageBackend {
 public:
  explicit MemoryBackend(size_t capacity)
      : slots_{std::vector<uint8_t>(capacity, 0xFF), std::vector<uint8_t>(capacity, 0xFF)} {}

  size_t slot_capacity() const override { return slots_[0].size(); }
  bool read(uint8_t slot, size_t offset, uint8_t* output, size_t size) override {
    if (slot >= slots_.size() || offset > slots_[slot].size() || size > slots_[slot].size() - offset) {
      return false;
    }
    if (size > 0) std::memcpy(output, slots_[slot].data() + offset, size);
    return true;
  }
  bool write(uint8_t slot, size_t offset, const uint8_t* data, size_t size) override {
    if (fail_writes_ || slot >= slots_.size() || offset > slots_[slot].size() ||
        size > slots_[slot].size() - offset) {
      return false;
    }
    if (size > 0) std::memcpy(slots_[slot].data() + offset, data, size);
    return true;
  }
  bool sync() override { return true; }
  bool begin_operation() override { return !memory_unavailable; }
  StoreStatus operation_failure() const override { return StoreStatus::ALLOCATION_FAILED; }
  bool memory_unavailable{false};
  void fail_writes(bool value) { fail_writes_ = value; }

 private:
  std::array<std::vector<uint8_t>, CONFIGURATION_SLOT_COUNT> slots_;
  bool fail_writes_{false};
};

class FakeLegacy final : public LegacyConfigurationAdapter {
 public:
  LegacyLoadResult load(uint8_t* output, size_t output_capacity) override {
    ++load_calls;
    if (read_failed) return {LegacyStatus::READ_FAILED, version, value.size()};
    if (value.empty()) return {LegacyStatus::EMPTY, version, 0};
    if (value.size() > output_capacity) {
      return {LegacyStatus::BUFFER_TOO_SMALL, version, value.size()};
    }
    std::copy(value.begin(), value.end(), output);
    return {LegacyStatus::OK, version, value.size()};
  }

  LegacyLoadResult merge(uint16_t document_version, const uint8_t* native, size_t size,
      uint8_t* output, size_t capacity, bool* changed) override {
    if(read_failed || version!=document_version) return {LegacyStatus::READ_FAILED,version,0};
    if(value.size()>capacity) return {LegacyStatus::BUFFER_TOO_SMALL,version,value.size()};
    *changed=value.size()!=size || (size && std::memcmp(value.data(),native,size)!=0);
    std::copy(value.begin(),value.end(),output);
    return {LegacyStatus::OK,version,value.size()};
  }

  bool publish(uint16_t, const uint8_t*, size_t) override {
    ++publish_calls;
    return !publish_failed;
  }

  bool mirror(uint16_t document_version, const uint8_t* document, size_t document_size) override {
    ++mirror_calls;
    mirrored_version = document_version;
    mirrored.assign(document, document + document_size);
    return !mirror_failed;
  }

  std::vector<uint8_t> value;
  std::vector<uint8_t> mirrored;
  uint16_t version{CURRENT_CONFIGURATION_DOCUMENT_VERSION};
  uint16_t mirrored_version{0};
  size_t load_calls{0}, publish_calls{0};
  bool publish_failed{false};
  size_t mirror_calls{0};
  bool read_failed{false};
  bool mirror_failed{false};
};

struct Scene : ApplicationSceneRuntime {
  bool initialized{true}, busy{false}, prepare_ok{true};
  size_t loops{0}, stops{0}, prepares{0}, activates{0};
  uint32_t generation{0};
  std::vector<uint8_t> current;
  bool ready() const override { return initialized; }
  bool maintenance_ready() const override { return initialized && !busy; }
  bool prepare(uint16_t, const uint8_t*, size_t) override {
    ++prepares;
    trace += 'P';
    return prepare_ok;
  }
  void discard_prepared() override {}
  bool activate_prepared(uint32_t g, uint16_t, const uint8_t* data, size_t size) override {
    ++activates;
    generation = g;
    current.assign(data, data + size);
    trace += 'A';
    return true;
  }
  bool apply(uint16_t, const uint8_t*, size_t) override {
    assert(false);
    return false;
  }
  void loop() override {
    assert(maintenance_ready());
    ++loops;
    trace += 'M';
  }
  void stop() override {
    ++stops;
    initialized = false;
    trace += 'X';
  }
};
struct Harness {
  MemoryBackend backend{1024};
  ConfigurationStore store{backend};
  FakeLegacy legacy;
  ConfigurationService service{store, legacy};
  Scene scene, other;
  EspControlApp app;
  uint32_t initial_generation{0};
  Harness() {
    ConfigAllocations::reset(); fake_time_ms = 0;
    service.set_buffer_allocator(allocate_configuration_slot, release_configuration_slot);
    app.core_.available = &service;
    legacy.value = {1, 2, 3};
    std::array<uint8_t, 512> output{};
    auto loaded = service.load(output.data(), output.size());
    assert(loaded.ok());
    initial_generation = loaded.generation;
    app.native_configuration_runtime_ = std::make_unique<NativeRuntime>();
  }
  void configure() {
    assert(app.install_application_scene(scene));
    app.core_.service = &service;
    service.set_runtime_adapter(app.selected_configuration_runtime());
    app.native_configuration_initialized_ = true;
  }
};
void registration() {
  Harness h;
  h.other.initialized = false;
  assert(!h.app.install_application_scene(h.other) && !h.app.application_scene_);
  h.other.initialized = true;
  assert(h.app.selected_configuration_runtime() == &h.app.native_configuration_runtime_->runtime_config);
  h.configure();
  assert(h.app.selected_configuration_runtime() == &h.scene && h.app.install_application_scene(h.scene));
  assert(!h.app.install_application_scene(h.other));
  EspControlApp late;
  late.native_configuration_initialized_ = true;
  assert(!late.install_application_scene(h.other));
  late.native_configuration_initialized_ = false;
  late.core_.service = &h.service;
  assert(!late.install_application_scene(h.other));
}
void required_scene_failure() {
  Harness h;
  assert(h.app.require_application_scene() && h.app.require_application_scene());
  auto* unavailable=h.app.selected_configuration_runtime();
  assert(unavailable && unavailable!=&h.app.native_configuration_runtime_->runtime_config);
  h.service.set_runtime_adapter(unavailable);
  const std::array<uint8_t,3> next={4,5,6};
  const auto saved=h.service.save_if_generation(h.initial_generation,CURRENT_CONFIGURATION_DOCUMENT_VERSION,
      next.data(),next.size());
  assert(saved.status==ServiceStatus::RUNTIME_PREPARE_FAILED &&
      h.app.native_configuration_runtime_->runtime_config.applies==0);
  std::array<uint8_t,512> loaded{};
  const auto before=h.service.load(loaded.data(),loaded.size());
  assert(before.ok() && before.generation==h.initial_generation && before.document_size==3 &&
      loaded[0]==1 && loaded[1]==2 && loaded[2]==3);
  // Successful startup can still install before the configuration service is
  // configured; declaring the native requirement does not consume that slot.
  h.configure();assert(h.app.selected_configuration_runtime()==&h.scene);
  assert(!h.app.require_application_scene());
  EspControlApp stopped;stopped.shutting_down_=true;
  assert(!stopped.require_application_scene());
}
void boot_and_transactions() {
  Harness h;
  h.configure();
  auto& native = *h.app.native_configuration_runtime_;
  trace.clear();
  h.app.loop();
  assert(trace == "TECHRM" && h.scene.prepares == 0 && native.boot_configuration_pending);
  // A queued browser save stays on the HTTP thread until safe main-loop dispatch.
  h.scene.busy = true;
  const std::array<uint8_t, 3> latest = {7, 8, 9};
  auto writer = std::async(std::launch::async, [&] {
    return native.transactions.queue.save_if_generation(
        h.initial_generation, CURRENT_CONFIGURATION_DOCUMENT_VERSION, latest.data(), latest.size());
  });
  const auto deadline = std::chrono::steady_clock::now() + std::chrono::seconds(2);
  while (!native.transactions.queue.pending() && std::chrono::steady_clock::now() < deadline)
    std::this_thread::yield();
  assert(native.transactions.queue.pending());
  trace.clear();
  h.app.loop();
  assert(trace == "ECHR" && h.scene.prepares == 0 && native.transactions.queue.pending());
  // A due boot callback cannot publish inside producer/native/LVGL dispatch.
  h.app.apply_boot_configuration();
  assert(native.boot_configuration_due && native.boot_configuration_pending && h.scene.activates == 0);
  h.scene.busy = false;
  trace.clear();
  h.app.loop();
  const auto saved = writer.get();
  assert(saved.dispatch == ConfigurationDispatchStatus::COMPLETED && saved.result.ok());
  assert(h.scene.current == std::vector<uint8_t>(latest.begin(), latest.end()));
  assert(h.scene.activates == 2 && h.scene.generation == saved.result.generation);
  assert(!native.boot_configuration_pending && !native.boot_configuration_due);
  assert(trace == "TPAPAECHRM");  // Reload newest durable document, never the original boot value.
  const auto applies = h.scene.activates;
  h.app.loop();
  assert(h.scene.activates == applies);
  // Busy state may change while HA maintenance runs; the UI readiness is queried again.
  const auto loops = h.scene.loops;
  ha_hook = [&] { h.scene.busy = true; };
  h.app.loop();
  assert(h.scene.activates == applies && h.scene.loops == loops);
  ha_hook = {};
  h.scene.busy = false;
  h.scene.prepare_ok = false;
  native.boot_configuration_pending = true;
  h.app.apply_boot_configuration();
  assert(h.scene.activates == applies && !native.boot_configuration_pending);
}
void legacy_path() {
  Harness h;
  h.app.core_.service = &h.service;
  h.service.set_runtime_adapter(h.app.selected_configuration_runtime());
  auto& native = *h.app.native_configuration_runtime_;
  trace.clear();
  h.app.loop();
  assert(trace == "TECHR" && native.runtime_config.applies == 0 && native.boot_configuration_pending);
  h.app.apply_boot_configuration();
  assert(native.runtime_config.applies == 1 && !native.boot_configuration_pending);
  h.app.loop();
  assert(native.runtime_config.applies == 1 && h.scene.activates == 0);
}
void compatibility_refresh_and_publication() {
  Harness h;h.configure();
  auto& native=*h.app.native_configuration_runtime_;
  h.app.configuration_text_refresh_pending_=true;
  // A busy scene or startup restore must defer compatibility edits.
  h.scene.busy=true;h.app.apply_configuration_text_refresh();
  assert(h.app.configuration_text_refresh_pending_ && !native.runtime_config.applies);
  h.scene.busy=false;h.app.apply_configuration_text_refresh();
  assert(h.app.configuration_text_refresh_pending_);
  h.app.apply_boot_configuration();
  assert(native.runtime_config.applies==0 && h.legacy.publish_calls==1 && h.scene.activates==1);
  h.app.apply_configuration_text_refresh();
  assert(!h.app.configuration_text_refresh_pending_ && native.runtime_config.applies==0 && h.legacy.publish_calls==1 && h.scene.activates==1);
  h.legacy.value={4,5,6};h.legacy.mirror_failed=true;
  h.app.configuration_text_refresh_pending_=true;
  h.app.apply_configuration_text_refresh();
  assert(h.scene.current==h.legacy.value && h.scene.activates==2 && native.runtime_config.applies==0 && h.legacy.publish_calls==2);
  // Boot must keep the activated native document when compatibility text
  // publication is unavailable, without attempting the old text runtime.
  native.boot_configuration_pending=true;h.legacy.publish_failed=true;
  h.app.apply_boot_configuration();
  assert(!native.boot_configuration_pending && h.scene.activates==3 &&
      native.runtime_config.applies==0 && h.legacy.publish_calls==3);
  h.app.configuration_text_refresh_pending_=true;h.legacy.value={7,8,9};
  h.app.apply_configuration_text_refresh();
  assert(h.scene.current[0]==4 && h.scene.activates==3 && h.legacy.publish_calls==3);
  h.legacy.publish_failed=false;native.boot_configuration_pending=true;
  h.app.apply_boot_configuration();
  assert(h.scene.current[0]==4 && h.legacy.publish_calls==4);
  // Failed runtime preparation never publishes candidate text or durable data.
  h.scene.prepare_ok=false;h.legacy.value={7,8,9};
  h.app.configuration_text_refresh_pending_=true;h.app.apply_configuration_text_refresh();
  assert(h.scene.current[0]==4 && native.runtime_config.applies==0 && h.legacy.publish_calls==4);
}

void buffer_retry_clock_wrap() {
  ConfigurationBufferRetry retry;
  assert(retry.ready(0)); retry.failed(UINT32_MAX - 500);
  assert(!retry.ready(498) && retry.ready(499));
  retry.clear(); assert(retry.ready(0));
}

void boot_output_is_scoped_and_retry_preserves_latest() {
  for (size_t failed_buffer : {size_t(1), size_t(2)}) {
    Harness h; h.configure();
    auto& native = *h.app.native_configuration_runtime_;
    ConfigAllocations::fail_at = ConfigAllocations::calls + failed_buffer;
    h.app.apply_boot_configuration();
    assert(native.boot_configuration_pending && native.boot_configuration_due);
    assert(h.scene.activates == 0 && ConfigAllocations::live.empty());
    const auto calls = ConfigAllocations::calls;
    for (size_t i = 0; i < 20; ++i) h.app.loop();
    fake_time_ms = 999; h.app.loop();
    assert(ConfigAllocations::calls == calls && native.boot_configuration_pending);
    ConfigAllocations::fail_at = 0;
    const std::array<uint8_t, 3> newer{{9, 8, 7}};
    const auto saved = h.service.save_current(newer.data(), newer.size());
    assert(saved.ok() && h.scene.activates == 1);
    fake_time_ms = 1000; h.app.loop();
    assert(!native.boot_configuration_pending && !native.boot_configuration_due);
    assert(h.scene.activates == 2 && h.scene.generation == saved.generation);
    assert(h.scene.current == std::vector<uint8_t>(newer.begin(), newer.end()));
    assert(ConfigAllocations::live.empty() && ConfigAllocations::peak_count <= 2);
  }
}

void compatibility_output_retries_all_temporary_stages() {
  // Caller, durable-load scratch, merge scratch, then commit encoding.
  for (size_t failed_buffer : {size_t(1), size_t(2), size_t(3), size_t(4)}) {
    Harness h; h.configure(); h.app.apply_boot_configuration();
    auto& native = *h.app.native_configuration_runtime_;
    const auto original = h.scene.current;
    h.legacy.value = {4, 5, 6}; h.app.configuration_text_refresh_pending_ = true;
    ConfigAllocations::fail_at = ConfigAllocations::calls + failed_buffer;
    h.app.apply_configuration_text_refresh();
    assert(h.app.configuration_text_refresh_pending_ && h.scene.current == original);
    assert(h.scene.generation == h.initial_generation && h.legacy.mirror_calls == 0);
    assert(ConfigAllocations::live.empty());
    const auto calls = ConfigAllocations::calls;
    for (size_t i = 0; i < 20; ++i) h.app.apply_configuration_text_refresh();
    fake_time_ms = 999; h.app.apply_configuration_text_refresh();
    assert(ConfigAllocations::calls == calls);
    ConfigAllocations::fail_at = 0; fake_time_ms = 1000;
    h.app.apply_configuration_text_refresh();
    assert(!h.app.configuration_text_refresh_pending_ && !native.boot_configuration_pending);
    assert(h.scene.current == h.legacy.value && h.scene.generation == h.initial_generation + 1);
    assert(h.legacy.mirror_calls == 1 && ConfigAllocations::live.empty());
    assert(ConfigAllocations::peak_count <= 2);
  }
}

void initialization_retries_without_reopening_resources() {
  for (size_t stage : {size_t(1), size_t(2), size_t(3)}) {
    Harness h;
    assert(h.app.install_application_scene(h.scene));
    auto& native = *h.app.native_configuration_runtime_;
    native.boot_configuration_pending = false;
    if (stage == 3) h.backend.memory_unavailable = true;
    else ConfigAllocations::fail_at = ConfigAllocations::calls + stage;
    h.app.initialize_native_configuration();
    assert(!h.app.native_configuration_initialized_ && h.app.native_configuration_initialization_pending_);
    assert(!native.document_available && !native.boot_configuration_pending && h.app.timers.empty());
    assert(h.app.core_.configurations == 1 && native.blobs.opens == 1 && native.backend.starts == 1);
    assert(ConfigAllocations::live.empty());
    const auto calls = ConfigAllocations::calls;
    for (size_t i = 0; i < 20; ++i) h.app.loop();
    fake_time_ms = 999; h.app.loop();
    assert(ConfigAllocations::calls == calls && !h.app.native_configuration_initialized_);
    ConfigAllocations::fail_at = 0; h.backend.memory_unavailable = false;
    fake_time_ms = 1000; h.app.loop();
    assert(h.app.native_configuration_initialized_ && !h.app.native_configuration_initialization_pending_);
    assert(native.document_available && native.boot_configuration_pending && h.app.timers.size() == 1);
    assert(h.app.core_.configurations == 1 && native.blobs.opens == 1 && native.backend.starts == 1);
    assert(ConfigAllocations::live.empty());
    h.app.initialize_native_configuration();
    assert(h.app.timers.size() == 1 && h.app.core_.configurations == 1 && native.blobs.opens == 1);
    fake_time_ms = 2000; h.app.run_timeouts();
    assert(!native.boot_configuration_pending && h.scene.generation == h.initial_generation);
    assert(h.scene.current == h.legacy.value && ConfigAllocations::live.empty());
  }
}

void runtime_creation_retries_without_a_timer_allocation() {
  Harness h;
  assert(h.app.install_application_scene(h.scene));
  h.app.native_configuration_runtime_->boot_configuration_pending = false;
  h.app.delayed_runtime = std::move(h.app.native_configuration_runtime_);
  h.app.runtime_creation_fails = true;
  h.app.initialize_native_configuration();
  assert(!h.app.native_configuration_initialized_ && h.app.native_configuration_initialization_pending_);
  assert(h.app.core_.configurations == 0 && h.app.timers.empty());
  h.app.runtime_creation_fails = false; fake_time_ms = 1000; h.app.loop();
  assert(h.app.native_configuration_initialized_ && h.app.native_configuration_runtime_);
  assert(h.app.core_.configurations == 1 && h.app.timers.size() == 1 && ConfigAllocations::live.empty());
}

void genuine_store_failure_is_not_a_memory_retry() {
  Harness h; h.configure(); h.app.apply_boot_configuration();
  const auto original = h.scene.current;
  h.legacy.value = {6, 5, 4}; h.backend.fail_writes(true);
  h.app.configuration_text_refresh_pending_ = true;
  h.app.apply_configuration_text_refresh();
  assert(!h.app.configuration_text_refresh_pending_ && h.scene.current == original);
  assert(h.scene.generation == h.initial_generation && h.legacy.mirror_calls == 0);
  const auto calls = ConfigAllocations::calls;
  h.backend.fail_writes(false); fake_time_ms = 1000; h.app.loop();
  assert(ConfigAllocations::calls == calls && ConfigAllocations::live.empty());
}

void shutdown() {
  Harness h;
  h.configure();
  h.scene.busy = true;
  auto& queue = h.app.native_configuration_runtime_->transactions.queue;
  std::array<uint8_t, 32> output{};
  auto reader = std::async(std::launch::async, [&] { return queue.load(output.data(), output.size()); });
  const auto deadline = std::chrono::steady_clock::now() + std::chrono::seconds(2);
  while (!queue.pending() && std::chrono::steady_clock::now() < deadline) std::this_thread::yield();
  assert(queue.pending());
  trace.clear();
  h.app.on_shutdown();
  assert(reader.get().dispatch == ConfigurationDispatchStatus::STOPPED);
  assert(trace == "QXFKS" && h.scene.stops == 1);
  trace.clear();
  h.app.on_shutdown();
  h.app.loop();
  h.app.apply_boot_configuration();
  assert(trace.empty() && h.scene.stops == 1 && !h.app.install_application_scene(h.other));
}
int main() {
  buffer_retry_clock_wrap();
  boot_output_is_scoped_and_retry_preserves_latest();
  compatibility_output_retries_all_temporary_stages();
  initialization_retries_without_reopening_resources();
  runtime_creation_retries_without_a_timer_allocation();
  genuine_store_failure_is_not_a_memory_retry();
  required_scene_failure();
  compatibility_refresh_and_publication();
  registration();
  legacy_path();
  boot_and_transactions();
  shutdown();
  for (int i = 0; i < 1000; ++i) {
    Harness h;
    h.configure();
    h.scene.busy = true;
    h.app.apply_boot_configuration();
    assert(h.scene.activates == 0);
    h.scene.busy = false;
    h.app.loop();
    assert(h.scene.activates == 1);
    h.app.on_shutdown();
  }
}
