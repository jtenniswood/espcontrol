static std::string trace;
static uint32_t fake_time_ms = 0;
struct ConfigAllocations {
  static inline std::unordered_map<uint8_t *, size_t> live;
  static inline size_t calls = 0, fail_at = 0, peak_count = 0;
  static void reset() { assert(live.empty()); calls = fail_at = peak_count = 0; }
};
namespace esphome { uint32_t millis() { return fake_time_ms; } }

static std::function<void()> ha_hook;
template <class... Args>
void log_sink(Args&&...) {}
#define ESP_LOGE(...) log_sink(__VA_ARGS__)
#define ESP_LOGW(...) log_sink(__VA_ARGS__)
#define ESP_LOGI(...) log_sink(__VA_ARGS__)
#define ESP_LOGD(...) log_sink(__VA_ARGS__)
namespace esphome::artwork_image {
struct TransferObserver {
  static TransferObserver& instance() {
    static TransferObserver value;
    return value;
  }
  void set(std::function<uint32_t(const std::string&)>, std::function<void(int)>) { trace += 'F'; }
};
}  // namespace esphome::artwork_image
namespace espcontrol {
static constexpr const char* TAG = "test";
static uint8_t *allocate_configuration_slot(size_t size) {
  if (++ConfigAllocations::calls == ConfigAllocations::fail_at) return nullptr;
  auto *data = static_cast<uint8_t *>(std::malloc(size));
  assert(data); ConfigAllocations::live.emplace(data, size);
  ConfigAllocations::peak_count = std::max(ConfigAllocations::peak_count, ConfigAllocations::live.size());
  return data;
}
static void release_configuration_slot(uint8_t *data) {
  assert(ConfigAllocations::live.erase(data) == 1); std::free(data);
}
namespace ha {
void maintain_subscriptions() {
  trace += 'H';
  if (ha_hook) ha_hook();
}
}  // namespace ha
namespace cards {
void set_card_runtime_registry_service(std::nullptr_t) { trace += 'K'; }
}  // namespace cards
struct Core {
  ConfigurationService* service{nullptr};
  ConfigurationService* available{nullptr};
  size_t configurations{0};
  template<class... Args> bool configure_configuration_service(Args&&...) {
    ++configurations;
    if (service) return false;
    service = available;
    return service != nullptr;
  }
  ConfigurationService* configuration_service() { return service; }
  void run_once() { trace += 'C'; }
  void stop() { trace += 'S'; }
};
struct Endpoint {
  void loop() { trace += 'E'; }
};
struct LegacyRuntime : ConfigurationRuntimeAdapter {
  size_t applies{0};
  bool apply(uint16_t, const uint8_t*, size_t) override {
    ++applies;
    return true;
  }
};
struct Transactions {
  ConfigurationMainLoop queue;
  void process(ConfigurationService& service) {
    trace += 'T';
    queue.process(service);
  }
  void stop() {
    trace += 'Q';
    queue.stop();
  }
};
struct NativeRuntime {
  LegacyRuntime runtime_config;
  Transactions transactions;
  struct Sources { bool configured() const { return true; } } legacy_config;
  struct Blobs {
    size_t opens{0}; bool ready{true};
    bool begin() { ++opens; return ready; }
    bool begin_card_images_partition(size_t) { ++opens; return ready; }
  } blobs;
  struct Backend {
    size_t starts{0}; bool begin(size_t) { ++starts; return true; }
  } backend;
  int store{0}, validator{0};
  size_t slot_capacity{1024};
  bool service_configured{false}, storage_ready{false}, document_available{false};
  bool boot_configuration_pending{true}, boot_configuration_due{false};
};
// Only ESPHome/device storage is doubled. Bodies below are copied unchanged
// from the production app and call the real durable service/main-loop queue.
class EspControlApp {
 public:
  using NativeConfigurationRuntime = NativeRuntime;
  Core core_;
  Endpoint home_assistant_endpoint_;
  std::unique_ptr<NativeRuntime> native_configuration_runtime_;
  ApplicationSceneRuntime* application_scene_{nullptr};
  bool application_scene_required_{false};
  bool configuration_text_refresh_pending_{false};
  bool shutting_down_{false}, native_configuration_initialized_{false};
  bool native_configuration_initialization_pending_{false};
  ConfigurationBufferRetry configuration_buffer_retry_{};
  bool panel_config_card_images_storage_{false}, native_requested{true}, runtime_creation_fails{false};
  static constexpr size_t PANEL_CONFIG_STORAGE_SLOT_CAPACITY = 1024;
  static constexpr size_t PANEL_CONFIG_NVS_SLOT_CAPACITY = 1024;
  std::unique_ptr<NativeRuntime> delayed_runtime;
  std::vector<std::pair<uint32_t, std::function<void()>>> timers;
  bool native_configuration_requested() const { return native_requested; }
  bool create_native_configuration_runtime() {
    if (native_configuration_runtime_) return true;
    if (runtime_creation_fails) return false;
    native_configuration_runtime_ = std::move(delayed_runtime);
    return native_configuration_runtime_ != nullptr;
  }
  void set_timeout(uint32_t delay, std::function<void()> callback) {
    timers.emplace_back(fake_time_ms + delay, std::move(callback));
  }
  void run_timeouts() {
    while (!timers.empty() && static_cast<int32_t>(fake_time_ms - timers.front().first) >= 0) {
      auto callback = std::move(timers.front().second); timers.erase(timers.begin()); callback();
    }
  }
  void initialize_native_configuration();
  void defer_native_configuration_initialization();
  bool install_application_scene(ApplicationSceneRuntime&);
  bool require_application_scene();
  ConfigurationRuntimeAdapter* selected_configuration_runtime();
  void apply_boot_configuration();
  void apply_configuration_text_refresh();
  void loop();
  void on_shutdown();
  void register_panel_config_endpoints() { trace += 'R'; }
};
// @production-app-method install_application_scene
// @production-app-method require_application_scene
// @production-app-method selected_configuration_runtime
// @production-app-method initialize_native_configuration
// @production-app-method defer_native_configuration_initialization
// @production-app-method apply_configuration_text_refresh
// @production-app-method apply_boot_configuration
// @production-app-method loop
// @production-app-method on_shutdown
