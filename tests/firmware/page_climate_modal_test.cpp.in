};
void values(){auto &t=coordinator.transport();t.send("climate.room","","heat");t.send("climate.room","supported_features","1");t.send("climate.room","temperature","21.5");t.send("climate.room","current_temperature","20");t.send("climate.room","hvac_modes","['off','heat','cool']");t.send("climate.room","fan_modes","['auto','low']");t.send("climate.room","fan_mode","auto");}
static PageModalToken last_style_token{};
void registry_lifetime() {
#ifdef ESPCONTROL_DEVICE_UI_SLOT_COUNT
  static_assert(climate_control_ref_capacity()==1);
#else
  static_assert(climate_control_ref_capacity()==MAX_GRID_SLOTS+MAX_SUBPAGE_ITEMS);
#endif
  ClimateControlCtx first,second;
  assert(climate_control_ref_count()==0);
  auto **refs=climate_control_refs();refs[0]=&first;climate_control_ref_count()=1;
#ifndef ESPCONTROL_DEVICE_UI_SLOT_COUNT
  static_assert(climate_control_ref_capacity()>=2);
  refs[1]=&second;climate_control_ref_count()=2;
  unregister_climate_control_context(&first);
  assert(climate_control_ref_count()==1&&refs[0]==&second&&refs[1]==nullptr);
  unregister_climate_control_context(&second);
#else
  unregister_climate_control_context(&first);
#endif
  assert(climate_control_ref_count()==0&&refs[0]==nullptr);
  unregister_climate_control_context(&first);assert(climate_control_ref_count()==0);
  refs[0]=&second;climate_control_ref_count()=1;reset_climate_control_refs();
  assert(climate_control_ref_count()==0&&refs[0]==nullptr);
}
void registry_registration_bound() {
  assert(climate_control_ref_count()==0);
  ParsedCfg config;config.entity="climate.one";config.type="climate_control";
  cards::ClimateControlDriverEnvironment env;
  const auto create=[&] {
    return create_climate_control_context(nullptr,nullptr,nullptr,config,
        env.accent_color,env.secondary_color,env.tertiary_color,env.number_font,env.range_number_font,
        env.unit_font,env.label_font,env.option_title_font,env.option_value_font,env.option_menu_font,
        env.card_icon_font,env.icon_font,env.width_compensation_percent,nullptr,nullptr,nullptr);
  };
  auto* first=create();assert(first&&climate_control_ref_count()==1&&climate_control_refs()[0]==first);
  auto* second=create();assert(second);
#ifdef ESPCONTROL_DEVICE_UI_SLOT_COUNT
  // Even a direct shared-helper call cannot write beyond the demanded bank.
  assert(climate_control_ref_count()==1&&climate_control_refs()[0]==first);
#else
  assert(climate_control_ref_count()==2&&climate_control_refs()[1]==second);
#endif
  delete_climate_control_context(second);assert(climate_control_ref_count()==1&&climate_control_refs()[0]==first);
  delete_climate_control_context(first);assert(climate_control_ref_count()==0&&climate_control_refs()[0]==nullptr);
  coordinator.reclaim_unused_channels();
}
void test_adapter() {
  assert(climate_format_tenths(std::numeric_limits<int>::min(),0)=="-214748365");
  assert(climate_format_tenths(std::numeric_limits<int>::max(),1)=="214748364.7");
  assert(climate_service_temp_value(std::numeric_limits<int>::min())=="-214748364.8");
  Fixture fixture,next(18);Arena arena;PageCardDependencies source;CoordinatorPageEntitySubscriptions subscriptions(coordinator,16);
  {
    PageEntityStateRuntime state(source,arena,subscriptions,{64,64,8192});assert(state.prepare(fixture.store));state.activate_prepared(fixture.store);values();
    const auto native=coordinator.transport().bindings.size(),graph_refs=coordinator.subscription_count(),arena_count=arena.live.size();
    bool style_available = true;
    PageClimateModalStyle style;
    style.owner = &style_available;
    style.resolve = [](void* owner, PageModalToken token, const ParsedCfg&,
                       cards::ClimateControlDriverEnvironment&) {
      last_style_token = token;
      return *static_cast<bool*>(owner);
    };
    PageClimateModalPort port(arena, state, style, nullptr, [](void*, PageBindingToken) { return true; });
    auto router = modal_test_router<ControlModalKind::CLIMATE>(port);
    PageModalRuntime runtime(router);
    assert(port.install(runtime));
    assert(runtime.prepare(fixture.store));runtime.activate_prepared(fixture.store);
    const auto baseline_lv=lv_live_bytes;
    for(size_t cycle=0;cycle<1000;++cycle) {
      assert(runtime.request_card({17,0}));runtime.loop();assert(ui.active&&runtime.interactive(runtime.token())&&clock_label=="Den");
      auto *ctx=ui.active;assert(ctx->has_target&&ctx->target_tenths==215&&ctx->fan_mode=="auto");
      const auto token=runtime.token();
      assert(climate_control_ref_count()==1&&climate_control_refs()[0]==ctx);
      assert(port.create(fixture.store,{17,0},token)==nullptr);
      assert(climate_control_ref_count()==1&&climate_control_refs()[0]==ctx);
      assert(last_style_token.configuration == 17 && last_style_token.card == 0 &&
             last_style_token.opening == token.opening && last_style_token.kind == ControlModalKind::CLIMATE);

      // No press: no pending edit. A valid press arms this exact opening.
      lv_obj_send_event(ui.button,LV_EVENT_CLICKED,nullptr);assert(!ctx->pending_temp_send);
      lv_obj_send_event(ui.button,LV_EVENT_PRESSED,nullptr);lv_obj_send_event(ui.button,LV_EVENT_CLICKED,nullptr);assert(ctx->pending_temp_send);
      ctx->target_tenths=230;runtime.loop();assert(ctx->target_tenths==230); // Initial replay must not reset edits.
      if(cycle==0) {
        const auto changes=modal_unit_refreshes,sends=commands.size();const auto revision=state.revision();
        const auto requests=coordinator.transport().requests;
        assert(std::string_view(lv_label_get_text(ui.unit_lbl))=="°C");
        struct RefreshEvent {PageModalRuntime* runtime;size_t changes;};
        RefreshEvent event{&runtime,changes};
        auto callback=+[](lv_event_t* e) {
          auto& request=*static_cast<RefreshEvent*>(lv_event_get_user_data(e));
          active_temperature_unit="°F";request.runtime->loop();
          assert(modal_unit_refreshes==request.changes); // No paint during LVGL dispatch.
        };
        auto* descriptor=lv_obj_add_event_cb(ui.unit_lbl,callback,LV_EVENT_VALUE_CHANGED,&event);
        lv_obj_send_event(ui.unit_lbl,LV_EVENT_VALUE_CHANGED,nullptr);
        assert(std::string_view(lv_label_get_text(ui.unit_lbl))=="°C");
        assert(lv_obj_remove_event_dsc(ui.unit_lbl,descriptor));
        runtime.loop();
        // No new climate report may be needed to refresh an active modal.
        assert(modal_unit_refreshes==changes+1);
        assert(std::string_view(lv_label_get_text(ui.unit_lbl))=="°F");
        assert(state.revision()==revision&&commands.size()==sends&&coordinator.transport().requests==requests);
        assert(ctx->target_tenths==230&&ctx->pending_temp_send&&runtime.valid(token));
        runtime.loop();assert(modal_unit_refreshes==changes+1);
        active_temperature_unit="°C";runtime.loop();
        assert(modal_unit_refreshes==changes+2&&std::string_view(lv_label_get_text(ui.unit_lbl))=="°C");
        // A shared panel refresh can paint a transient policy before the next
        // adapter tick. The final policy must still win if it coalesces back.
        active_temperature_unit="°F";climate_control_set_modal_value(ctx);
        assert(std::string_view(lv_label_get_text(ui.unit_lbl))=="°F");
        active_temperature_unit="°C";runtime.loop();
        assert(std::string_view(lv_label_get_text(ui.unit_lbl))=="°C");

        assert(ctx->target_tenths==230&&ctx->pending_temp_send&&runtime.valid(token));
        const auto before_hidden=modal_unit_refreshes;
        lv_obj_add_flag(ui.unit_lbl,LV_OBJ_FLAG_HIDDEN);active_temperature_unit="°F";
        runtime.loop();assert(modal_unit_refreshes==before_hidden);
        lv_obj_remove_flag(ui.unit_lbl,LV_OBJ_FLAG_HIDDEN);runtime.loop();
        assert(modal_unit_refreshes==before_hidden+1&&std::string_view(lv_label_get_text(ui.unit_lbl))=="°F");
        active_temperature_unit="°C";runtime.loop();
        assert(modal_unit_refreshes==before_hidden+2&&std::string_view(lv_label_get_text(ui.unit_lbl))=="°C");
      }

      const auto before=commands.size();climate_control_hide_modal();
      assert(!runtime.valid(token)&&runtime.memory().retired_contexts==1&&ctx->entity_id=="climate.room");
      assert(commands.size() == before);
      climate_send_temperature(ctx);
      assert(commands.size() == before);  // Retired timers cannot send or erase the edit.
      runtime.loop();
      assert(commands.size() == before + 1 && commands.back().data[0].second == "23.0");
      coordinator.reclaim_unused_channels();
      assert(!ui.active && climate_control_ref_count() == 0 && climate_control_refs()[0]==nullptr);
      assert(coordinator.subscription_count()==graph_refs&&coordinator.transport().bindings.size()==native&&arena.live.size()==arena_count);
      assert(lv_live_bytes==baseline_lv&&climate_optional_subscription_timer()==nullptr&&reannouncements==0);
    }
    assert(runtime.request_card({17, 0}));
    runtime.loop();
    assert(ui.active);
    assert_panel_draw_retirement(runtime, ui.overlay);
    // Revoke a closed edit before collection, including a same-generation replacement.
    for (int revoke = 0; revoke < 5; ++revoke) {
      assert(runtime.request_card({17, 0}));
      runtime.loop();
      auto* closing = ui.active;
      assert(closing);
      closing->target_tenths = 240;
      climate_schedule_temperature_send(closing);
      const auto sends_before = commands.size();
      runtime.dismiss();
      assert(commands.size() == sends_before);
      if (revoke == 0) runtime.display_takeover(false);
      if (revoke == 1) {
        assert(runtime.prepare(fixture.store));
        runtime.activate_prepared(fixture.store);
      }
      if (revoke == 2) {
        coordinator.transport().connected = false;
        coordinator.invalidate_retained_state();
        coordinator.transport().connected = true;
        values();
      }
      if (revoke == 3) coordinator.transport().send("climate.room", "", "unavailable");
      if (revoke == 4) coordinator.transport().send("climate.room", "", "cool");
      runtime.loop();
      assert(commands.size() == sends_before && !ui.active);
      values();
    }
    // Invalid live values must not overflow integer temperatures or leave
    // a pending command enabled. The raw graph keeps the full incoming state.
    assert(runtime.request_card({17,0}));runtime.loop();auto *numeric=ui.active;
    for(const auto invalid:{"1e30","-1e30","inf","nan"}) {
      numeric->pending_temp_send=true;coordinator.transport().send("climate.room","temperature",invalid);
      assert(!numeric->has_target&&!numeric->pending_temp_send);
    }
    coordinator.transport().send("climate.room","temperature","21.5");assert(numeric->has_target&&numeric->target_tenths==215);
    climate_control_hide_modal();runtime.loop();
    // The original panel's click callback can close and request cleanup
    // while LVGL still holds its event. Context/pool destruction waits.
    assert(runtime.request_card({17,0}));runtime.loop();auto *clicked=ui.active;
    lv_obj_add_event_cb(ui.button,[](lv_event_t *event){auto *owner=static_cast<PageModalRuntime *>(lv_event_get_user_data(event));auto *ctx=ui.active;climate_control_hide_modal();owner->loop();assert(ctx->entity_id=="climate.room"&&owner->memory().retired_contexts==1);},LV_EVENT_CLICKED,&runtime);
    lv_obj_send_event(ui.button,LV_EVENT_PRESSED,nullptr);auto *close_button=ui.button;
    lv_obj_send_event(close_button,LV_EVENT_CLICKED,nullptr);assert(!ui.active&&clicked->entity_id=="climate.room");runtime.loop();
    // A synchronous close must not send the same edit twice, while pending
    // fields continue protecting newer edits from old Home Assistant echoes.
    assert(runtime.request_card({17,0}));runtime.loop();auto *timed=ui.active;
    timed->target_tenths=225;climate_schedule_temperature_send(timed);
    const auto before_timer=commands.size();size_t guarded_sends=0;
    during_send=[&](){assert(timed->pending_temp_send&&timed->temperature_send_in_progress);climate_control_hide_modal();runtime.loop();assert(timed->entity_id=="climate.room"&&runtime.memory().retired_contexts==1);++guarded_sends;};
    lv_tick_inc(CLIMATE_TEMP_DEBOUNCE_MS+1);lv_timer_handler();during_send={};
    assert(guarded_sends==1&&commands.size()==before_timer+1&&!ui.active);runtime.loop();
    // A real HA callback hides the UI, then continues to refresh the same
    // context. Calling loop reentrantly must not free it before that return.
    assert(runtime.request_card({17,0}));runtime.loop();auto *unavailable=ui.active;size_t guarded_refreshes=0;
    after_refresh=[&](ClimateControlCtx *ctx){if(ctx==unavailable&&!ctx->available){runtime.loop();assert(ctx->entity_id=="climate.room"&&runtime.memory().retired_contexts==1);++guarded_refreshes;}};
    const auto before_unavailable=commands.size();coordinator.transport().send("climate.room","","unavailable");
    after_refresh={};assert(guarded_refreshes==1&&!ui.active&&commands.size()==before_unavailable);runtime.loop();values();
    arena.remaining=0;assert(runtime.request_card({17,0}));runtime.loop();arena.remaining=-1;assert(!ui.active&&arena.live.size()==arena_count);
    arena.remaining=1;assert(runtime.request_card({17,0}));runtime.loop();arena.remaining=-1;assert(!ui.active&&arena.live.size()==arena_count);
    style_available=false;assert(runtime.request_card({17,0}));runtime.loop();style_available=true;assert(!ui.active&&arena.live.size()==arena_count);
    enough_heap=false;assert(runtime.request_card({17,0}));runtime.loop();enough_heap=true;assert(!ui.active);
    assert(runtime.request_card({17,0}));runtime.loop();auto *ctx=ui.active;ctx->pending_temp_send=true;ctx->target_tenths=240;
    const auto before=commands.size();coordinator.transport().connected=false;coordinator.invalidate_retained_state();
    climate_send_temperature(ctx);assert(commands.size()==before);runtime.loop();assert(!ui.active&&commands.size()==before);
    coordinator.transport().connected=true;values();assert(runtime.request_card({17,0}));runtime.loop();assert(ui.active);
    ctx=ui.active;ctx->pending_temp_send=true;ctx->target_tenths=250;
    int foreign=0;const auto token=runtime.token();
    assert(coordinator.subscribe("sensor.replace","",[&](esphome::StringRef) {
      assert(runtime.prepare(next.store));const auto cpp_before=cpp_allocation_calls,lv_before=lv_allocation_calls;runtime.activate_prepared(next.store);
      assert(cpp_allocation_calls==cpp_before&&lv_allocation_calls==lv_before);
      assert(ui.active==ctx&&lv_obj_has_flag(ui.overlay,LV_OBJ_FLAG_HIDDEN)&&control_modal_active().kind==ControlModalKind::NONE&&climate_control_ref_count()==0);
      std::memset(fixture.storage.data(),0xA5,fixture.storage.size());
      runtime.loop();assert(ctx->entity_id=="climate.room"&&runtime.memory().retired_contexts==1&&!runtime.valid(token));
    },64,&foreign,false,false));
    coordinator.transport().send("sensor.replace","","go");coordinator.release_owner(&foreign);
    assert(ctx->entity_id=="climate.room"&&commands.size()==before);runtime.loop();assert(!ui.active&&commands.size()==before);
    // The modal model has advanced, but its entity graph has not. Old graph
    // values must not seed a modal belonging to the replacement generation.
    assert(runtime.request_card({18,0}));runtime.loop();assert(!ui.active);
    assert(state.prepare(next.store));state.activate_prepared(next.store);values();
    assert(runtime.request_card({18,0}));runtime.loop();assert(ui.active&&runtime.valid(runtime.token()));
    runtime.retire_active();runtime.loop();state.retire_active();
  }
  coordinator.reclaim_unused_channels();assert(arena.live.empty()&&coordinator.transport().bindings.empty());
}
int main(){lv_init();auto *display=lv_display_create(480,480);assert(display);lv_timer_pause(lv_display_get_refr_timer(display));registry_lifetime();registry_registration_bound();test_adapter();lv_display_delete(display);lv_deinit();assert(lv_live_bytes==0);}
