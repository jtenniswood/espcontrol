#include "button_grid_climate_subscriptions.h"
// @production-function subscribe_climate_control_state
// @production-function create_climate_control_context
// @production-function unregister_climate_control_context
// @production-function delete_climate_control_context
// @production-function climate_control_can_open_modal
void climate_control_open_modal(ClimateControlCtx *ctx) {
  if(!climate_control_can_open_modal(ctx))return;
  assert(!ui.active);ui.active=ctx;ui.overlay=lv_obj_create(lv_layer_top());ui.button=lv_button_create(ui.overlay);ui.unit_lbl=lv_label_create(ui.overlay);climate_control_set_modal_value(ctx);
  lv_obj_add_event_cb(ui.button,[](lv_event_t *){climate_schedule_temperature_send(ui.active);},LV_EVENT_CLICKED,nullptr);
  modal_service.set_active(ControlModalKind::CLIMATE,ui.overlay,climate_control_hide_modal,ControlModalDismissPolicy::DISMISS);
  if(!climate_modal_widgets_ready(ui.overlay))climate_control_hide_modal();
}
#include "page_climate_modal.h"
struct Arena:PageArenaAllocator {
  std::unordered_map<void *,size_t>live;int remaining{-1};
  void *allocate(size_t size)override{if(remaining==0)return nullptr;if(remaining>0)--remaining;void *p=std::malloc(size);assert(p);live[p]=size;return p;}
  void release(void *p,size_t size)override{assert(live.at(p)==size);live.erase(p);std::free(p);}
};
