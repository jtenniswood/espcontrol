// @production-function climate_control_hide_modal
struct Command{std::string entity,service;std::vector<std::pair<std::string,std::string>> data;};
std::vector<Command> commands;
std::function<void()> during_send;
bool climate_send_action(const std::string &entity,const char *service,const std::vector<std::pair<const char *,std::string>> &data){Command command{entity,service,{}};for(const auto &pair:data)command.data.emplace_back(pair.first,pair.second);commands.push_back(std::move(command));if(during_send)during_send();return true;}
