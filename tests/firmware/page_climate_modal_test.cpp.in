static size_t modal_unit_refreshes=0;
void climate_control_set_modal_value(ClimateControlCtx* ctx){
  if(!ctx||ui.active!=ctx)return;
  ++modal_unit_refreshes;
  if(ui.unit_lbl)lv_label_set_text(ui.unit_lbl,display_temperature_unit_symbol());
}
