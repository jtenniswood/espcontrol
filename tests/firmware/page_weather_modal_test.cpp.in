// @production-function weather_daily_hide_modal
struct ShellLayout {
  int back_size = 32, inset = 12, panel_h = 480;
};
struct Shell {
  lv_obj_t *overlay, *panel;
  ShellLayout layout;
  int content_w = 432;
};
lv_obj_t* close_button = nullptr;
std::function<void(WeatherDailySource*)> after_close;
Shell control_modal_open_shell(ControlModalKind kind, lv_obj_t* owner, int, const lv_font_t*,
                               void (*close)()) {
  assert(owner && lv_obj_has_flag(owner, LV_OBJ_FLAG_HIDDEN));
  assert(lv_obj_get_style_radius(owner, LV_PART_MAIN) == 12);
  auto* overlay = lv_obj_create(lv_layer_top());
  auto* panel = lv_obj_create(overlay);
  close_button = lv_button_create(panel);
  lv_obj_add_event_cb(
      close_button,
      [](lv_event_t* event) {
        auto* source = weather_daily_modal().source;
        auto callback = reinterpret_cast<void (*)()>(lv_event_get_user_data(event));
        callback();
        if (after_close) after_close(source);
      },
      LV_EVENT_CLICKED, reinterpret_cast<void*>(close));
  modal_service.set_active(kind, overlay, close, ControlModalDismissPolicy::DISMISS);
  return {overlay, panel, {}, 432};
}
// @production-function weather_daily_modal_container
// @production-function weather_daily_modal_number
