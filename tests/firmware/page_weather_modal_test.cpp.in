#include "page_weather_modal.h"

// Request admission runs inside the input callback; panel allocation belongs to loop().
static bool request_without_allocation(PageModalRuntime& runtime, ConfigurationHandle token) {
  const auto cpp = cpp_allocation_calls, lv = lv_allocation_calls;
  const bool accepted = runtime.request_card(token);
  assert(cpp_allocation_calls == cpp && lv_allocation_calls == lv);
  return accepted;
}

struct Arena : PageArenaAllocator {
  std::unordered_map<void*, size_t> live;
  int remaining = -1;
  void* allocate(size_t size) override {
    if (remaining == 0) return nullptr;
    if (remaining > 0) --remaining;
    auto* p = std::malloc(size);
    assert(p);
    live[p] = size;
    return p;
  }
  void release(void* p, size_t size) override {
    assert(live.at(p) == size);
    live.erase(p);
    std::free(p);
  }
};
struct Requests : PageForecastRequests {
  void* owner = nullptr;
  PageForecastToken token;
  Receive receive = nullptr;
  bool online = true;
  uint32_t connection = 1, now = 100;
  size_t starts = 0;
  bool connected() const override {
    return online;
  }
  uint32_t connection_generation() const override {
    return connection;
  }
  uint32_t now_ms() const override {
    return now;
  }
  bool start(void* o, PageForecastToken t, std::string_view, Receive r) override {
    owner = o;
    token = t;
    receive = r;
    ++starts;
    return true;
  }
  void cancel(void*, PageForecastToken) override {
    receive = nullptr;
  }
  void reply(size_t days) {
    std::string text = "WF1|2026-10-17|2026-10-18|°C|mm|km/h\n";
    for (size_t i = 0; i < days; ++i) text += "2026-10-" + std::to_string(17 + i) + "|sunny|20|10|5|1|2|50\n";
    auto callback = receive;
    receive = nullptr;
    assert(callback);
    callback(owner, token, text, true);
  }
};
struct Fixture {
  explicit Fixture(uint32_t generation = 17, const char* precision = "daily") {
    const auto& limits = DEVICE_UI_PROFILES[8];
    PanelConfigWriter writer(document.data(), document.size());
    assert(writer.begin() == PanelConfigStatus::OK);
    assert(writer.append_device_profile(reinterpret_cast<const uint8_t*>(limits.device_profile),
                                        std::strlen(limits.device_profile)) == PanelConfigStatus::OK);
    for (uint8_t slot = 1; slot <= 2; ++slot) {
      const std::string text =
          std::string("weather.home;;;;;;weather;") + (slot == 1 ? std::string(precision) + ";" : "today;");
      assert(writer.append_button(slot, reinterpret_cast<const uint8_t*>(text.data()), text.size()) ==
             PanelConfigStatus::OK);
    }
    assert(writer.finish(&size) == PanelConfigStatus::OK);
    assert(PageStore::stage_v1(document.data(), size, limits, generation, storage.data(), storage.size(),
                               &store) == PageStoreStatus::OK);
  }
  std::array<uint8_t, 8192> document{};
  size_t size = 0;
  alignas(std::max_align_t) std::array<uint8_t, 32768> storage{};
  PageStore store;
};
void click(lv_obj_t* button) {
  lv_obj_send_event(button, LV_EVENT_PRESSED, nullptr);
  lv_obj_send_event(button, LV_EVENT_RELEASED, nullptr);
  lv_obj_send_event(button, LV_EVENT_CLICKED, nullptr);
}
void test_weather_modal() {
  Fixture first, next(18), invalid(19, "invalid_forecast_precision_beyond_small_string_capacity");
  Arena arena;
  Requests requests;
  PageForecastRuntime forecasts(arena, requests);
  assert(forecasts.prepare(first.store));
  forecasts.activate_prepared(first.store);
  {
    struct Settings {
      bool allowed = true;
      size_t gestures = 128;
    } settings;
    PageWeatherModalStyle style;
    style.owner = &settings;
    style.resolve = [](void* owner, const ParsedCfg&, PageWeatherModalStyle& out) {
      auto& settings = *static_cast<Settings*>(owner);
      out.font = out.icon_font = out.temperature_font = &lv_font_montserrat_14;
      out.gesture_capacity = settings.gestures;
      return settings.allowed;
    };
    PageWeatherModalPort port(arena, forecasts, style, nullptr, [](void*, PageBindingToken) { return true; });
    PageModalRuntime modal(port);
    auto* legacy = weather_daily_acquire_source("weather.legacy");
    assert(!port.install(modal));
    weather_daily_release_source(legacy);
    assert(port.install(modal));
    assert(modal.prepare(invalid.store));
    modal.activate_prepared(invalid.store);
    assert(!request_without_allocation(modal, {19, 0}));
    assert(modal.prepare(first.store));
    modal.activate_prepared(first.store);
    const auto baseline = arena.live.size(), lv_baseline = lv_live_bytes;
    assert(!request_without_allocation(modal, {17, 1}));
    assert(request_without_allocation(modal, {17, 0}));
    modal.loop();
    assert(weather_daily_modal().overlay && weather_daily_modal().columns.size() == 6 &&
           clock_label == "Weather");
    assert(std::strcmp(lv_label_get_text(weather_daily_modal().message), "Loading") == 0);
    lv_obj_send_event(close_button, LV_EVENT_CLICKED, nullptr);
    assert(weather_daily_modal().overlay);
    click(close_button);
    modal.loop();
    assert(!weather_daily_modal().overlay && arena.live.size() == baseline && lv_live_bytes == lv_baseline);
    requests.now += PageForecastRuntime::READY_DELAY_MS;
    forecasts.loop();
    requests.reply(8);
    for (int i = 0; i < 1000; ++i) {
      assert(request_without_allocation(modal, {17, 0}));
      modal.loop();
      auto* source = weather_daily_modal().source;
      assert(source && source->forecast.count == 8 && source->users == 1 &&
             weather_daily_modal().columns.size() == 6);
      assert(weather_daily_cards().empty() && weather_daily_sources().empty());
      const auto token = modal.token();
      click(close_button);
      assert(!modal.valid(token) && modal.memory().retired_contexts == 1 &&
             source->entity_id == "weather.home");
      modal.loop();
      assert(arena.live.size() == baseline && lv_live_bytes == lv_baseline && requests.starts == 1);
    }
    assert(request_without_allocation(modal, {17, 1}));
    modal.loop();
    const auto* first_panel = weather_daily_modal().columns[0].button;
    forecasts.refresh();
    forecasts.loop();
    requests.reply(2);
    modal.loop();
    assert(weather_daily_modal().columns.size() == 6 &&
           weather_daily_modal().columns[0].button == first_panel &&
           lv_obj_has_flag(weather_daily_modal().columns[2].button, LV_OBJ_FLAG_HIDDEN));
    requests.online = false;
    ++requests.connection;
    forecasts.loop();
    modal.loop();
    assert(weather_daily_modal().overlay && weather_daily_modal().source->stale &&
           !lv_obj_has_flag(weather_daily_modal().status, LV_OBJ_FLAG_HIDDEN));
    click(close_button);
    modal.loop();
    assert(request_without_allocation(modal, {17, 0}));
    modal.loop();
    after_close = [&](WeatherDailySource* source) {
      modal.loop();
      assert(source->entity_id == "weather.home" && modal.memory().retired_contexts == 1);
    };
    click(close_button);
    after_close = {};
    modal.loop();
    arena.remaining = 0;
    assert(request_without_allocation(modal, {17, 0}));
    modal.loop();
    arena.remaining = -1;
    assert(!weather_daily_modal().overlay && arena.live.size() == baseline);
    arena.remaining = 1;
    assert(request_without_allocation(modal, {17, 0}));
    modal.loop();
    arena.remaining = -1;
    assert(!weather_daily_modal().overlay && arena.live.size() == baseline);
    settings.allowed = false;
    assert(request_without_allocation(modal, {17, 0}));
    modal.loop();
    settings.allowed = true;
    assert(!weather_daily_modal().overlay);
    settings.gestures = 1;
    assert(request_without_allocation(modal, {17, 0}));
    modal.loop();
    settings.gestures = 128;
    assert(!weather_daily_modal().overlay && arena.live.size() == baseline);
    enough_heap = false;
    assert(request_without_allocation(modal, {17, 0}));
    modal.loop();
    enough_heap = true;
    assert(!weather_daily_modal().overlay);
    assert(request_without_allocation(modal, {17, 0}));
    modal.loop();
    auto* source = weather_daily_modal().source;
    assert(modal.prepare(next.store) && forecasts.prepare(next.store));
    coordinator.inside = true;
    const auto allocations = cpp_allocation_calls;
    modal.activate_prepared(next.store);
    forecasts.activate_prepared(next.store);
    assert(cpp_allocation_calls == allocations &&
           lv_obj_has_flag(weather_daily_modal().overlay, LV_OBJ_FLAG_HIDDEN));
    std::memset(first.storage.data(), 0xA5, first.storage.size());
    modal.loop();
    assert(source->entity_id == "weather.home" && modal.memory().retired_contexts == 1);
    coordinator.inside = false;
    modal.loop();
    assert(!weather_daily_modal().overlay);
    modal.retire_active();
    modal.loop();
    forecasts.retire_active();
    forecasts.loop();
  }
  assert(arena.live.empty() && weather_daily_cards().empty() && weather_daily_sources().empty());
}
int main() {
  lv_init();
  auto* display = lv_display_create(480, 480);
  assert(display);
  lv_timer_pause(lv_display_get_refr_timer(display));
  test_weather_modal();
  lv_display_delete(display);
  lv_deinit();
  assert(lv_live_bytes == 0);
}
