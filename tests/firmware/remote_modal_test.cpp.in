#include <cassert>
#include <cctype>
#include <cstdio>
#include <map>
#include <string>
#include <vector>
#include "button_grid_limits.h"
#include "button_grid_card_runtime.h"
#include "card_modal_target.h"
#include "../artwork_image/image_pipeline_policy.h"

struct ParsedCfg {
  std::string entity, type, sensor, options;
};
using SubpageBtn = ParsedCfg;
struct lv_obj_t;
struct Runtime {
  lv_obj_t *btn = nullptr;
  bool media_artwork = false;
  std::string entity_id;
  bool available = true;
  bool group_only = false;
  bool grouping_supported = true;
  bool active = true;
  void *image = this;
  bool image_ready = true;
  std::string source_url;
  std::string type;
  bool oscillation_known = true, direction_known = true;
  std::vector<std::string> preset_modes = {"auto"};
};
using LightControlCtx = Runtime;
using CoverControlCtx = Runtime;
using MediaVolumeCtx = Runtime;
using MediaControlCtx = Runtime;
using ClimateControlCtx = Runtime;
using AlarmCardCtx = Runtime;
using FanCardCtx = Runtime;
using ImageCardCtx = Runtime;
using OptionSelectCtx = Runtime;
struct lv_obj_t { Runtime *runtime = nullptr; bool hidden = false; lv_obj_t *parent = nullptr; };
constexpr int LV_OBJ_FLAG_HIDDEN = 1;
void *lv_obj_get_user_data(lv_obj_t *obj) { return obj->runtime; }
bool lv_obj_has_flag(lv_obj_t *obj, int) { return obj->hidden; }
struct BtnSlot {};
struct NavigationHomeTargetEntry {
  int slot, display_order;
  std::string label, config;
  lv_obj_t *button;
};
struct NavigationSubpageEntry {
  int slot, display_order;
  lv_obj_t *screen;
  struct Card { int index; lv_obj_t *button; SubpageBtn definition; int display_order; };
  std::vector<Card> cards;
};
std::vector<NavigationHomeTargetEntry> homes;
std::vector<NavigationSubpageEntry> pages;
std::map<std::string, ParsedCfg> configs;
auto &navigation_home_targets() { return homes; }
auto &navigation_subpages() { return pages; }
NavigationHomeTargetEntry *navigation_find_slot_target(int slot) {
  for (auto &entry : homes) if (entry.slot == slot) return &entry;
  return nullptr;
}
ParsedCfg parse_cfg(const std::string &config) { return configs.at(config); }
ParsedCfg parsed_cfg_from_subpage_btn(const SubpageBtn &config) { return config; }
std::string navigation_trim(const std::string &s) {
  auto first = s.find_first_not_of(" \r\n\t");
  return first == std::string::npos ? "" : s.substr(first, s.find_last_not_of(" \r\n\t") - first + 1);
}
bool locked = false, alarm = false, fail_open = false;
bool screen_lock_enabled() { return locked; }
bool alarm_display_takeover_active() { return alarm; }
ControlModalActiveState<lv_obj_t> modal;
lv_obj_t overlay, home, other_page;
lv_obj_t *current_page = &home;
Runtime *opened = nullptr;
int opens = 0, closes = 0, commands = 0;
std::string last_log;
template<typename... Args>
void log_message(const char *, const char *format, Args... args) {
  char message[512]; std::snprintf(message, sizeof(message), format, args...); last_log = message;
}
void log_message(const char *, const char *message) { last_log = message; }
#define ESP_LOGW(...) log_message(__VA_ARGS__)
#define ESP_LOGI(...) log_message(__VA_ARGS__)
using ControlModalActive = ControlModalActiveState<lv_obj_t>;
auto &control_modal_active() { return modal; }
lv_obj_t *lv_obj_get_parent(lv_obj_t *o) { return o->parent; }
lv_obj_t *lv_scr_act() { return current_page; }
bool image_card_modal_active_for(Runtime *r) { return modal.overlay && opened == r && modal.kind == ControlModalKind::IMAGE_CARD; }
void navigation_hide_modals() { ++closes; modal = {}; }
struct GridRuntimeAllocation {
  lv_obj_t *owner;
  void *ptr;
  void (*deleter)(void *);
};
std::vector<GridRuntimeAllocation> allocations;
auto &grid_runtime_allocations() { return allocations; }
void show(Runtime *runtime, ControlModalKind kind) {
  ++opens; opened = runtime;
  if (!fail_open) { modal.kind = kind; modal.overlay = &overlay; }
}
#define OPEN(name, kind) void name(Runtime *r) { show(r, ControlModalKind::kind); }
OPEN(light_control_open_modal, LIGHT_CONTROL)
OPEN(cover_control_open_modal, COVER_CONTROL)
OPEN(media_volume_open_modal, MEDIA_VOLUME)
OPEN(media_control_open_modal, MEDIA_CONTROL)
OPEN(climate_control_open_modal, CLIMATE)
OPEN(alarm_control_open_modal, ALARM_CONTROL)
OPEN(fan_control_open_modal, FAN_CONTROL)
OPEN(fan_preset_open, FAN_PRESET)
OPEN(image_card_open_modal, IMAGE_CARD)
OPEN(option_select_open_modal, OPTION_SELECT)
void wifi_qr_open_modal(const ParsedCfg &, lv_obj_t *) { show(nullptr, ControlModalKind::WIFI_QR); }
// Any accidental re-use of a command/click path must fail these tests.
void handle_button_click(const std::string &, int, lv_obj_t *) { ++commands; }
void send_toggle_action(const std::string &) { ++commands; }
void send_media_playback_action(const std::string &, const std::string &) { ++commands; }
void send_media_playlist_action(const ParsedCfg &) { ++commands; }
void send_slider_action(const std::string &, int) { ++commands; }
void fan_card_handle_click(Runtime *) { ++commands; }
bool action_card_option_select(const ParsedCfg &p) { return p.sensor == "select_option"; }
bool alarm_card_context_valid(Runtime *r) { return r != nullptr; }
bool option_select_entity_supported(const std::string &entity) { return entity.find("select.") == 0; }
bool fan_light_supported(Runtime *) { return false; }
struct Tabs { int count = 1; };
Tabs fan_control_visible_tabs(Runtime *) { return {}; }
Runtime *grid_media_control_runtime_for_owner(lv_obj_t *button) { return button ? button->runtime : nullptr; }
bool wifi_qr_payload_from_config(const ParsedCfg &config, std::string *payload,
                                 std::string *ssid, std::string *) {
  return payload && ssid && config.options == "valid";
}
void control_modal_close_nested_menu() {}
void control_modal_force_close_active() { navigation_hide_modals(); }
std::string navigation_lower(const std::string &value) {
  std::string lowered = value;
  for (char &character : lowered) character = static_cast<char>(std::tolower(character));
  return lowered;
}
NavigationSubpageEntry *navigation_find_slot(int slot) {
  for (auto &page : pages) if (page.slot == slot) return &page;
  return nullptr;
}
int active_subpage_slot = 0;
int navigation_active_subpage_slot() { return active_subpage_slot; }
bool navigation_return_home(lv_obj_t *main_page_obj) {
  if (!main_page_obj) return false;
  current_page = main_page_obj;
  active_subpage_slot = 0;
  return true;
}
bool navigation_activate_home_target(NavigationHomeTargetEntry *target, lv_obj_t *main_page_obj) {
  if (!target || !main_page_obj) return false;
  current_page = target->button == &home ? main_page_obj : target->button;
  active_subpage_slot = target->slot;
  return true;
}
// PRODUCTION_HOOKS
#include "button_grid_remote_modal.h"

int main() {
  struct Case { const char *type; const char *mode; const char *entity; ControlModalKind kind; };
  const Case cases[] = {
    {"light_control", "", "light.office", ControlModalKind::LIGHT_CONTROL},
    {"cover", "modal", "cover.office", ControlModalKind::COVER_CONTROL},
    {"climate_control", "", "climate.office", ControlModalKind::CLIMATE},
    {"fan_control", "", "fan.office", ControlModalKind::FAN_CONTROL},
    {"fan_preset", "", "fan.office", ControlModalKind::FAN_PRESET},
    {"media", "control_modal", "media_player.office", ControlModalKind::MEDIA_CONTROL},
    {"media", "speaker_group", "media_player.office", ControlModalKind::MEDIA_CONTROL},
    {"media", "cover_art", "media_player.office", ControlModalKind::MEDIA_CONTROL},
    {"media", "volume", "media_player.office", ControlModalKind::MEDIA_VOLUME},
    {"image", "", "camera.office", ControlModalKind::IMAGE_CARD},
    {"alarm", "", "alarm_control_panel.office", ControlModalKind::ALARM_CONTROL},
    {"option_select", "", "select.office", ControlModalKind::OPTION_SELECT},
    {"wifi_qr", "", "switch.guest", ControlModalKind::WIFI_QR},
  };
  for (const auto &test : cases) {
    Runtime runtime; runtime.entity_id = test.entity; runtime.type = test.type;
    lv_obj_t button{&runtime};
    configs["test"] = {test.entity, test.type, test.mode, "valid"};
    homes = {{1, 0, "", "test", &button}};
    assert(espcontrol_can_open_modal(test.entity, true));
    assert(espcontrol_open_modal(test.entity, true));
    assert(modal.kind == test.kind && commands == 0 && current_page == &home);
    if (test.kind != ControlModalKind::WIFI_QR) {
      const int old_opens = opens, old_closes = closes;
      runtime.available = false; runtime.image_ready = false;
      assert(!espcontrol_open_modal(test.entity, true));
      assert(opens == old_opens && closes == old_closes);
      runtime.available = true; runtime.image_ready = true;
      button.runtime = nullptr;
      assert(!espcontrol_open_modal(test.entity, true));
      button.runtime = &runtime;
    }
    if (test.kind == ControlModalKind::MEDIA_CONTROL) {
      runtime.entity_id = "media_player.secondary";
      assert(espcontrol_open_modal(test.entity, true) && opened == &runtime);
      runtime.entity_id = test.entity;
      runtime.group_only = true; runtime.grouping_supported = false;
      assert(!espcontrol_open_modal(test.entity, true));
      runtime.group_only = false;
    }
    if (test.kind == ControlModalKind::IMAGE_CARD) {
      runtime.image_ready = false; runtime.source_url = "http://example.test/image";
      assert(espcontrol_open_modal(test.entity, true));
      runtime.image_ready = true; runtime.source_url.clear();
    }
    if (test.kind == ControlModalKind::WIFI_QR) {
      configs["test"].options = "invalid";
      const int old_closes = closes;
      assert(!espcontrol_open_modal(test.entity, true) && closes == old_closes);
      configs["test"].options = "valid";
    }
    // Same production hook on a different, currently inactive subpage.
    configs["parent"] = {"", "subpage", "", ""};
    homes = {{3, 2, "", "parent", &other_page}};
    pages = {{3, 2, &other_page, {{7, &button, configs["test"], 0}}}};
    assert(espcontrol_open_modal(test.entity, true));
    assert(modal.kind == test.kind && current_page == &home && commands == 0);
    current_page = &other_page;
    assert(espcontrol_open_modal(test.entity, true));
    navigation_hide_modals();
    assert(current_page == &other_page);
    current_page = &home;
    pages.clear();
  }
  Runtime first, second; first.entity_id = second.entity_id = "light.office";
  lv_obj_t one{&first}, two{&second};
  configs["light"] = {"light.office", "light_control", "", ""};
  configs["command"] = {"light.office", "light_switch", "", ""};
  homes = {{8, 7, "", "light", &two}, {2, 1, "", "light", &one},
           {1, 0, "", "command", &two}};
  assert(espcontrol_open_modal("  light.office \n", true) && opened == &first);
  assert(remote_modal_find("light.office").matches == 2);
  first.available = false;
  const int before = opens, closed_before = closes;
  assert(!espcontrol_open_modal("light.office", true)); // No fallback to second.
  assert(opens == before && closes == closed_before);
  first.available = true;
  locked = true; assert(!espcontrol_open_modal("light.office", true)); locked = false;
  alarm = true; assert(!espcontrol_open_modal("light.office", true)); alarm = false;
  assert(!espcontrol_open_modal("light.office", false));
  assert(!espcontrol_open_modal("  ", true));
  assert(!espcontrol_open_modal("light.missing", true));
  assert(!espcontrol_open_modal("LIGHT.OFFICE", true));
  assert(opens == before && closes == closed_before);
  // Hidden cards are excluded, and display order (not slot number) wins.
  one.hidden = true;
  assert(espcontrol_open_modal("light.office", true) && opened == &second);
  one.hidden = false;
  homes = {{3, 4, "", "parent", &other_page}, {4, 0, "", "parent", &home}};
  pages = {{3, 0, &other_page, {{1, &one, configs["light"], 0}}},
           {4, 9, &home, {{1, &one, configs["light"], 4}, {2, &two, configs["light"], 0}}}};
  assert(espcontrol_open_modal("light.office", true) && opened == &second);
  pages[1].cards[0].display_order = 0; pages[1].cards[1].display_order = 3;
  assert(espcontrol_open_modal("light.office", true) && opened == &first);
  // An alarm subpage may inherit its entity from the bound runtime.
  first.entity_id = "alarm_control_panel.inherited";
  pages = {{3, 0, &other_page, {{1, &one, {"", "alarm", "", ""}, 0}}}};
  assert(espcontrol_open_modal(first.entity_id, true) && opened == &first);
  // Resolve before waking, then delete the target during wake. No stale pointer opens.
  assert(espcontrol_can_open_modal(first.entity_id, true));
  pages.clear();
  const int count = opens;
  assert(!espcontrol_open_modal(first.entity_id, true) && opens == count);
  first.entity_id = "light.office";
  homes = {{1, 0, "", "light", &one}};
  assert(espcontrol_can_open_modal("light.office", true));
  configs["light"].entity = first.entity_id = "light.renamed";
  assert(!espcontrol_open_modal("light.office", true));
  assert(espcontrol_open_modal("light.renamed", true));
  fail_open = true;
  assert(!espcontrol_open_modal("light.renamed", true));
  assert(last_log.find("modal creation failed") != std::string::npos);
  fail_open = false;
  for (const auto &config : std::vector<ParsedCfg>{
      {"light.office", "light_switch", "", ""}, {"light.office", "slider", "", ""},
      {"media_player.office", "media", "play_pause", ""},
      {"media_player.office", "media", "playlist", ""},
      {"cover.office", "cover", "open", ""}, {"script.office", "action", "", ""},
      {"fan.office", "fan_oscillate", "", ""}, {"switch.office", "switch", "", "confirm"}}) {
    configs["unsupported"] = config;
    homes = {{1, 0, "", "unsupported", &one}};
    const int previous = opens, dismissed = closes;
    assert(!espcontrol_open_modal(config.entity, true));
    assert(opens == previous && closes == dismissed && commands == 0);
  }
  // Visible remote camera controls still qualify for the P4 refresh action,
  // even though their source card belongs to an inactive subpage.
  Runtime camera; lv_obj_t camera_button{&camera, false, &other_page};
  camera.btn = &camera_button;
  current_page = &home;
  modal = {};
  assert(!image_card_context_on_active_screen(&camera));
  image_card_open_modal(&camera);
  assert(image_card_context_on_active_screen(&camera));
  media_control_open_modal(&first);
  assert(!image_card_context_on_active_screen(&camera));
  navigation_hide_modals();
  current_page = &other_page;
  assert(image_card_context_on_active_screen(&camera));
  // A remote modal can sit over a non-grid page. Release must close it before
  // freeing its runtime, without relying on navigation back to the home page.
  current_page = &other_page;
  light_control_open_modal(&first);
  allocations.push_back({&one, &first, [](void *) { assert(!modal.overlay); }});
  grid_release_runtime_allocations(&one);
  assert(!modal.overlay && allocations.empty() && current_page == &other_page);
  return 0;
}
