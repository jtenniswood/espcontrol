struct lv_obj_t {};
struct lv_timer_t {};
struct lv_font_t {};
constexpr uint32_t DEFAULT_SLIDER_COLOR = 0;
constexpr uint32_t SECONDARY_GREY = 0;
constexpr uint32_t TERTIARY_GREY = 0;
constexpr size_t HA_SHORT_STATE_MAX_LEN = 64;
constexpr size_t HA_FRIENDLY_NAME_MAX_LEN = 256;

// @production-context
// @production-function climate_lower
// @production-function climate_trim
// @production-function climate_unavailable_value
// @production-function climate_clean_option_token
// @production-function climate_hvac_service_value

std::string espcontrol_i18n(const std::string &value) { return value; }
std::string climate_option_label(const std::string &value) { return value; }
// @production-function climate_action_label
// @production-function climate_is_active
// @production-function climate_card_icon_enabled

// Record the render boundary, using production presentation decisions. This
// covers refresh delivery and values, not LVGL layout or physical rendering.
struct Display {
  int refreshes = 0;
  std::string status;
  bool highlighted = false;
  bool on_icon = false;
};
Display tile, popup;
bool popup_open = true;
void climate_update_card(ClimateControlCtx *ctx) {
  ++tile.refreshes;
  tile.status = climate_action_label(ctx);
  tile.highlighted = climate_is_active(ctx);
  tile.on_icon = climate_card_icon_enabled(ctx);
}
void climate_control_set_modal_value(ClimateControlCtx *ctx) {
  ++popup.refreshes;
  if (popup_open) popup.status = climate_action_label(ctx);
}
void climate_control_hide_modal() { popup_open = false; }

using Callback = std::function<void(esphome::StringRef)>;
std::map<std::string, Callback> states;
std::map<std::pair<std::string, std::string>, Callback> attributes;
uint32_t generation = 1;
uint32_t ha_subscription_generation() { return generation; }
void ha_subscribe_state(const std::string &entity, Callback callback) {
  assert(states.emplace(entity, std::move(callback)).second);
}
void ha_subscribe_attribute(const std::string &entity, const std::string &attribute,
                            Callback callback) {
  assert(attributes.emplace(std::make_pair(entity, attribute), std::move(callback)).second);
}
std::string string_ref_limited(esphome::StringRef value, size_t limit) {
  return std::string(value.c_str(), std::min(value.size(), limit));
}
struct Request {
  std::string entity, service;
  std::vector<std::pair<const char *, std::string>> data;
};
std::vector<Request> requests;
void climate_send_action(const std::string &entity, const char *service,
                         const std::vector<std::pair<const char *, std::string>> &data) {
  requests.push_back({entity, service, data});
}

// Temperature/capability attributes share the subscription function but are
// outside these state-refresh tests. Fail if an unrelated callback is invoked.
using ClimateTargetKind = espcontrol::climate::TargetKind;
ClimateTargetKind climate_target_kind(ClimateControlCtx *) { assert(false); return ClimateTargetKind::NONE; }
bool climate_parse_supported_features(esphome::StringRef, int &) { assert(false); return false; }
bool climate_target_values_complete(ClimateControlCtx *) { assert(false); return false; }
bool climate_parse_tenths(esphome::StringRef, int &) { assert(false); return false; }
void climate_cancel_temperature_send(ClimateControlCtx *) { assert(false); }
void climate_normalize_range(ClimateControlCtx *) { assert(false); }
std::vector<std::string> climate_parse_options(esphome::StringRef) { assert(false); return {}; }
void climate_select_target_for_mode(ClimateControlCtx *, const std::string &) {}
class HaCallbackOwnerScope {
 public:
  explicit HaCallbackOwnerScope(const void *) {}
};
bool climate_subscribe_optional_fields(ClimateControlCtx *, uint8_t) { return true; }
void climate_mark_optional_subscription_needs(ClimateControlCtx *) {}

// @production-function climate_send_option
// @production-function subscribe_climate_control_state

constexpr const char *ENTITY = "climate.living_room";
void receive_mode(const char *value) { states.at(ENTITY)(esphome::StringRef(value)); }
void receive_action(const char *value) {
  attributes.at({ENTITY, "hvac_action"})(esphome::StringRef(value));
}
void expect_display(const char *status, bool highlighted, bool on_icon) {
  assert(tile.status == status);
  if (popup_open) assert(popup.status == status);
  assert(tile.highlighted == highlighted);
  assert(tile.on_icon == on_icon);
}
template<typename Event>
void expect_refresh(Event event, const char *status, bool highlighted, bool on_icon) {
  int tile_before = tile.refreshes;
  int popup_before = popup.refreshes;
  event();
  assert(tile.refreshes > tile_before);
  assert(popup.refreshes > popup_before);
  expect_display(status, highlighted, on_icon);
}

int main() {
  ClimateControlCtx ctx;
  ctx.entity_id = ENTITY;
  subscribe_climate_control_state(&ctx);
  receive_mode("heat");
  receive_action("heating");
  expect_display("Heating", true, true);

  // Selecting Off must refresh both views before HA acknowledges the service.
  expect_refresh([&] { climate_send_option(&ctx, "hvac", "Off"); }, "Off", false, false);
  assert(requests.size() == 1);
  assert(requests[0].entity == ENTITY);
  assert(requests[0].service == "climate.set_hvac_mode");
  assert(requests[0].data.size() == 1);
  assert(std::string(requests[0].data[0].first) == "hvac_mode");
  assert(requests[0].data[0].second == "off");
  assert(ctx.hvac_action == "heating");
  expect_refresh([] { receive_action("heating"); }, "Off", false, false);
  expect_refresh([] { receive_mode("off"); }, "Off", false, false);

  // HA changes the mode first and retains a working action.
  receive_mode("heat");
  expect_display("Heating", true, true);
  expect_refresh([] { receive_mode(" OFF "); }, "Off", false, false);
  expect_refresh([] { receive_action("off"); }, "Off", false, false);

  // HA changes the action first: retain the On icon until mode also becomes Off.
  receive_mode("heat");
  receive_action("heating");
  expect_refresh([] { receive_action("off"); }, "Off", false, true);
  expect_refresh([] { receive_mode("off"); }, "Off", false, false);

  // Auto keeps the retained idle action and later follows activity updates.
  receive_action("idle");
  expect_refresh([&] { climate_send_option(&ctx, "hvac", "Auto"); }, "Idle", false, true);
  expect_refresh([] { receive_action(" HEATING "); }, "Heating", true, true);
  expect_refresh([] { receive_action("idle"); }, "Idle", false, true);
  expect_refresh([] { receive_mode("auto"); }, "Idle", false, true);

  // Unavailable hides the popup; returning HA state restores the tile.
  expect_refresh([] { receive_mode("unavailable"); }, "Unavailable", false, false);
  assert(!popup_open);
  assert(popup.status == "Idle");  // Closed views are not rendered.
  expect_refresh([] { receive_action("heating"); }, "Unavailable", false, false);
  expect_refresh([] { receive_mode("auto"); }, "Heating", true, true);

  // Callbacks retained after a screen rebuild must not touch old views/context.
  ++generation;
  int tile_before = tile.refreshes;
  int popup_before = popup.refreshes;
  receive_mode("off");
  receive_action("idle");
  assert(ctx.hvac_mode == "auto" && ctx.hvac_action == "heating");
  assert(tile.refreshes == tile_before && popup.refreshes == popup_before);
  assert(requests.size() == 2);  // Received HA updates never send actions back.
}
