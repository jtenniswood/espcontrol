  auto& ui = fan_preset_ui();
  ui.active = ctx;
  ui.overlay = lv_obj_create(lv_layer_top());
  ui.panel = ui.overlay;
  ui.list = lv_obj_create(ui.panel);
  modal_service.set_active(ControlModalKind::FAN_PRESET, ui.overlay, fan_preset_close,
                           ControlModalDismissPolicy::DISMISS);
  fan_preset_rebuild_list(ctx);
}
