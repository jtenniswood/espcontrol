// Only platform shell geometry/opening is doubled. The preset rows, state
// projection, commands, input hooks and retirement are production definitions.
void fan_control_open_modal(FanCardCtx* ctx) {
  if (!fan_control_can_open_modal(ctx)) return;
  auto& ui = fan_control_modal_ui();
  ui.active = ctx;
  ui.overlay = lv_obj_create(lv_layer_top());
  ui.panel = ui.overlay;
  ui.power_on_btn = lv_button_create(ui.panel);
  lv_obj_add_event_cb(
      ui.power_on_btn, [](lv_event_t*) { fan_control_toggle_modal_power(); }, LV_EVENT_CLICKED, nullptr);
  ui.speed_slider = lv_slider_create(ui.panel);
  ui.preset_list = lv_obj_create(ui.panel);
  modal_service.set_active(ControlModalKind::FAN_CONTROL, ui.overlay, fan_control_hide_modal,
                           ControlModalDismissPolicy::DISMISS);
  fan_control_rebuild_preset_list(ctx);
  if (ui.active && !fan_modal_widgets_ready(ctx, ui.overlay)) fan_control_hide_modal();
}
