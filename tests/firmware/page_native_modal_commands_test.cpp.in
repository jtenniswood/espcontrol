using namespace espcontrol;
using namespace espcontrol::pages;
using namespace espcontrol::configuration;
static bool online = true, api = true, busy = false, locked = false, begin_ok = true, send_ok = true;
static uint32_t epoch = 1;
static std::function<void()> on_send;
struct Coordinator {
  bool dispatching() const { return busy; }
};
Coordinator& ha_read_coordinator() {
  static Coordinator c;
  return c;
}
bool ha_api_available() { return api; }
bool ha_api_state_connected() { return online; }
namespace espcontrol {
struct Pin {
  bool locked() const { return ::locked; }
};
Pin& screensaver_pin() {
  static Pin pin;
  return pin;
}
}  // namespace espcontrol
namespace esphome::api {
struct Fields : std::map<std::string, std::string> {
  size_t reserved{0};
  void init(size_t n) { reserved = n; }
};
struct HomeassistantActionRequest {
  std::string service;
  Fields data, data_template, variables;
};
}  // namespace esphome::api
using Request = esphome::api::HomeassistantActionRequest;
static std::vector<Request> requests;
static size_t begins = 0, local_calls = 0;
bool ha_action_begin(Request& r, const char* service, bool event, size_t) {
  assert(!event);
  ++begins;
  if (!begin_ok) return false;
  r.service = service;
  return true;
}
void ha_action_add_entity(Request& r, const std::string& entity) { r.data["entity_id"] = entity; }
void ha_action_add_data(Request& r, const char* k, const char* v) { r.data[k] = v; }
void ha_action_add_data_template(Request& r, const char* k, const char* v) { r.data_template[k] = v; }
void ha_action_add_variable(Request& r, const char* k, const char* v) { r.variables[k] = v; }
bool ha_action_send(Request& r) {
  const auto before = r;
  requests.push_back(r);
  if (on_send) on_send();
  assert(before.service == r.service && before.data == r.data && before.variables == r.variables);
  return send_ok;
}
bool ha_send_entity_action(const std::string& entity, const char* service) {
  if (entity.empty()) return false;
  Request request;
  if (!ha_action_begin(request, service, false, 1)) return false;
  ha_action_add_entity(request, entity);
  return ha_action_send(request);
}
void send_local_action(const std::string&) { ++local_calls; }
