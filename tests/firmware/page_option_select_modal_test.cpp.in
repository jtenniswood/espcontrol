// @production-function create_option_select_context
struct Transport {
  using State = esphome::StringRef;
  using Callback = std::function<void(State)>;
  static constexpr bool RECLAIMABLE_SUBSCRIPTIONS = true;
  struct Binding {
    uint32_t token;
    std::string entity, attribute;
    Callback callback;
  };
  std::vector<Binding> bindings;
  bool connected{true};
  uint32_t next{1};
  size_t requests{0};
  bool available() const {
    return true;
  }
  bool state_connected() const {
    return connected;
  }
  uint32_t subscribe(const std::string& entity, const std::string& attribute, Callback callback) {
    const auto token = next++;
    bindings.push_back({token, entity, attribute, std::move(callback)});
    return token;
  }
  void unsubscribe(uint32_t token) {
    bindings.erase(
        std::remove_if(bindings.begin(), bindings.end(), [token](const auto& b) { return b.token == token; }),
        bindings.end());
  }
  bool request(std::string_view, std::string_view) {
    ++requests;
    return connected;
  }
  void send(const char* entity, const char* attribute, const std::string& value) {
    for (const auto& b : bindings)
      if (b.entity == entity && b.attribute == attribute) {
        const auto callback = b.callback;
        callback(State(value.c_str(), value.size()));
        return;
      }
  }
};
struct Heap {
  bool available(const char*, size_t, size_t) const {
    return true;
  }
};
using Coordinator = HaReadCoordinator<Transport, Heap>;
Coordinator coordinator;
Coordinator& ha_read_coordinator() {
  return coordinator;
}
uint32_t& ha_subscription_generation() {
  return coordinator.generation_ref();
}
bool ha_api_state_connected() {
  return coordinator.transport().connected;
}
bool enough_heap = true;
bool ha_internal_heap_available(const char*) {
  return enough_heap;
}
void* callback_owner = nullptr;
struct HaCallbackOwnerScope {
  void* previous;
  explicit HaCallbackOwnerScope(void* owner) : previous(callback_owner) {
    callback_owner = owner;
  }
  ~HaCallbackOwnerScope() {
    callback_owner = previous;
  }
};
bool ha_subscribe_state(const std::string& entity, Transport::Callback callback) {
  return coordinator.subscribe(entity, "", std::move(callback), 32, callback_owner);
}
bool ha_subscribe_attribute(const std::string& entity, const std::string& attribute,
                            Transport::Callback callback) {
  return coordinator.subscribe(entity, attribute, std::move(callback), 32, callback_owner);
}
void ha_release_callbacks_for_owner(void* owner) {
  coordinator.release_owner(owner);
}
size_t reannouncements = 0;
void ha_reannounce_state_subscriptions() {
  ++reannouncements;
}

