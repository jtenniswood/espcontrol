}
std::string clock_label;
void set_clock_bar_modal_label(const std::string& label) {
  clock_label = label;
}

bool accept = true;
size_t sends = 0;
std::string last_entity, last_service, last_value;
std::function<void()> during_send, during_row;
bool ha_send_entity_action(const std::string& entity, const char* service, const char*, const char* value) {
  ++sends;
  last_entity = entity;
  last_service = service;
  last_value = value;
  if (during_send) during_send();
  return accept;
}
void control_modal_delete_overlay(ControlModalKind kind, lv_obj_t* overlay) {
  if (overlay) lv_obj_delete(overlay);
  modal_service.clear_active(kind);
}
