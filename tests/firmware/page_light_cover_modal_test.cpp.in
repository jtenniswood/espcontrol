size_t sends=0;std::function<void()> during_send;
void light_control_open_modal(LightControlCtx *ctx){
 if(!light_control_can_open_modal(ctx)){return;}light_ui.active=ctx;light_ui.overlay=lv_obj_create(lv_layer_top());light_ui.button=lv_button_create(light_ui.overlay);
 lv_obj_add_event_cb(light_ui.button,[](lv_event_t *){if(light_modal_action_allowed(light_ui.active)){++sends;if(during_send)during_send();}},LV_EVENT_CLICKED,nullptr);
 modal_service.set_active(ControlModalKind::LIGHT_CONTROL,light_ui.overlay,light_control_hide_modal,ControlModalDismissPolicy::DISMISS);
 light_ui.color_grid=lv_obj_create(light_ui.overlay);light_control_rebuild_color_grid(ctx);
 if(light_ui.active&&!light_modal_widgets_ready(light_ui.overlay))light_control_hide_modal();
}
void cover_control_open_modal(CoverControlCtx *ctx){
 if(!cover_control_can_open_modal(ctx)){return;}cover_ui.active=ctx;cover_ui.overlay=lv_obj_create(lv_layer_top());cover_ui.button=lv_button_create(cover_ui.overlay);
 lv_obj_add_event_cb(cover_ui.button,[](lv_event_t *){if(cover_modal_action_allowed(cover_ui.active)){++sends;if(during_send)during_send();}},LV_EVENT_CLICKED,nullptr);
 modal_service.set_active(ControlModalKind::COVER_CONTROL,cover_ui.overlay,cover_control_hide_modal,ControlModalDismissPolicy::DISMISS);
 if(!cover_modal_widgets_ready(cover_ui.overlay))cover_control_hide_modal();
}
#include "page_light_cover_modal.h"
struct Arena:PageArenaAllocator {
  std::unordered_map<void *,size_t>live;int remaining{-1};
  void *allocate(size_t size)override{if(remaining==0)return nullptr;if(remaining>0)--remaining;void *p=std::malloc(size);assert(p);live[p]=size;return p;}
  void release(void *p,size_t size)override{assert(live.at(p)==size);live.erase(p);std::free(p);}
};
struct Fixture {
 explicit Fixture(uint32_t generation=17){const auto &limits=DEVICE_UI_PROFILES[8];PanelConfigWriter writer(document.data(),document.size());assert(writer.begin()==PanelConfigStatus::OK);assert(writer.append_device_profile(reinterpret_cast<const uint8_t *>(limits.device_profile),std::strlen(limits.device_profile))==PanelConfigStatus::OK);
 const char *cards[]={"light.room;Lamp;Auto;Auto;;;light_control;0;","cover.room;Blind;Auto;Auto;modal;;cover;0;"};
 for(size_t i=0;i<2;++i)assert(writer.append_button(i+1,reinterpret_cast<const uint8_t *>(cards[i]),std::strlen(cards[i]))==PanelConfigStatus::OK);
 assert(writer.finish(&size)==PanelConfigStatus::OK);assert(PageStore::stage_v1(document.data(),size,limits,generation,storage.data(),storage.size(),&store)==PageStoreStatus::OK);}
 std::array<uint8_t,8192>document{};size_t size=0;alignas(std::max_align_t)std::array<uint8_t,32768>storage{};PageStore store;
};
void values(){auto &t=coordinator.transport();t.send("light.room","","on");t.send("light.room","brightness","75");t.send("light.room","color_temp_kelvin","3000");t.send("light.room","supported_color_modes","['rgb']");t.send("light.room","friendly_name","Lamp");t.send("cover.room","","open");t.send("cover.room","current_position","42");t.send("cover.room","current_tilt_position","20");t.send("cover.room","supported_features","255");}
// One dispatcher/runtime enforces one live panel across both families.

static PageModalToken last_style_token{};
void test_controls(){Fixture fixture,next(18);Arena arena;PageCardDependencies source;CoordinatorPageEntitySubscriptions subscriptions(coordinator,16);
 {PageEntityStateRuntime state(source,arena,subscriptions,{64,64,8192});assert(state.prepare(fixture.store));state.activate_prepared(fixture.store);values();
   bool styles = true;
   PageLightModalStyle style;
   style.owner = &styles;
   style.resolve = [](void* p, PageModalToken token, const ParsedCfg&, PageControlModalEnvironment&) {
     last_style_token = token;
     return *static_cast<bool*>(p);
   };
   PageLightModalPort light(arena, state, style, nullptr, [](void*, PageBindingToken) { return true; });
   PageCoverModalStyle cover_style;
   cover_style.owner = &styles;
   cover_style.resolve = style.resolve;
   PageCoverModalPort cover(arena, state, cover_style, nullptr, [](void*, PageBindingToken) { return true; });
   PageModalRouter<2> port(
       {{{ControlModalKind::LIGHT_CONTROL, &light}, {ControlModalKind::COVER_CONTROL, &cover}}}, nullptr,
       [](void*, PageBindingToken) { return true; });
   PageModalRuntime runtime(port);
   assert(!light.install(runtime, false));
   assert(light.install(runtime, true) && cover.install(runtime, true));
   assert(runtime.prepare(fixture.store));
   runtime.activate_prepared(fixture.store);
   const auto refs = coordinator.subscription_count(), native = coordinator.transport().bindings.size(),
              live = arena.live.size(), lv_bytes = lv_live_bytes;
   for (size_t i = 0; i < 1000; ++i) {
     for (uint16_t card = 0; card < 2; ++card) {
       assert(runtime.request_card({17, card}));
       runtime.loop();
       assert(last_style_token.configuration == 17 && last_style_token.card == card &&
              last_style_token.opening == runtime.token().opening &&
              last_style_token.kind == runtime.token().kind);
       auto* ctx = card ? static_cast<void*>(cover_ui.active) : light_ui.active;
       assert(ctx);
       if (!card) {
         const auto before_cpp = cpp_allocation_calls;
         for (int n = 0; n < 4; ++n) {
           light_ui.active->rgb_color_supported = n % 2;
           light_control_rebuild_color_grid(light_ui.active);
         }
         assert(cpp_allocation_calls == before_cpp);
         assert(lv_obj_get_child_count(light_ui.color_grid) == 16);
       }
       auto* button = card ? cover_ui.button : light_ui.button;
       const auto before = sends;
       lv_obj_send_event(button, LV_EVENT_CLICKED, nullptr);
       assert(sends == before);
       lv_obj_send_event(button, LV_EVENT_PRESSED, nullptr);
       lv_obj_send_event(button, LV_EVENT_RELEASED, nullptr);
       lv_obj_send_event(button, LV_EVENT_CLICKED, nullptr);
       assert(sends == before + 1);
       if (card) {
         assert(cover_ui.active->current_position == 42);
         cover_ui.active->current_position = 90;
       } else {
         assert(light_ui.active->current_kelvin == 3000);
         light_ui.active->current_kelvin = 4000;
       }
       runtime.loop();
       if (card)
         assert(cover_ui.active->current_position == 90);
       else
         assert(light_ui.active->current_kelvin == 4000);
       if (card)cover_control_hide_modal();else light_control_hide_modal();assert(runtime.memory().retired_contexts==1);runtime.loop();coordinator.reclaim_unused_channels();assert(arena.live.size()==live&&lv_live_bytes==lv_bytes&&coordinator.subscription_count()==refs&&coordinator.transport().bindings.size()==native);
     }
   }
   for (uint16_t card = 0; card < 2; ++card) {
     assert(runtime.request_card({17, card}));
     runtime.loop();
     assert_panel_draw_retirement(runtime, card ? cover_ui.overlay : light_ui.overlay);
   }
 for(uint16_t card=0;card<2;++card){assert(runtime.request_card({17,card}));runtime.loop();auto *button=card?cover_ui.button:light_ui.button;during_send=[&](){if(card)cover_control_hide_modal();else light_control_hide_modal();runtime.loop();assert(runtime.memory().retired_contexts==1);};lv_obj_send_event(button,LV_EVENT_PRESSED,nullptr);lv_obj_send_event(button,LV_EVENT_RELEASED,nullptr);lv_obj_send_event(button,LV_EVENT_CLICKED,nullptr);during_send={};runtime.loop();
 arena.remaining=0;assert(runtime.request_card({17,card}));runtime.loop();arena.remaining=-1;assert(!light_ui.active&&!cover_ui.active);arena.remaining=1;assert(runtime.request_card({17,card}));runtime.loop();arena.remaining=-1;assert(!light_ui.active&&!cover_ui.active);
 styles=false;assert(runtime.request_card({17,card}));runtime.loop();styles=true;assert(!light_ui.active&&!cover_ui.active);enough_heap=false;assert(runtime.request_card({17,card}));runtime.loop();enough_heap=true;assert(!light_ui.active&&!cover_ui.active);
 assert(runtime.request_card({17,card}));runtime.loop();coordinator.transport().send(card?"cover.room":"light.room","","unavailable");runtime.loop();assert(!light_ui.active&&!cover_ui.active);values();
 assert(runtime.request_card({17,card}));runtime.loop();const auto before=sends;coordinator.transport().connected=false;coordinator.invalidate_retained_state();assert(!light_modal_action_allowed(light_ui.active)&&!cover_modal_action_allowed(cover_ui.active));runtime.loop();assert(!light_ui.active&&!cover_ui.active&&sends==before);coordinator.transport().connected=true;values();}
 assert(runtime.request_card({17,0}));runtime.loop();auto *ctx=light_ui.active;int owner=0;assert(coordinator.subscribe("sensor.replace","",[&](esphome::StringRef){assert(runtime.prepare(next.store));runtime.activate_prepared(next.store);assert(light_ui.active==ctx&&lv_obj_has_flag(light_ui.overlay,LV_OBJ_FLAG_HIDDEN));std::memset(fixture.storage.data(),0xA5,fixture.storage.size());runtime.loop();assert(ctx->entity_id=="light.room"&&runtime.memory().retired_contexts==1);},64,&owner,false,false));coordinator.transport().send("sensor.replace","","go");coordinator.release_owner(&owner);runtime.loop();assert(!light_ui.active);assert(runtime.request_card({18,0}));runtime.loop();assert(!light_ui.active);assert(state.prepare(next.store));state.activate_prepared(next.store);values();assert(runtime.request_card({18,1}));runtime.loop();assert(cover_ui.active);runtime.retire_active();runtime.loop();state.retire_active();}
 coordinator.reclaim_unused_channels();assert(arena.live.empty()&&coordinator.transport().bindings.empty());
}
void test_gesture_budget(){Fixture fixture;Arena arena;PageCardDependencies source;CoordinatorPageEntitySubscriptions subscriptions(coordinator,16);
 {PageEntityStateRuntime state(source,arena,subscriptions,{64,64,8192});assert(state.prepare(fixture.store));state.activate_prepared(fixture.store);values();const auto baseline=arena.live.size(),refs=coordinator.subscription_count(),lv_bytes=lv_live_bytes;
   PageLightModalStyle style;
   style.gesture_capacity = 1;
   style.resolve = [](void*, PageModalToken, const ParsedCfg&, PageControlModalEnvironment&) { return true; };
   PageLightModalPort port(arena, state, style, nullptr, [](void*, PageBindingToken) { return true; });
   auto router = modal_test_router<ControlModalKind::LIGHT_CONTROL>(port);
   PageModalRuntime runtime(router);
   assert(port.install(runtime, true));
   assert(runtime.prepare(fixture.store));
   runtime.activate_prepared(fixture.store);
   assert(runtime.request_card({17, 0}));
   runtime.loop();
   assert(!light_ui.active && runtime.memory().failures == 1 && arena.live.size() == baseline &&
          lv_live_bytes == lv_bytes && coordinator.subscription_count() == refs);
   state.retire_active();
 }
 coordinator.reclaim_unused_channels();assert(arena.live.empty()&&coordinator.transport().bindings.empty());
}
int main(){lv_init();auto *display=lv_display_create(480,480);assert(display);lv_timer_pause(lv_display_get_refr_timer(display));test_controls();test_gesture_budget();lv_display_delete(display);lv_deinit();assert(lv_live_bytes==0);}
