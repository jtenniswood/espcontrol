bool slider_parse_pct(esphome::StringRef value,int &out){auto text=string_ref_limited(value,32);char *end;float x=std::strtof(text.c_str(),&end);if(end==text.c_str()||!std::isfinite(x))return false;out=std::max(0,std::min(100,int(x)));return true;}
bool slider_parse_light_brightness_pct(esphome::StringRef value,int &out){if(!slider_parse_pct(value,out))return false;return true;}
