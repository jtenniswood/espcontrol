struct Transport {
  using State=esphome::StringRef;using Callback=std::function<void(State)>;
  static constexpr bool RECLAIMABLE_SUBSCRIPTIONS=true;
  struct Binding{uint32_t token;std::string entity,attribute;Callback callback;};std::vector<Binding>bindings;
  bool connected{true};uint32_t next{1};size_t requests{0};
  bool available()const{return true;}bool state_connected()const{return connected;}
  uint32_t subscribe(const std::string &entity,const std::string &attribute,Callback callback){const auto token=next++;bindings.push_back({token,entity,attribute,std::move(callback)});return token;}
  void unsubscribe(uint32_t token){bindings.erase(std::remove_if(bindings.begin(),bindings.end(),[token](const auto &b){return b.token==token;}),bindings.end());}
  bool request(std::string_view,std::string_view){++requests;return connected;}
  void send(const char *entity,const char *attribute,const std::string &value){for(const auto &b:bindings)if(b.entity==entity&&b.attribute==attribute){const auto callback=b.callback;callback(State(value.c_str(),value.size()));return;}}
};
struct Heap{bool available(const char *,size_t,size_t)const{return true;}};
using Coordinator=HaReadCoordinator<Transport,Heap>;
