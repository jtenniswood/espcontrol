bool ha_internal_heap_available(const char *){return enough_heap;}
void *callback_owner=nullptr;
struct HaCallbackOwnerScope{void *previous;explicit HaCallbackOwnerScope(void *owner):previous(callback_owner){callback_owner=owner;}~HaCallbackOwnerScope(){callback_owner=previous;}};
bool ha_subscribe_state(const std::string &entity,Transport::Callback callback){return coordinator.subscribe(entity,"",std::move(callback),32,callback_owner);}
bool ha_subscribe_attribute(const std::string &entity,const std::string &attribute,Transport::Callback callback){return coordinator.subscribe(entity,attribute,std::move(callback),32,callback_owner);}
void ha_release_callbacks_for_owner(void *owner){coordinator.release_owner(owner);}
