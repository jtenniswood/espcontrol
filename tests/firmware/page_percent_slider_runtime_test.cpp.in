#include "button_grid_config_parser.h"
#include "page_card_dependencies.h"
#include "panel_config_document.h"
static size_t cpp_allocations = 0;
void* operator new(size_t bytes) {
  ++cpp_allocations;
  if (void* pointer = std::malloc(bytes ? bytes : 1)) return pointer;
  std::abort();
}
void* operator new[](size_t bytes) {
  return ::operator new(bytes);
}
void operator delete(void* pointer) noexcept {
  std::free(pointer);
}
void operator delete[](void* pointer) noexcept {
  std::free(pointer);
}
void operator delete(void* pointer, std::size_t) noexcept {
  std::free(pointer);
}
void operator delete[](void* pointer, std::size_t) noexcept {
  std::free(pointer);
}
using namespace espcontrol;
using namespace espcontrol::pages;
using namespace espcontrol::configuration;
namespace {
struct Arena : PageArenaAllocator {
  std::unordered_map<void*, size_t> live;
  size_t calls{0};
  bool fail{false};
  void* allocate(size_t bytes) override {
    ++calls;
    if (fail) return nullptr;
    auto* pointer = std::malloc(bytes);
    assert(pointer);
    live[pointer] = bytes;
    return pointer;
  }
  void release(void* pointer, size_t bytes) override {
    assert(live.at(pointer) == bytes);
    live.erase(pointer);
    std::free(pointer);
  }
};
struct Subscriptions : PageEntitySubscriptions {
  bool subscribe(const char*, const char*, void*, uint32_t, uint32_t, Deliver) override {
    std::abort();
  }
  void release(void*) override {
    std::abort();
  }
  uint32_t connection_generation() const override {
    return connection;
  }
  uint32_t connection{1};
};
struct Fixture {
  Fixture(uint32_t generation, const std::string& entity = "fan.room", const std::string& type = "fan_speed",
          const std::string& mode = "", bool empty = false,
          const DeviceUiLimits& limits = DEVICE_UI_PROFILES[8]) {
    PanelConfigWriter writer(document.data(), document.size());
    assert(writer.begin() == PanelConfigStatus::OK);
    assert(writer.append_device_profile(reinterpret_cast<const uint8_t*>(limits.device_profile),
                                        std::strlen(limits.device_profile)) == PanelConfigStatus::OK);
    const std::string card =
        empty ? ";;;;sensor.temp;;sensor;1;" : entity + ";;Auto;Auto;" + mode + ";;" + type + ";;";
    for (size_t i = 0; i < 2; ++i)
      assert(writer.append_button(i + 1, reinterpret_cast<const uint8_t*>(card.data()), card.size()) ==
             PanelConfigStatus::OK);
    assert(writer.finish(&size) == PanelConfigStatus::OK);
    assert(PageStore::stage_v1(document.data(), size, limits, generation, storage.data(), storage.size(),
                               &store) == PageStoreStatus::OK);
  }
  std::array<uint8_t, 8192> document{};
  size_t size{0};
  alignas(std::max_align_t) std::array<uint8_t, 32768> storage{};
  PageStore store;
};
// @legacy-percent-slider-reference
void parity() {
  for (const auto kind : {PagePercentSliderKind::LIGHT, PagePercentSliderKind::FAN,
                          PagePercentSliderKind::COVER_POSITION, PagePercentSliderKind::COVER_TILT}) {
    const bool light = kind == PagePercentSliderKind::LIGHT, fan = kind == PagePercentSliderKind::FAN;
    const std::string entity = light ? "light.room" : fan ? "fan.room" : "cover.room";
    Fixture fixture(17, entity,
                    light ? "light_brightness"
                    : fan ? "fan_speed"
                          : "cover",
                    kind == PagePercentSliderKind::COVER_TILT ? "tilt" : "");
    Arena arena;
    Subscriptions subs;
    PagePercentSliderRuntime runtime(arena, subs);
    assert(runtime.prepare(fixture.store));
    runtime.activate_prepared(fixture.store);
    assert(runtime.memory().sources == 1 && runtime.memory().cards == 2);
    legacy_bindings.clear();
    lv_obj_t button, icon, slider, fill;
    SliderCtx context;
    context.fill = &fill;
    context.entity_id = entity;
    slider.data = &context;
    subscribe_slider_state(&button, &icon, &slider, true, "OFF", "ON", entity,
                           kind == PagePercentSliderKind::COVER_TILT);
    assert(legacy_bindings.size() == 2 && !legacy_bindings[0].attribute.empty() &&
           legacy_bindings[1].attribute.empty());
    constexpr const char* states[] = {"off", "on", "unknown", "unavailable", "", " OPEN ", "bad", "true"};
    constexpr const char* levels[] = {"0",  "1",   "0.0001", "50.5", "100",    "255",  "300",
                                      "-5", "NaN", "inf",    "bad",  "40tail", " 65 ", "unknown"};
    uint32_t random = 1825;
    for (size_t n = 0; n < 10000; ++n) {
      random = random * 1664525u + 1013904223u;
      const bool primary = (random & 1) != 0;
      const std::string value = primary ? states[(random >> 8) % 8] : levels[(random >> 8) % 14];
      const auto& binding = legacy_bindings[primary ? 1 : 0];
      binding.callback(esphome::StringRef(value));
      runtime.observed(17, entity, binding.attribute, value, false);
      const auto view = runtime.read({17, 0});
      assert(view.kind == kind && view.percent == slider.value && view.available == context.available);
      assert(view.icon_on == (std::strcmp(icon.icon, "ON") == 0));
      assert(runtime.read({17, 1}).percent == slider.value);
      // Drag previews are independent per card and survive navigation-sized reads.
      if (n % 17 == 0 && context.available) {
        const uint8_t preview = static_cast<uint8_t>((random >> 16) % 101);
        assert(runtime.preview({17, 0}, preview));
        slider.value = preview;
        assert(runtime.read({17, 0}).percent == preview && runtime.read({17, 0}).preview);
        assert(!runtime.read({17, 1}).preview);
        // The next identical valid report must still acknowledge the preview.
        legacy_bindings[0].callback(esphome::StringRef("50"));
        runtime.observed(17, entity, PagePercentSliderRuntime::attribute(kind), "50", false);
        assert(!runtime.read({17, 0}).preview && runtime.read({17, 0}).percent == slider.value);
      }
    }
    const auto calls = arena.calls, allocations = cpp_allocations;
    for (int n = 0; n < 1000; ++n) {
      runtime.observed(17, entity, PagePercentSliderRuntime::attribute(kind), "50", false);
      runtime.loop();
      (void)runtime.read({17, 0});
    }
    assert(calls == arena.calls && allocations == cpp_allocations);
    assert(!runtime.preview({18, 0}, 50) && !runtime.preview({17, 99}, 50) && !runtime.preview({17, 0}, 101));
  }
  legacy_bindings.clear();
}
void copied_snapshots() {
  Fixture fixture(17, "cover.room", "cover");
  for (bool primary_first : {true, false})
    for (bool state_on : {true, false}) {
      Arena arena;
      Subscriptions subs;
      PagePercentSliderRuntime runtime(arena, subs);
      assert(runtime.prepare(fixture.store));
      auto primary = [&]() { runtime.observed(17, "cover.room", "", state_on ? "open" : "closed", true); };
      auto level = [&]() { runtime.observed(17, "cover.room", "current_position", "40", true); };
      if (primary_first) {
        primary();
        level();
      } else {
        level();
        primary();
      }
      runtime.activate_prepared(fixture.store);
      const auto snapshot = runtime.read({17, 0});
      assert(snapshot.percent == (state_on ? 40 : 0) && snapshot.icon_on == state_on);
    }
  // A live fill write wins over a later copied field; a live On report itself
  // does not overwrite the fill resulting from the initial attribute/Off seed.
  for (bool clear : {true, false}) {
    Arena arena;
    Subscriptions subs;
    PagePercentSliderRuntime runtime(arena, subs);
    assert(runtime.prepare(fixture.store));
    runtime.observed(17, "cover.room", "", "closed", true);
    runtime.observed(17, "cover.room", clear ? "" : "current_position", clear ? "closed" : "60", false);
    runtime.observed(17, "cover.room", "current_position", "40", true);
    runtime.activate_prepared(fixture.store);
    assert(runtime.read({17, 0}).percent == (clear ? 0 : 60));
  }
  {
    Arena arena;
    Subscriptions subs;
    PagePercentSliderRuntime runtime(arena, subs);
    assert(runtime.prepare(fixture.store));
    runtime.observed(17, "cover.room", "", "closed", true);
    runtime.observed(17, "cover.room", "", "open", false);
    runtime.observed(17, "cover.room", "current_position", "40", true);
    runtime.activate_prepared(fixture.store);
    assert(runtime.read({17, 0}).percent == 0 && runtime.read({17, 0}).icon_on);
  }
}
void graph_snapshots() {
  struct GraphSubscriptions : PageEntitySubscriptions {
    struct Binding {
      const char* entity;
      const char* attribute;
      void* owner;
      uint32_t revision, channel;
      Deliver deliver;
    };
    std::vector<Binding> bindings;
    bool subscribe(const char* entity, const char* attribute, void* owner, uint32_t revision,
                   uint32_t channel, Deliver deliver) override {
      bindings.push_back({entity, attribute, owner, revision, channel, deliver});
      return true;
    }
    void release(void* owner) override {
      bindings.erase(std::remove_if(bindings.begin(), bindings.end(),
                                    [&](const auto& binding) { return binding.owner == owner; }),
                     bindings.end());
    }
    uint32_t connection_generation() const override {
      return 1;
    }
    void send(const char* attribute, std::string_view value) {
      for (const auto& binding : bindings)
        if (std::strcmp(attribute, binding.attribute) == 0)
          binding.deliver(binding.owner, binding.revision, binding.channel, value);
    }
  } subscriptions;
  Fixture first(17), second(18);
  Arena arena;
  PageCardDependencies dependencies;
  PagePercentSliderRuntime runtime(arena, subscriptions);
  PageEntityStateRuntime state(dependencies, arena, subscriptions, {64, 64, 2048}, &runtime);
  assert(runtime.prepare(first.store) && state.prepare(first.store));
  runtime.activate_prepared(first.store);
  state.activate_prepared(first.store);
  subscriptions.send("", "off");
  subscriptions.send("percentage", "60");
  assert(runtime.read({17, 0}).percent == 60);
  assert(runtime.preview({17, 0}, 30));
  assert(runtime.prepare(second.store) && state.prepare(second.store));
  assert(runtime.read({17, 0}).percent == 30 && runtime.read({17, 0}).preview);
  subscriptions.send("", "on");
  runtime.activate_prepared(second.store);
  state.activate_prepared(second.store);
  // A new configuration replays attribute then primary, regardless of the
  // graph's globally deduplicated channel ordering. Preview state is retired.
  assert(runtime.read({18, 0}).percent == 0 && !runtime.read({18, 0}).preview);
  subscriptions.send("percentage", "60");
  assert(runtime.read({18, 0}).percent == 60);
  assert(runtime.preview({18, 0}, 25));
  subscriptions.send("percentage", "60");
  assert(runtime.read({18, 0}).percent == 60 && !runtime.read({18, 0}).preview);
}
void profiles() {
  for (const auto& limits : DEVICE_UI_PROFILES) {
    Fixture fixture(17, "cover.room", "cover", "tilt", false, limits);
    Arena arena;
    Subscriptions subscriptions;
    PagePercentSliderRuntime runtime(arena, subscriptions);
    assert(runtime.prepare(fixture.store));
    runtime.activate_prepared(fixture.store);
    runtime.observed(17, "cover.room", "current_tilt_position", "75", false);
    assert(runtime.read({17, 0}).kind == PagePercentSliderKind::COVER_TILT);
    assert(runtime.read({17, 0}).percent == 75 && runtime.read({17, 1}).icon_on);
    assert(runtime.memory().sources == 1 && runtime.memory().cards == 2);
  }
}
void lifetime() {
  Arena arena;
  Subscriptions subs;
  Fixture first(17), second(18, "light.other", "light_brightness"), empty(19, "", "", "", true);
  {
    PagePercentSliderRuntime runtime(arena, subs);
    assert(runtime.prepare(first.store));
    runtime.activate_prepared(first.store);
    runtime.observed(17, "fan.room", "percentage", "70", false);
    assert(runtime.preview({17, 0}, 40) && runtime.read({17, 1}).percent == 70);
    runtime.observed(17, "fan.room", "percentage", "NaN", false);
    runtime.observed(17, "fan.room", "", "on", false);
    assert(runtime.read({17, 0}).preview && runtime.read({17, 0}).percent == 40);
    assert(runtime.prepare(second.store));
    runtime.discard_prepared();
    assert(runtime.read({17, 0}).preview && arena.live.size() == 1);
    arena.fail = true;
    assert(!runtime.prepare(second.store));
    arena.fail = false;
    assert(runtime.read({17, 0}).preview && arena.live.size() == 1);
    assert(runtime.prepare(second.store));
    runtime.activate_prepared(second.store);
    runtime.observed(17, "fan.room", "percentage", "50", false);
    assert(runtime.read({18, 0}).percent == 0 && !runtime.read({17, 0}).available);
    runtime.observed(18, "light.other", "brightness", "0.001", false);
    assert(runtime.read({18, 0}).percent == 1);
    assert(runtime.preview({18, 0}, 80));
    ++subs.connection;
    runtime.loop();
    assert(!runtime.read({18, 0}).available && !runtime.read({18, 0}).preview &&
           !runtime.preview({18, 0}, 80));
    for (int n = 0; n < 1000; ++n) {
      const auto& store = n % 2 ? first.store : second.store;
      assert(runtime.prepare(store));
      runtime.activate_prepared(store);
      assert(runtime.memory().sources == 1 && runtime.memory().cards == 2 && arena.live.size() == 1);
    }
    assert(runtime.prepare(empty.store));
    runtime.activate_prepared(empty.store);
    assert(arena.live.empty() && runtime.memory().sources == 0);
  }
  assert(arena.live.empty());
  for (int limit = 0; limit < 3; ++limit) {
    PagePercentSliderRuntime runtime(arena, subs, limit == 0 ? 0 : 32, limit == 1 ? 0 : 512,
                                     limit == 2 ? 0 : 2048);
    assert(!runtime.prepare(first.store) && arena.live.empty());
  }
  for (const auto& card : {std::pair<const char*, const char*>{"number.room", "slider"},
                           {"fan.room", "fan_control"},
                           {"cover.room", "cover"}}) {
    Fixture ignored(17, card.first, card.second, card.second == std::string("cover") ? "modal" : "");
    assert(PagePercentSliderRuntime::classify(ignored.store, 0) == PagePercentSliderKind::NONE);
  }
}
}  // namespace
int main() {
  parity();
  copied_snapshots();
  graph_snapshots();
  profiles();
  lifetime();
}
